<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ONEXUS-Agents -> SMADP nightly research bridge.

  Install:
    cp scripts/launchd/com.smadp.agents-sync.plist ~/Library/LaunchAgents/
    # edit the paths below if SMADP does not live at ~/code/SMADP
    launchctl load ~/Library/LaunchAgents/com.smadp.agents-sync.plist

  Runs once a day at 09:00 local. Kill switch:
    touch ~/code/SMADP/state/AGENTS_SYNC_DISABLED      # pause
    rm    ~/code/SMADP/state/AGENTS_SYNC_DISABLED      # resume
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.smadp.agents-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/connorevans/code/SMADP/scripts/agents-nightly-sync.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <false/>
  <key>StandardOutPath</key>
  <string>/Users/connorevans/code/SMADP/state/agents-sync.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/connorevans/code/SMADP/state/agents-sync.stderr.log</string>
</dict>
</plist>
