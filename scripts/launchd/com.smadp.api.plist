<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SMADP API service (loopback only). Reference copy of the installed
  ~/Library/LaunchAgents/com.smadp.api.plist.

  This version runs the API through scripts/smadp-api-serve.sh, which loads
  the operator bearer token from ~/.smadp/api-token and exports SMADP_API_TOKEN
  before starting the server. With a token configured, write endpoints require
  Authorization: Bearer <token>; without one they return 503 (fail-safe).

  To adopt on this machine (restarts the running API):
    cp scripts/launchd/com.smadp.api.plist ~/Library/LaunchAgents/
    launchctl unload ~/Library/LaunchAgents/com.smadp.api.plist
    launchctl load   ~/Library/LaunchAgents/com.smadp.api.plist
  Adjust the hardcoded /Users/connorevans/code/SMADP paths if SMADP moves.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.smadp.api</string>

    <key>WorkingDirectory</key>
    <string>/Users/connorevans/code/SMADP</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/connorevans/code/SMADP/scripts/smadp-api-serve.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/connorevans/code/SMADP/.venv/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/connorevans/code/SMADP/state/api.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/connorevans/code/SMADP/state/api.stderr.log</string>
</dict>
</plist>
