---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Page accent. Used by hero gradients on certain pages. */
  variant?: 'default' | 'wide';
}

const {
  title = 'SMADP — Safe Multi-Agent Deployment Platform',
  description = 'Auditable, evidence-cited verdicts on whether autonomous agents can safely run together.',
  variant = 'default',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0B0712" />
  </head>
  <body class="text-ink-100 antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-brand-600 focus:px-3 focus:py-2 focus:text-white"
    >
      Skip to main content
    </a>

    <Nav />

    <main id="main" class={variant === 'wide' ? 'pb-24' : 'pb-24 pt-8'}>
      <slot />
    </main>

    <Footer />

    <script is:inline>
      // Defeat the bfcache when the user navigates back to a page that may
      // have been redeployed. Without this, Safari/Chrome restore the
      // pre-deploy DOM and the user sees stale content until a hard reload.
      window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
          window.location.reload();
        }
      });

      // Defensive: when GitHub Pages swaps in a new deploy, the user's
      // cached HTML may reference a CSS bundle hash that no longer exists.
      // Detect that (the .sr-only utility would have set position:absolute;
      // width:1px) and trigger one hard reload to fetch the current HTML +
      // its matching CSS. Session-storage flag prevents an infinite loop.
      (function () {
        try {
          if (sessionStorage.getItem('smadp_css_ok') === '1') return;
          var probe = document.createElement('div');
          probe.className = 'sr-only';
          probe.setAttribute('aria-hidden', 'true');
          document.body.appendChild(probe);
          var w = window.getComputedStyle(probe).width;
          var pos = window.getComputedStyle(probe).position;
          document.body.removeChild(probe);
          if (w === '1px' && pos === 'absolute') {
            sessionStorage.setItem('smadp_css_ok', '1');
            return;
          }
          if (sessionStorage.getItem('smadp_css_reload') === '1') return;
          sessionStorage.setItem('smadp_css_reload', '1');
          window.location.reload();
        } catch (e) { /* sessionStorage blocked, skip */ }
      })();
    </script>
  </body>
</html>
