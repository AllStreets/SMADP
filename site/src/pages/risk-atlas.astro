---
import Layout from '../layouts/Layout.astro';
import RiskAtlas from '../components/RiskAtlas.astro';
import AgentGraph3D from '../components/AgentGraph3D.astro';
---

<Layout title="Risk Atlas — SMADP" variant="wide">
  <section class="container-page mt-10">
    <span class="heading-eyebrow">Centerpiece</span>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <h1 class="h1 text-white">Risk Atlas</h1>
    </div>
    <p class="lead mt-4 max-w-3xl">
      A live view of every published verdict, broken down by risk axis,
      pair, and agent. Lower composite scores are safer; click into any row
      for the full evidence-cited report.
    </p>
  </section>

  <section class="container-page mt-12">
    <div class="flex items-end justify-between gap-4">
      <div>
        <span class="heading-eyebrow">Interactive · WebGL</span>
        <h2 class="h2 mt-2 text-white">The agent web</h2>
      </div>
      <p class="hidden sm:block max-w-md text-right text-xs text-ink-400">
        Drag to rotate. Scroll to zoom. Hover any node or edge for context.
        Click a node to jump to that agent's profile.
      </p>
    </div>
    <p class="mt-3 max-w-3xl text-sm text-ink-300 sm:hidden">
      Drag to rotate. Scroll to zoom. Hover any node or edge for context.
      Click a node to jump to that agent's profile.
    </p>

    <div class="mt-6">
      <AgentGraph3D />
    </div>
  </section>

  <section class="container-page mt-12">
    <RiskAtlas />
  </section>
</Layout>

<script is:inline define:vars={{ base: import.meta.env.BASE_URL.replace(/\/$/, '') }}>
  // Expose the site's base path so client-side scripts can build correct
  // URLs under the GitHub Pages /SMADP/ prefix without hard-coding it.
  window.__SMADP_BASE__ = base;
</script>
