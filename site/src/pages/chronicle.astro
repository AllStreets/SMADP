---
import Layout from '../layouts/Layout.astro';
import { getChronicle } from '../data/catalog';

const events = getChronicle();

const kindColor: Record<string, string> = {
  'profile.created': '#A78BFA',
  'profile.updated': '#A78BFA',
  'profile.verified': '#22C55E',
  'verdict.generated': '#7C3AED',
  'verdict.updated': '#7C3AED',
  'verdict.regenerated': '#7C3AED',
  'sandbox.run.started': '#22D3EE',
  'sandbox.run.completed': '#22C55E',
  'sandbox.run.failed': '#EF4444',
  'submission.received': '#F59E0B',
  'submission.promoted': '#22C55E',
  'lint.failed': '#EF4444',
};
---

<Layout title="Chronicle — SMADP">
  <section class="container-page mt-10">
    <span class="heading-eyebrow">Audit log</span>
    <h1 class="h1 mt-3 text-white">Chronicle</h1>
    <p class="lead mt-4 max-w-3xl">
      The catalog is a git repository — and the chronicle is its append-only
      audit log. Every profile creation, verdict update, sandbox run, and
      submission lands here.
    </p>
  </section>

  <section class="container-page mt-10">
    {events.length === 0 ? (
      <div class="card text-center text-ink-300">
        <p>No chronicle entries yet.</p>
        <p class="mt-2 text-sm text-ink-500">
          Events accumulate in <code class="font-mono text-brand-300">catalog/_chronicle/YYYY-MM-DD.jsonl</code>.
        </p>
      </div>
    ) : (
      <div class="overflow-hidden rounded-xl border border-white/10 bg-ink-900/40">
        <table class="w-full text-sm">
          <thead class="text-left font-mono text-[11px] uppercase tracking-wider text-ink-400">
            <tr class="border-b border-white/10 bg-ink-850/40">
              <th class="px-4 py-3">When</th>
              <th class="px-4 py-3">Kind</th>
              <th class="px-4 py-3">Actor</th>
              <th class="px-4 py-3">Ref</th>
              <th class="px-4 py-3">Message</th>
            </tr>
          </thead>
          <tbody>
            {events.slice(0, 200).map((e) => {
              const c = kindColor[e.kind] ?? '#A78BFA';
              return (
                <tr class="border-t border-white/5">
                  <td class="px-4 py-3 font-mono text-xs text-ink-300 whitespace-nowrap">
                    {e.ts.slice(0, 19).replace('T', ' ')}
                  </td>
                  <td class="px-4 py-3">
                    <span
                      class="inline-flex items-center gap-1.5 rounded px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider"
                      style={`color:${c}; background:${c}14; border:1px solid ${c}55;`}
                    >
                      <span class="h-1 w-1 rounded-full" style={`background:${c};`}></span>
                      {e.kind}
                    </span>
                  </td>
                  <td class="px-4 py-3 font-mono text-xs text-ink-300">{e.actor ?? '—'}</td>
                  <td class="px-4 py-3 font-mono text-xs text-brand-300">{e.ref ?? '—'}</td>
                  <td class="px-4 py-3 text-xs text-ink-200">{e.message ?? ''}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    )}
  </section>
</Layout>
