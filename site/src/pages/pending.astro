---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const PENDING_DIR = path.join(__dirname, '..', '..', '..', 'catalog', 'pending');

interface PendingRow {
  key: string;
  pair: string[];
  evidence_level: string;
  confidence: number;
  composite_score: number;
  headline: string;
  generated_at: string;
}

let rows: PendingRow[] = [];
try {
  const files = fs.readdirSync(PENDING_DIR).filter((f) => f.endsWith('.json'));
  for (const f of files) {
    try {
      const raw = fs.readFileSync(path.join(PENDING_DIR, f), 'utf-8');
      const d = JSON.parse(raw);
      const pair: string[] = Array.isArray(d.pair) ? d.pair : Array.isArray(d.participants) ? d.participants : [];
      rows.push({
        key: f.replace(/\.json$/, ''),
        pair,
        evidence_level: String(d.evidence_level ?? 'unknown'),
        confidence: Number(d.confidence ?? 0),
        composite_score: Number(d.composite_score ?? 0),
        headline: String(d.headline ?? ''),
        generated_at: String(d.generated_at ?? ''),
      });
    } catch {
      /* skip malformed */
    }
  }
} catch {
  rows = [];
}
// Server-side default ordering: newest first. The client lets the user
// re-sort with one click and reverse with a second click.
rows.sort((a, b) => (a.generated_at < b.generated_at ? 1 : -1));

const PAGE_SIZE = 100;

const tierColor = (t: string): string => {
  switch (t) {
    case 'sandbox-validated':
      return '#22C55E';
    case 'profile-verified':
      return '#7C3AED';
    case 'docs-only':
      return '#A78BFA';
    default:
      return '#71717A';
  }
};
const scoreColor = (s: number): string =>
  s < 0.3 ? '#22C55E' : s < 0.6 ? '#F59E0B' : '#EF4444';
---

<Layout title="Pending review — SMADP">
  <section class="container-page mt-10">
    <span class="heading-eyebrow text-amber-300">Operator queue · awaiting approval</span>
    <h1 class="h1 mt-3 text-white">Pending verdicts</h1>
    <p class="lead mt-4 max-w-3xl">
      Autopilot writes new verdicts here before they reach the public catalog.
      Approve from the CLI:
      <code class="font-mono text-brand-300">smadp pending approve &lt;key&gt;</code>
      or bulk-approve by filter:
      <code class="font-mono text-brand-300">smadp pending approve --tier docs-only --min-confidence 0.85 --limit 500 --yes</code>.
    </p>
  </section>

  <section class="container-page mt-8">
    <div
      class="rounded-lg border border-amber-500/30 bg-amber-950/20 px-4 py-3 text-sm text-amber-200"
    >
      <strong>Not yet posted:</strong> these verdicts are visible only on this
      page and via <code class="font-mono">smadp pending list</code>. They are
      not indexed on the homepage, the verdicts index, or any agent page.
    </div>

    <div class="mt-6 overflow-hidden rounded-xl border border-white/10 bg-ink-900/40">
      {rows.length === 0 ? (
        <div class="px-6 py-10 text-center text-sm text-ink-400">
          No verdicts pending review.
        </div>
      ) : (
        <table class="w-full text-sm" data-pending-table>
          <thead class="text-left font-mono text-[11px] uppercase tracking-wider text-ink-400">
            <tr class="border-b border-white/10 bg-ink-850/40">
              <th class="px-4 py-3"><button type="button" class="sort-btn" data-sort-key="when">When<span class="sort-arrow"></span></button></th>
              <th class="px-4 py-3"><button type="button" class="sort-btn" data-sort-key="pair">Pair<span class="sort-arrow"></span></button></th>
              <th class="px-4 py-3"><button type="button" class="sort-btn" data-sort-key="tier">Tier<span class="sort-arrow"></span></button></th>
              <th class="px-4 py-3 text-right"><button type="button" class="sort-btn sort-btn-right" data-sort-key="confidence">Confidence<span class="sort-arrow"></span></button></th>
              <th class="px-4 py-3 text-right"><button type="button" class="sort-btn sort-btn-right" data-sort-key="composite">Composite<span class="sort-arrow"></span></button></th>
              <th class="px-4 py-3"><button type="button" class="sort-btn" data-sort-key="headline">Headline<span class="sort-arrow"></span></button></th>
            </tr>
          </thead>
          <tbody data-pending-tbody>
            {rows.map((r, i) => {
              const tc = tierColor(r.evidence_level);
              const sc = scoreColor(r.composite_score);
              const href = `/pending/${r.key}`;
              return (
                <tr
                  class:list={['border-t border-white/5 cursor-pointer transition hover:bg-white/[0.04]', i >= PAGE_SIZE ? 'is-hidden' : '']}
                  data-sort-when={r.generated_at}
                  data-sort-pair={r.pair.join(' × ').toLowerCase()}
                  data-sort-tier={r.evidence_level}
                  data-sort-confidence={r.confidence}
                  data-sort-composite={r.composite_score}
                  data-sort-headline={r.headline.toLowerCase()}
                >
                  <td class="px-4 py-3 font-mono text-xs text-ink-300 whitespace-nowrap">
                    <a href={href} class="block text-ink-300 hover:text-white">
                      {r.generated_at.slice(0, 19).replace('T', ' ')}
                    </a>
                  </td>
                  <td class="px-4 py-3 text-white">
                    <a href={href} class="block hover:text-brand-200">
                      {r.pair.join(' × ')}
                    </a>
                  </td>
                  <td class="px-4 py-3">
                    <a href={href} class="block">
                      <span
                        class="inline-flex items-center gap-1.5 rounded px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider"
                        style={`color:${tc}; background:${tc}14; border:1px solid ${tc}55;`}
                      >
                        {r.evidence_level}
                      </span>
                    </a>
                  </td>
                  <td class="px-4 py-3 text-right font-mono text-xs text-ink-200">
                    <a href={href} class="block hover:text-white">{r.confidence.toFixed(2)}</a>
                  </td>
                  <td
                    class="px-4 py-3 text-right font-mono text-xs"
                    style={`color:${sc};`}
                  >
                    <a href={href} class="block" style={`color:${sc};`}>
                      {r.composite_score.toFixed(2)}
                    </a>
                  </td>
                  <td class="px-4 py-3 text-xs text-ink-200">
                    <a href={href} class="block hover:text-white">
                      {r.headline.slice(0, 90)}
                    </a>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </div>

    {rows.length > 0 && (
      <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
        <p class="text-xs text-ink-400" data-pending-counter>
          Showing {Math.min(PAGE_SIZE, rows.length)} of {rows.length}.
        </p>
        <button
          type="button"
          data-pending-loadmore
          class:list={[
            'rounded-md border border-white/15 bg-white/5 px-4 py-2 text-xs font-mono uppercase tracking-wider text-ink-200 transition hover:bg-white/10 hover:text-white',
            rows.length <= PAGE_SIZE ? 'is-hidden' : '',
          ]}
        >
          Load 100 more
        </button>
      </div>
    )}
  </section>
</Layout>

<style>
  .is-hidden { display: none !important; }
  .sort-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font: inherit;
    color: inherit;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-transform: inherit;
    letter-spacing: inherit;
    transition: color 100ms;
  }
  .sort-btn:hover { color: rgb(196 181 253); /* brand-300 */ }
  .sort-btn-right { margin-left: auto; }
  .sort-btn.is-active { color: rgb(196 181 253); }
  .sort-arrow {
    display: inline-block;
    min-width: 0.6rem;
    font-size: 0.75em;
    opacity: 0.85;
  }
</style>

<script>
  type Dir = 'asc' | 'desc';
  type Key = 'when' | 'pair' | 'tier' | 'confidence' | 'composite' | 'headline';

  const PAGE_SIZE = 100;
  const NUMERIC: Record<Key, boolean> = {
    when: false, pair: false, tier: false,
    confidence: true, composite: true,
    headline: false,
  };

  const table = document.querySelector<HTMLTableElement>('[data-pending-table]');
  if (table) {
    const tbody = table.querySelector<HTMLTableSectionElement>('[data-pending-tbody]')!;
    const allRows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr'));
    const headers = Array.from(table.querySelectorAll<HTMLButtonElement>('.sort-btn'));
    const loadMore = document.querySelector<HTMLButtonElement>('[data-pending-loadmore]');
    const counter = document.querySelector<HTMLParagraphElement>('[data-pending-counter]');
    const total = allRows.length;

    let visible = Math.min(PAGE_SIZE, total);
    // Server pre-sorted by "when" descending. We don't show an arrow until
    // the user clicks something, so initial sortKey is null.
    let sortKey: Key | null = null;
    let sortDir: Dir = 'asc';

    const dataKey = (key: Key) =>
      'sort' + key.charAt(0).toUpperCase() + key.slice(1);

    const applyVisibility = () => {
      allRows.forEach((row, idx) => {
        row.classList.toggle('is-hidden', idx >= visible);
      });
      if (loadMore) {
        loadMore.classList.toggle('is-hidden', visible >= total);
      }
      if (counter) {
        const shown = Math.min(visible, total);
        counter.textContent = `Showing ${shown} of ${total}.`;
      }
    };

    const updateHeaderUI = () => {
      headers.forEach((btn) => {
        const isActive = btn.dataset.sortKey === sortKey;
        btn.classList.toggle('is-active', isActive);
        const arrow = btn.querySelector<HTMLSpanElement>('.sort-arrow');
        if (arrow) {
          arrow.textContent = isActive ? (sortDir === 'asc' ? '▲' : '▼') : '';
        }
      });
    };

    const applySort = () => {
      if (!sortKey) return;
      const key = sortKey;
      const numeric = NUMERIC[key];
      const dirFactor = sortDir === 'asc' ? 1 : -1;
      const sorted = [...allRows].sort((a, b) => {
        const av = a.dataset[dataKey(key)] ?? '';
        const bv = b.dataset[dataKey(key)] ?? '';
        if (numeric) {
          return (parseFloat(av) - parseFloat(bv)) * dirFactor;
        }
        return av.localeCompare(bv) * dirFactor;
      });
      // Reattach in new order. allRows itself reorders too so pagination
      // keeps tracking the same physical sequence.
      sorted.forEach((row) => tbody.appendChild(row));
      allRows.length = 0;
      allRows.push(...sorted);
    };

    headers.forEach((btn) => {
      btn.addEventListener('click', () => {
        const nextKey = btn.dataset.sortKey as Key;
        if (sortKey === nextKey) {
          // Same column: flip direction.
          sortDir = sortDir === 'asc' ? 'desc' : 'asc';
        } else {
          sortKey = nextKey;
          sortDir = 'asc';
        }
        // After a sort, reset pagination so we show the top of the new order.
        visible = Math.min(PAGE_SIZE, total);
        applySort();
        updateHeaderUI();
        applyVisibility();
      });
    });

    if (loadMore) {
      loadMore.addEventListener('click', () => {
        visible = Math.min(visible + PAGE_SIZE, total);
        applyVisibility();
      });
    }

    // Paint initial visibility (server already laid out the rows in the
    // default order; we just need the right "Load 100 more" + counter state).
    applyVisibility();
  }
</script>
