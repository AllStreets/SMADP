---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);
const PENDING_DIR = path.join(__dirname, '..', '..', '..', 'catalog', 'pending');

interface PendingRow {
  key: string;
  pair: string[];
  evidence_level: string;
  confidence: number;
  composite_score: number;
  headline: string;
  generated_at: string;
}

let rows: PendingRow[] = [];
try {
  const files = fs.readdirSync(PENDING_DIR).filter((f) => f.endsWith('.json'));
  for (const f of files) {
    try {
      const raw = fs.readFileSync(path.join(PENDING_DIR, f), 'utf-8');
      const d = JSON.parse(raw);
      const pair: string[] = Array.isArray(d.pair) ? d.pair : Array.isArray(d.participants) ? d.participants : [];
      rows.push({
        key: f.replace(/\.json$/, ''),
        pair,
        evidence_level: String(d.evidence_level ?? 'unknown'),
        confidence: Number(d.confidence ?? 0),
        composite_score: Number(d.composite_score ?? 0),
        headline: String(d.headline ?? ''),
        generated_at: String(d.generated_at ?? ''),
      });
    } catch {
      /* skip malformed */
    }
  }
} catch {
  rows = [];
}
rows.sort((a, b) => (a.generated_at < b.generated_at ? 1 : -1));

const tierColor = (t: string): string => {
  switch (t) {
    case 'sandbox-validated':
      return '#22C55E';
    case 'profile-verified':
      return '#7C3AED';
    case 'docs-only':
      return '#A78BFA';
    default:
      return '#71717A';
  }
};
const scoreColor = (s: number): string =>
  s < 0.3 ? '#22C55E' : s < 0.6 ? '#F59E0B' : '#EF4444';
---

<Layout title="Pending review — SMADP">
  <section class="container-page mt-10">
    <span class="heading-eyebrow text-amber-300">Operator queue · awaiting approval</span>
    <h1 class="h1 mt-3 text-white">Pending verdicts</h1>
    <p class="lead mt-4 max-w-3xl">
      Autopilot writes new verdicts here before they reach the public catalog.
      Approve from the CLI:
      <code class="font-mono text-brand-300">smadp pending approve &lt;key&gt;</code>
      or bulk-approve by filter:
      <code class="font-mono text-brand-300">smadp pending approve --tier docs-only --min-confidence 0.85 --limit 500 --yes</code>.
    </p>
  </section>

  <section class="container-page mt-8">
    <div
      class="rounded-lg border border-amber-500/30 bg-amber-950/20 px-4 py-3 text-sm text-amber-200"
    >
      <strong>Not yet posted:</strong> these verdicts are visible only on this
      page and via <code class="font-mono">smadp pending list</code>. They are
      not indexed on the homepage, the verdicts index, or any agent page.
    </div>

    <div class="mt-6 overflow-hidden rounded-xl border border-white/10 bg-ink-900/40">
      {rows.length === 0 ? (
        <div class="px-6 py-10 text-center text-sm text-ink-400">
          No verdicts pending review.
        </div>
      ) : (
        <table class="w-full text-sm">
          <thead class="text-left font-mono text-[11px] uppercase tracking-wider text-ink-400">
            <tr class="border-b border-white/10 bg-ink-850/40">
              <th class="px-4 py-3">When</th>
              <th class="px-4 py-3">Pair</th>
              <th class="px-4 py-3">Tier</th>
              <th class="px-4 py-3 text-right">Confidence</th>
              <th class="px-4 py-3 text-right">Composite</th>
              <th class="px-4 py-3">Headline</th>
            </tr>
          </thead>
          <tbody>
            {rows.slice(0, 500).map((r) => {
              const tc = tierColor(r.evidence_level);
              const sc = scoreColor(r.composite_score);
              return (
                <tr class="border-t border-white/5 hover:bg-white/[0.02]">
                  <td class="px-4 py-3 font-mono text-xs text-ink-300 whitespace-nowrap">
                    {r.generated_at.slice(0, 19).replace('T', ' ')}
                  </td>
                  <td class="px-4 py-3 text-white">{r.pair.join(' × ')}</td>
                  <td class="px-4 py-3">
                    <span
                      class="inline-flex items-center gap-1.5 rounded px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider"
                      style={`color:${tc}; background:${tc}14; border:1px solid ${tc}55;`}
                    >
                      {r.evidence_level}
                    </span>
                  </td>
                  <td class="px-4 py-3 text-right font-mono text-xs text-ink-200">
                    {r.confidence.toFixed(2)}
                  </td>
                  <td
                    class="px-4 py-3 text-right font-mono text-xs"
                    style={`color:${sc};`}
                  >
                    {r.composite_score.toFixed(2)}
                  </td>
                  <td class="px-4 py-3 text-xs text-ink-200">{r.headline.slice(0, 90)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      )}
    </div>
    <p class="mt-3 text-xs text-ink-400">
      {rows.length} pending · showing up to 500.
    </p>
  </section>
</Layout>
