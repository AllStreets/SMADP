---
import Layout from '../layouts/Layout.astro';
import RiskBadge from '../components/RiskBadge.astro';
import { getRiskTaxonomy } from '../data/catalog';

const tax = getRiskTaxonomy();
---

<Layout title="Risk taxonomy — SMADP">
  <section class="container-page mt-10">
    <span class="heading-eyebrow">The five risks</span>
    <h1 class="h1 mt-3 text-white">What goes wrong when agents share an environment</h1>
    <p class="lead mt-4 max-w-3xl">
      We classify pairwise multi-agent risk into five orthogonal categories.
      Each verdict assigns an independent severity per category — so a pair can
      be perfectly compliant but capability-conflicting, or low-leakage but
      prone to cascading errors.
    </p>
  </section>

  <!-- Severity legend -->
  <section class="container-page mt-10">
    <div class="card">
      <h2 class="heading-eyebrow">Severity scale</h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-5">
        {tax.severities.map((s) => (
          <div class="rounded-lg border border-white/5 bg-ink-900/40 p-3 text-center">
            <div
              class="mx-auto h-2 w-12 rounded-full"
              style={`background:${s.color}; box-shadow:0 0 12px ${s.color}80;`}
            ></div>
            <div class="mt-2 font-mono text-[11px] uppercase tracking-wider text-ink-200">{s.label}</div>
            <div class="font-mono text-[10px] text-ink-500">score {s.score.toFixed(1)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Each risk -->
  <section class="container-page mt-12 space-y-10">
    {tax.risks.map((r) => (
      <article id={r.id} class="card scroll-mt-24">
        <header class="flex flex-wrap items-start justify-between gap-4">
          <div class="flex items-start gap-4">
            <RiskBadge risk={r.id} size="md" />
            <div>
              <span class="heading-eyebrow">risk · weight {r.weight.toFixed(2)}</span>
              <h2 class="mt-1 h2 text-white">{r.name}</h2>
            </div>
          </div>
        </header>

        <p class="mt-5 max-w-3xl text-ink-200 leading-relaxed">{r.description}</p>

        {r.examples?.length > 0 && (
          <div class="mt-6">
            <div class="font-mono text-[11px] uppercase tracking-wider text-amber-400">Examples</div>
            <ul class="mt-2 space-y-2">
              {r.examples.map((ex) => (
                <li class="rounded-lg border-l-2 border-amber-500/40 bg-amber-500/5 px-4 py-2 text-sm text-ink-200">
                  {ex}
                </li>
              ))}
            </ul>
          </div>
        )}

        {r.evaluation_dimensions?.length > 0 && (
          <div class="mt-6">
            <div class="font-mono text-[11px] uppercase tracking-wider text-cyber-400">
              Evaluation dimensions
            </div>
            <ul class="mt-2 list-disc list-inside space-y-1 text-sm text-ink-300">
              {r.evaluation_dimensions.map((d) => <li>{d}</li>)}
            </ul>
          </div>
        )}
      </article>
    ))}
  </section>
</Layout>
