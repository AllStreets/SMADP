---
import Layout from '../../layouts/Layout.astro';
import VerdictCard from '../../components/VerdictCard.astro';
import { getVerdicts, getRiskTaxonomy } from '../../data/catalog';

const verdicts = getVerdicts();
const taxonomy = getRiskTaxonomy();
const evidenceLevels = taxonomy.evidence_levels.map((e) => e.id);
---

<Layout title="Verdicts — SMADP">
  <section class="container-page mt-10">
    <span class="heading-eyebrow">Catalog</span>
    <h1 class="h1 mt-3 text-white">Pairwise verdicts</h1>
    <p class="lead mt-4 max-w-2xl">
      {verdicts.length} verdicts in the catalog. Sort by composite score, severity,
      or recency. Filter by evidence level.
    </p>
  </section>

  <section class="container-page mt-10">
    <div class="mb-6 flex flex-wrap items-center gap-2">
      <input
        id="verdict-search"
        type="search"
        placeholder="Search by agent, headline…"
        class="w-full max-w-xs rounded-lg border border-white/10 bg-ink-900/80 px-3 py-2 text-sm text-ink-100 placeholder:text-ink-500 focus:border-brand-500/60"
      />
      <select
        id="verdict-evlevel"
        class="rounded-lg border border-white/10 bg-ink-900/80 px-3 py-2 text-sm text-ink-100"
      >
        <option value="">Any evidence level</option>
        {evidenceLevels.map((e) => <option value={e}>{e}</option>)}
      </select>
      <select
        id="verdict-sort"
        class="rounded-lg border border-white/10 bg-ink-900/80 px-3 py-2 text-sm text-ink-100"
      >
        <option value="recent">Most recent</option>
        <option value="composite-desc">Highest risk (composite ↓)</option>
        <option value="composite-asc">Safest (composite ↑)</option>
      </select>
      <span id="verdict-count" class="ml-auto font-mono text-xs text-ink-400">
        {verdicts.length} shown
      </span>
    </div>

    {verdicts.length === 0 ? (
      <div class="card text-center text-ink-300">
        <p>No verdicts in the catalog yet.</p>
        <p class="mt-2 text-sm text-ink-500">
          Add JSON files to <code class="font-mono text-brand-300">catalog/verdicts/</code> and rebuild.
        </p>
      </div>
    ) : (
      <div id="verdict-grid" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {verdicts.map((v) => (
          <div
            class="verdict-tile"
            data-search={`${v.pair.join(' ')} ${v.headline}`.toLowerCase()}
            data-evlevel={v.evidence_level}
            data-composite={v.composite_score}
            data-generated={v.generated_at}
          >
            <VerdictCard verdict={v} />
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>

<script>
  const search = document.getElementById('verdict-search') as HTMLInputElement | null;
  const evlevel = document.getElementById('verdict-evlevel') as HTMLSelectElement | null;
  const sort = document.getElementById('verdict-sort') as HTMLSelectElement | null;
  const counter = document.getElementById('verdict-count');
  const grid = document.getElementById('verdict-grid');
  if (!grid) {
    // nothing
  } else {
    function tiles() {
      return Array.from(grid!.querySelectorAll<HTMLDivElement>('.verdict-tile'));
    }
    function apply() {
      const q = (search?.value || '').toLowerCase().trim();
      const ev = evlevel?.value || '';
      let shown = 0;
      tiles().forEach((t) => {
        const okQ = !q || t.dataset.search?.includes(q);
        const okE = !ev || t.dataset.evlevel === ev;
        const ok = okQ && okE;
        t.style.display = ok ? '' : 'none';
        if (ok) shown++;
      });
      if (counter) counter.textContent = `${shown} shown`;

      const mode = sort?.value || 'recent';
      const sorted = tiles().slice().sort((a, b) => {
        if (mode === 'recent') {
          return (b.dataset.generated || '').localeCompare(a.dataset.generated || '');
        }
        const ax = Number(a.dataset.composite);
        const bx = Number(b.dataset.composite);
        return mode === 'composite-desc' ? bx - ax : ax - bx;
      });
      sorted.forEach((t) => grid!.appendChild(t));
    }
    [search, evlevel, sort].forEach((el) => el?.addEventListener('input', apply));
    sort?.addEventListener('change', apply);
  }
</script>
