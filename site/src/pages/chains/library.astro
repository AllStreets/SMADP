---
import Layout from '../../layouts/Layout.astro';
import ChainTopologyBadge from '../../components/ChainTopologyBadge.astro';
import EvidenceLevelBadge from '../../components/EvidenceLevelBadge.astro';
import { getChains, computeComposite } from '../../lib/chains';
import { compositeColor, severityColor } from '../../data/catalog';
import { RISK_ORDER } from '../../data/types';
import type { RiskId } from '../../data/types';

const RISK_LETTER: Record<RiskId, string> = {
  A_prompt_injection: 'A',
  B_data_leakage: 'B',
  C_capability_conflict: 'C',
  D_cascading_error: 'D',
  E_compliance: 'E',
};
const RISK_NAME: Record<RiskId, string> = {
  A_prompt_injection: 'Prompt injection',
  B_data_leakage: 'Data leakage',
  C_capability_conflict: 'Capability conflict',
  D_cascading_error: 'Cascading error',
  E_compliance: 'Compliance',
};

const chains = getChains();

const topologyCounts = chains.reduce<Record<string, number>>((acc, c) => {
  acc[c.topology] = (acc[c.topology] ?? 0) + 1;
  return acc;
}, {});

const avgComposite = chains.length
  ? chains.reduce((a, c) => a + computeComposite(c), 0) / chains.length
  : 0;
const sandboxValidated = chains.filter((c) => c.evidence_level === 'sandbox-validated').length;
---

<Layout title="Chain library — SMADP">
  <section class="container-page mt-10">
    <a href="/chains" class="font-mono text-xs text-ink-400 hover:text-brand-300">← back to the builder</a>
    <div class="mt-4 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="heading-eyebrow">Catalog · Chains</span>
        <h1 class="h1 mt-3 text-white">Chain library</h1>
        <p class="lead mt-4 max-w-2xl">
          {chains.length} multi-agent compositions, each analyzed against the
          five risks plus topology-specific propagation concerns. Every chain
          on this page was authored, then graded by the same rubric the
          pairwise verdicts use.
        </p>
      </div>
      <a href="/chains" class="btn-primary">+ Build a chain</a>
    </div>

    <!-- KPI strip -->
    <div class="mt-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class="rounded-xl border border-white/10 bg-ink-950/60 p-4">
        <div class="font-mono text-[10px] uppercase tracking-wider text-ink-400">Chains</div>
        <div class="mt-1 font-display text-3xl font-extrabold text-white">{chains.length}</div>
      </div>
      <div class="rounded-xl border border-white/10 bg-ink-950/60 p-4">
        <div class="font-mono text-[10px] uppercase tracking-wider text-ink-400">Avg composite</div>
        <div class="mt-1 font-display text-3xl font-extrabold" style={`color:${compositeColor(avgComposite)}`}>
          {avgComposite.toFixed(2)}
        </div>
      </div>
      <div class="rounded-xl border border-white/10 bg-ink-950/60 p-4">
        <div class="font-mono text-[10px] uppercase tracking-wider text-ink-400">Sandbox validated</div>
        <div class="mt-1 font-display text-3xl font-extrabold text-emerald-400">{sandboxValidated}</div>
      </div>
      <div class="rounded-xl border border-white/10 bg-ink-950/60 p-4">
        <div class="font-mono text-[10px] uppercase tracking-wider text-ink-400">Topologies</div>
        <div class="mt-1 flex flex-wrap gap-1.5">
          {Object.entries(topologyCounts).sort((a, b) => b[1] - a[1]).map(([topo, n]) => (
            <span class="inline-flex items-center gap-1.5 rounded-md bg-white/5 px-1.5 py-0.5 font-mono text-[11px] text-ink-300 ring-1 ring-inset ring-white/10">
              <span class="font-semibold text-brand-300">{n}</span>
              <span>{topo}</span>
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="container-page mt-10 grid gap-4" id="chain-list">
    {chains.length === 0 && (
      <p class="card p-6 text-ink-300" id="chain-empty">No chains yet. Be the first to build one.</p>
    )}
    {chains.map((c) => {
      const score = computeComposite(c);
      return (
        <a href={`/chains/${c.chain_id}`} class="card group block transition hover:border-brand-500/40">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2">
                <ChainTopologyBadge topology={c.topology} />
                <h3 class="font-display text-xl font-semibold text-white group-hover:text-brand-200">{c.name}</h3>
              </div>
              {c.tagline && <p class="mt-1 text-xs italic text-ink-400">{c.tagline}</p>}
              <p class="mt-3 max-w-3xl text-sm text-ink-200">{c.headline}</p>
              <div class="mt-3 flex flex-wrap items-center gap-2">
                {c.author && <span class="font-mono text-[11px] text-ink-400">by {c.author}</span>}
                {c.evidence_level && <EvidenceLevelBadge level={c.evidence_level} size="sm" />}
                <span class="rounded bg-white/5 px-2 py-0.5 font-mono text-[10px] text-ink-300">{c.participants.length} agents</span>
                <span class="rounded bg-white/5 px-2 py-0.5 font-mono text-[10px] text-ink-300">{c.edges.length} edges</span>
              </div>
              <div class="mt-4 flex flex-wrap gap-1.5">
                {c.participants.map((p) => (
                  <span class="inline-flex items-center gap-1 rounded-md bg-white/5 px-2 py-1 text-xs text-ink-200 ring-1 ring-inset ring-white/10">
                    <span class="font-medium">{p.slug}</span>
                    <span class="text-ink-400">·</span>
                    <span class="text-ink-400">{p.role}</span>
                  </span>
                ))}
              </div>
            </div>
            <div class="flex shrink-0 flex-col items-end gap-3">
              <div class="rounded-xl border border-white/10 bg-ink-950/60 p-4 text-center">
                <div class="font-mono text-[10px] uppercase tracking-wider text-ink-400">Composite</div>
                <div class="mt-1 font-display text-3xl font-extrabold leading-none" style={`color:${compositeColor(score)}`}>
                  {score.toFixed(2)}
                </div>
                <div class="mt-1 text-[10px] text-ink-500">lower is safer</div>
              </div>
              <!-- 5-risk fingerprint: each letter chip colored by that risk's severity.
                   Replaces the previous single max-severity bar (which read "HIGH" for
                   a 0.32 composite chain because A was high at only 10% weight). -->
              <div class="flex items-center gap-1.5" aria-label="Per-risk severity fingerprint">
                {RISK_ORDER.map((rk: RiskId) => {
                  const sv = c.sub_verdicts[rk];
                  return (
                    <span
                      class="inline-flex h-7 w-7 items-center justify-center rounded-md font-mono text-[11px] font-bold text-white ring-1 ring-inset ring-white/10"
                      style={`background:${severityColor(sv.severity)}33;color:${severityColor(sv.severity)};`}
                      title={`${RISK_NAME[rk]}: ${sv.severity}`}
                    >
                      {RISK_LETTER[rk]}
                    </span>
                  );
                })}
              </div>
            </div>
          </div>
        </a>
      );
    })}
  </section>

  <script type="application/json" id="chain-baked" set:html={JSON.stringify(chains.map((c) => c.chain_id))}></script>

  <script>
    import { apiFetch } from '../../lib/api';

    type Sev = 'none' | 'low' | 'medium' | 'high' | 'critical';
    interface ApiChain {
      chain_id: string;
      name: string;
      topology: string;
      headline: string;
      author?: string;
      participants: { slug: string; role: string; notes?: string }[];
      sub_verdicts: Record<string, { severity: Sev }>;
    }

    const SEV_COLOR: Record<Sev, string> = {
      none: '#22C55E', low: '#84CC16', medium: '#F59E0B', high: '#EF4444', critical: '#7F1D1D',
    };
    const SEV_RANK: Sev[] = ['none', 'low', 'medium', 'high', 'critical'];

    function maxSev(c: ApiChain): Sev {
      let i = 0;
      for (const sv of Object.values(c.sub_verdicts)) {
        const r = SEV_RANK.indexOf(sv.severity);
        if (r > i) i = r;
      }
      return SEV_RANK[i]!;
    }

    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, (ch) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[ch]!));
    }

    function renderNew(c: ApiChain): HTMLElement {
      const card = document.createElement('div');
      card.className = 'card relative';
      const sev = maxSev(c);
      const byline = c.author ? `by ${escapeHtml(c.author)}` : 'no author given';
      card.innerHTML = `
        <div class="absolute right-4 top-4 rounded-md bg-brand-500/10 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-brand-300">
          new · via builder
        </div>
        <div class="flex items-center gap-2">
          <h3 class="font-display text-lg font-semibold text-white">${escapeHtml(c.name)}</h3>
          <span class="rounded-md bg-white/5 px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-ink-300">${escapeHtml(c.topology)}</span>
        </div>
        <p class="mt-1 font-mono text-[10px] uppercase tracking-wider text-ink-400">${byline}</p>
        <p class="mt-3 text-sm text-ink-200">${escapeHtml(c.headline)}</p>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          ${c.participants.map(p => `
            <span class="inline-flex items-center gap-1 rounded-md bg-white/5 px-2 py-1 text-xs text-ink-200 ring-1 ring-inset ring-white/10">
              <span class="font-medium">${escapeHtml(p.slug)}</span>
              <span class="text-ink-400">·</span>
              <span class="text-ink-400">${escapeHtml(p.role)}</span>
            </span>
          `).join('')}
        </div>
        <div class="mt-3 flex items-center gap-3 text-xs">
          <span class="inline-flex items-center gap-1.5 font-mono text-ink-300">
            <span class="inline-block h-2.5 w-2.5 rounded-sm" style="background:${SEV_COLOR[sev]}"></span>
            max severity ${sev}
          </span>
          <span class="text-ink-500">(rebuild the site to bake this chain into the static catalog)</span>
        </div>
      `;
      return card;
    }

    (async () => {
      const bakedNode = document.getElementById('chain-baked');
      const baked = new Set<string>(bakedNode ? JSON.parse(bakedNode.textContent || '[]') : []);
      try {
        const resp = await apiFetch<{ items: ApiChain[] }>('/chains');
        const fresh = (resp.items ?? []).filter((c) => !baked.has(c.chain_id));
        if (fresh.length === 0) return;
        const list = document.getElementById('chain-list')!;
        document.getElementById('chain-empty')?.remove();
        const header = document.createElement('div');
        header.className = 'mt-4';
        header.innerHTML = `
          <span class="heading-eyebrow">Just submitted</span>
          <p class="mt-1 text-sm text-ink-400">
            ${fresh.length} chain${fresh.length === 1 ? '' : 's'} from the builder, not yet baked into the static catalog.
          </p>
        `;
        list.appendChild(header);
        for (const c of fresh) list.appendChild(renderNew(c));
      } catch {
        // backend offline, silently skip
      }
    })();
  </script>
</Layout>
