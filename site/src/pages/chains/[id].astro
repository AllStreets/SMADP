---
import Layout from '../../layouts/Layout.astro';
import Panel from '../../components/Panel.astro';
import SeverityBar from '../../components/SeverityBar.astro';
import ChainTopologyBadge from '../../components/ChainTopologyBadge.astro';
import { getChains, maxSeverity, type Chain } from '../../lib/chains';

export function getStaticPaths() {
  return getChains().map((chain) => ({
    params: { id: chain.chain_id },
    props: { chain },
  }));
}

const { chain } = Astro.props as { chain: Chain };

const SUB_LABELS: Record<string, string> = {
  A_prompt_injection: 'A · Prompt injection',
  B_data_leakage: 'B · Data leakage',
  C_capability_conflict: 'C · Capability conflict',
  D_cascading_error: 'D · Cascading error',
  E_compliance: 'E · Compliance',
};

const nodeCount = chain.participants.length;
const W = 720;
const H = chain.topology === 'star' ? 280 : 160;
const nodeR = 28;

function pos(i: number): { x: number; y: number } {
  if (chain.topology === 'star') {
    if (i === 0) return { x: W / 2, y: H / 2 };
    const others = nodeCount - 1;
    const angle = ((i - 1) / others) * 2 * Math.PI;
    return { x: W / 2 + Math.cos(angle) * 110, y: H / 2 + Math.sin(angle) * 110 };
  }
  const span = W - 80;
  const x = 40 + (nodeCount === 1 ? span / 2 : (i / (nodeCount - 1)) * span);
  return { x, y: H / 2 };
}

const positions = chain.participants.map((_, i) => pos(i));

function indexFor(slug: string): number {
  for (let i = 0; i < chain.participants.length; i++) {
    if (chain.participants[i].slug === slug) return i;
  }
  return 0;
}
---

<Layout title={`${chain.name} — Chain — SMADP`} description={chain.headline}>
  <section class="container-page mt-8">
    <a href="/chains" class="font-mono text-xs text-ink-400 hover:text-brand-300">← all chains</a>
    <div class="mt-4 flex flex-wrap items-start justify-between gap-6">
      <div class="min-w-0">
        <span class="heading-eyebrow">Chain</span>
        <h1 class="h1 mt-2 text-white">{chain.name}</h1>
        <p class="lead mt-3 max-w-2xl">{chain.headline}</p>
        <div class="mt-4 flex flex-wrap items-center gap-2">
          <ChainTopologyBadge topology={chain.topology} />
          <SeverityBar severity={maxSeverity(chain)} />
        </div>
      </div>
    </div>
  </section>

  <section class="container-page mt-10">
    <Panel title="Topology" icon="layers" defaultOpen>
      <div class="overflow-x-auto">
        <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full max-w-[720px]" aria-label="Chain topology">
          {chain.edges.map((e) => {
            const a = positions[indexFor(e.from)];
            const b = positions[indexFor(e.to)];
            return (
              <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} stroke="rgba(167,139,250,0.5)" stroke-width="2" />
            );
          })}
          {chain.participants.map((p, i) => {
            const { x, y } = positions[i];
            return (
              <g>
                <circle cx={x} cy={y} r={nodeR} fill="#1F1633" stroke="#A78BFA" stroke-width="2" />
                <text x={x} y={y + 4} text-anchor="middle" font-size="11" fill="#E5E7EB">{p.role}</text>
                <text x={x} y={y + nodeR + 16} text-anchor="middle" font-size="11" fill="#A1A1AA">{p.slug}</text>
              </g>
            );
          })}
        </svg>
      </div>
      <ul class="mt-4 grid gap-2 text-xs text-ink-300 sm:grid-cols-2">
        {chain.edges.map((e) => (
          <li class="rounded-md border border-white/5 bg-white/[0.02] p-2">
            <span class="font-mono text-ink-200">{e.from}</span>
            <span class="mx-1 text-ink-500">→</span>
            <span class="font-mono text-ink-200">{e.to}</span>
            <span class="ml-2 rounded bg-white/5 px-1.5 py-0.5 text-[10px] uppercase tracking-wider">{e.channel}</span>
            {e.carries && e.carries.length > 0 && (
              <span class="ml-2 text-ink-400">carries {e.carries.join(', ')}</span>
            )}
          </li>
        ))}
      </ul>
    </Panel>

    <div class="mt-6 grid gap-4">
      {Object.entries(chain.sub_verdicts).map(([key, sv]) => (
        <Panel
          title={SUB_LABELS[key] || key}
          icon="alert-triangle"
          id={key.toLowerCase()}
          defaultOpen={sv.severity === 'high' || sv.severity === 'critical'}
        >
          <Fragment slot="badge"><SeverityBar severity={sv.severity} /></Fragment>
          <p class="text-sm text-ink-200">{sv.rationale}</p>
          {sv.conditions.length > 0 && (
            <div class="mt-3">
              <p class="text-xs font-semibold uppercase tracking-wider text-ink-400">Conditions</p>
              <ul class="mt-1 list-inside list-disc text-sm text-ink-200">
                {sv.conditions.map((c) => <li>{c}</li>)}
              </ul>
            </div>
          )}
          {sv.mitigations.length > 0 && (
            <div class="mt-3">
              <p class="text-xs font-semibold uppercase tracking-wider text-ink-400">Mitigations</p>
              <ul class="mt-1 list-inside list-disc text-sm text-ink-200">
                {sv.mitigations.map((m) => <li>{m}</li>)}
              </ul>
            </div>
          )}
        </Panel>
      ))}
    </div>
  </section>
</Layout>
