---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { loadVerdicts } from '~/lib/briefs/catalog';
import { groupByEvidenceTier } from '~/lib/briefs/aggregations';

const verdicts = loadVerdicts();
const groups = groupByEvidenceTier(verdicts);

const layouts = [
  {
    n: '01',
    name: 'Primer',
    href: '/briefs/primer/',
    pdf: '/briefs/primer.pdf',
    pages: 10,
    read: '6 min',
    audience: 'For the reader who needs the whole story by the end of the coffee.',
    blurb:
      'A linear narrative — thesis, methodology, headline findings, limits. Built to be the first thing you hand a stakeholder who has never heard of pair-level agent risk.',
    contents: [
      '§ 1  The question — why pair-level risk matters',
      '§ 2  Methodology — how every verdict is built',
      '§ 3  Risk taxonomy — the five dimensions',
      '§ 4  Headline finding — the seam that cracks first',
      'Exhibit 1  Severity heatmap across top pairs',
    ],
    accent: 'violet',
  },
  {
    n: '02',
    name: 'Prospectus',
    href: '/briefs/prospectus/',
    pdf: '/briefs/prospectus.pdf',
    pages: 14,
    read: '10 min',
    audience: 'For the institutional reader who wants both the pitch and the receipts.',
    blurb:
      'An investment-bank format. The thesis sits up front; the data appendix sits in back. Mid-section ties every dimension to a worked example with verdict citations.',
    contents: [
      'Executive summary',
      '§ Why this matters · § Methodology · § Headline finding',
      'Appendix A–H · receipts, framework mappings, raw rankings',
    ],
    accent: 'cyan',
  },
  {
    n: '03',
    name: 'Dossier',
    href: '/briefs/dossier/',
    pdf: '/briefs/dossier.pdf',
    pages: 16,
    read: '14 min',
    audience: 'For the auditor, the researcher, the engineer who builds adjacent.',
    blurb:
      'The complete file. Every risk dimension, every agent of note, every verdict on the books — laid out the way the catalog actually stores them, with no editorial smoothing.',
    contents: [
      '§ 1  Thesis · § 2  Methodology in full',
      '§ 4  Pairwise risk by dimension · § 6  Severity heatmap',
      '§ 8–9  Agent dossier · closed-source then open-source',
      '§ 11  Full verdict register (all 105 pairs)',
    ],
    accent: 'emerald',
  },
];

const stats = [
  { value: verdicts.length, label: 'Pair verdicts' },
  { value: groups.sandbox.length, label: 'Sandbox-validated' },
  { value: groups.profileVerified.length, label: 'Profile-verified' },
  { value: groups.docsOnly.length, label: 'Docs-only' },
];

const accentColors: Record<string, { ring: string; glow: string; text: string }> = {
  violet: {
    ring: 'ring-brand-500/30',
    glow: 'bg-brand-500/20',
    text: 'text-brand-300',
  },
  cyan: {
    ring: 'ring-cyan-500/30',
    glow: 'bg-cyan-500/20',
    text: 'text-cyan-300',
  },
  emerald: {
    ring: 'ring-emerald-500/30',
    glow: 'bg-emerald-500/20',
    text: 'text-emerald-300',
  },
};
---

<Layout
  title="Briefs — SMADP"
  description="Three reads on one dataset. Primer, Prospectus, Dossier. Each renders the same verdict catalog at a different depth — print-ready, PDF-exportable."
>
  <!-- Hero -->
  <section class="container-page mt-12 bg-line-grid">
    <span class="heading-eyebrow">Three reads · one dataset</span>
    <h1 class="h1 mt-3 text-white">
      Pick the read that <span class="text-brand-300">matches your bandwidth</span>.
    </h1>
    <p class="lead mt-4 max-w-3xl">
      Every layout below renders from the same underlying catalog. Each is print-ready
      and exports as a self-contained PDF. The evidence tier on every claim is preserved
      across all three — no layout silently promotes docs-only into sandbox-validated.
    </p>

    <!-- Stats row -->
    <div class="mt-10 grid gap-3 sm:grid-cols-4">
      {stats.map((s, idx) => (
        <div class="card">
          <div class={`font-mono text-3xl tabular-nums ${idx === 1 ? 'text-brand-300' : 'text-white'}`}>
            {s.value}
          </div>
          <div class="mt-1 font-mono text-[11px] uppercase tracking-wider text-ink-400">
            {s.label}
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Brief cards -->
  <section class="container-page mt-16 grid gap-6 lg:grid-cols-3">
    {layouts.map((l) => {
      const ac = accentColors[l.accent];
      return (
        <article class="card card-hover group relative overflow-hidden flex flex-col">
          <div class={`absolute -right-12 -top-12 h-40 w-40 rounded-full ${ac.glow} blur-3xl opacity-60 pointer-events-none`}></div>

          <div class="flex items-baseline justify-between">
            <span class={`font-mono text-[11px] uppercase tracking-[0.18em] ${ac.text}`}>
              Layout {l.n}
            </span>
            <span class="font-mono text-[11px] uppercase tracking-wider text-ink-400">
              {l.pages} pp · {l.read}
            </span>
          </div>

          <h2 class="h2 mt-3 text-white">{l.name}</h2>
          <p class="mt-3 text-sm italic text-ink-200">{l.audience}</p>
          <p class="mt-2 text-sm text-ink-300 leading-relaxed">{l.blurb}</p>

          <ul class={`mt-5 space-y-1.5 border-t border-white/5 pt-4 ring-inset ${ac.ring}`}>
            {l.contents.map((c) => (
              <li class="font-mono text-[11px] text-ink-400 leading-relaxed">{c}</li>
            ))}
          </ul>

          <div class="mt-6 flex justify-center pt-2">
            <a
              href={l.pdf}
              download={`SMADP-${l.name}.pdf`}
              class="btn-primary text-xs px-8 py-2.5 inline-flex items-center justify-center gap-2"
            >
              Download PDF
            </a>
          </div>
        </article>
      );
    })}
  </section>

  <!-- Why three -->
  <section class="container-page mt-20 mb-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr] border-t border-white/5 pt-10">
      <div>
        <span class="heading-eyebrow">Why three?</span>
        <h2 class="h2 mt-3 text-white max-w-xs">
          One dataset deserves more than one shape.
        </h2>
      </div>
      <div class="space-y-4 text-ink-300 leading-relaxed">
        <p>
          A board member asking "is this real?" needs a different artifact than an auditor
          asking "show every transcript." The catalog never changes — but the framing has to.
          Same numbers, same citations, three different mental shapes.
        </p>
        <p>
          All three are regenerated from <code class="font-mono text-xs bg-white/5 text-ink-100 rounded px-1.5 py-0.5">catalog/</code>
          at build time. When a new verdict lands, all three layouts inherit it on the next
          build. No layout silently promotes evidence above its tier; the evidence badge stays
          honest on every page.
        </p>
      </div>
    </div>
  </section>
</Layout>
