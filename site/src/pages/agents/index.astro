---
import Layout from '../../layouts/Layout.astro';
import AgentCard from '../../components/AgentCard.astro';
import { getProfiles, getCategories } from '../../data/catalog';

const profiles = getProfiles();
const categories = getCategories().categories;
const present = new Set(profiles.map((p) => p.category));
const visibleCategories = categories.filter((c) => present.has(c.id));

const verifiedCount = profiles.filter((p) => (p as any).verification?.status === 'verified').length;
const sourceTypes = ['open-source', 'closed-source', 'source-available'] as const;
---

<Layout title="Agents — SMADP">
  <section class="container-page mt-10">
    <span class="heading-eyebrow">Catalog</span>
    <h1 class="h1 mt-3 text-white">All agents</h1>
    <p class="lead mt-4 max-w-2xl">
      {profiles.length} profiles in the catalog · {verifiedCount} verified.
      Filter by category, source type, or verification status.
    </p>
  </section>

  <section class="container-page mt-10">
    <!-- Filters -->
    <div class="mb-6 flex flex-wrap items-center gap-2">
      <input
        type="search"
        id="agent-search"
        placeholder="Search agents…"
        class="w-full max-w-xs rounded-lg border border-white/10 bg-ink-900/80 px-3 py-2 text-sm text-ink-100 placeholder:text-ink-500 focus:border-brand-500/60"
      />

      <select
        id="agent-category"
        class="rounded-lg border border-white/10 bg-ink-900/80 px-3 py-2 text-sm text-ink-100 focus:border-brand-500/60"
      >
        <option value="">All categories</option>
        {visibleCategories.map((c) => <option value={c.id}>{c.name}</option>)}
      </select>

      <select
        id="agent-source"
        class="rounded-lg border border-white/10 bg-ink-900/80 px-3 py-2 text-sm text-ink-100 focus:border-brand-500/60"
      >
        <option value="">All sources</option>
        {sourceTypes.map((s) => <option value={s}>{s}</option>)}
      </select>

      <select
        id="agent-status"
        class="rounded-lg border border-white/10 bg-ink-900/80 px-3 py-2 text-sm text-ink-100 focus:border-brand-500/60"
      >
        <option value="">Any status</option>
        <option value="verified">Verified only</option>
        <option value="unverified">Unverified only</option>
      </select>

      <span id="agent-count" class="ml-auto font-mono text-xs text-ink-400">
        {profiles.length} shown
      </span>
    </div>

    {profiles.length === 0 ? (
      <div class="card text-center text-ink-300">
        <p>No agent profiles in the catalog yet.</p>
        <p class="mt-2 text-sm text-ink-500">
          Add JSON files to <code class="font-mono text-brand-300">catalog/profiles/</code> and rebuild.
        </p>
      </div>
    ) : (
      <div id="agent-grid" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {profiles.map((p) => (
          <div
            class="agent-tile"
            data-name={p.name.toLowerCase()}
            data-category={p.category}
            data-source={p.source_type}
            data-status={(p as any).verification?.status ?? 'unverified'}
          >
            <AgentCard profile={p} />
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>

<script>
  const search = document.getElementById('agent-search') as HTMLInputElement | null;
  const category = document.getElementById('agent-category') as HTMLSelectElement | null;
  const source = document.getElementById('agent-source') as HTMLSelectElement | null;
  const status = document.getElementById('agent-status') as HTMLSelectElement | null;
  const counter = document.getElementById('agent-count');
  const tiles = document.querySelectorAll<HTMLDivElement>('.agent-tile');

  function apply() {
    const q = (search?.value || '').toLowerCase().trim();
    const cat = category?.value || '';
    const src = source?.value || '';
    const stat = status?.value || '';
    let shown = 0;
    tiles.forEach((t) => {
      const okQ = !q || t.dataset.name?.includes(q);
      const okC = !cat || t.dataset.category === cat;
      const okS = !src || t.dataset.source === src;
      const okV = !stat || t.dataset.status === stat;
      const ok = okQ && okC && okS && okV;
      t.style.display = ok ? '' : 'none';
      if (ok) shown++;
    });
    if (counter) counter.textContent = `${shown} shown`;
  }

  [search, category, source, status].forEach((el) => el?.addEventListener('input', apply));
</script>
