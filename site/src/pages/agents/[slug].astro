---
import Layout from '../../layouts/Layout.astro';
import VerdictCard from '../../components/VerdictCard.astro';
import EvidenceLevelBadge from '../../components/EvidenceLevelBadge.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import {
  getProfiles,
  getProfile,
  getVerdictsForAgent,
  categoryName,
} from '../../data/catalog';

export function getStaticPaths() {
  return getProfiles().map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
const profile = getProfile(slug as string);
if (!profile) {
  return Astro.redirect('/agents');
}
const verdicts = getVerdictsForAgent(profile.slug);

// Unverified stubs have no detailed schema — show a slim placeholder.
const isUnverified = (profile as any).evidence_level === 'unverified-profile'
  || !profile.capabilities;

// Helper to render a key-value pair line.
function row(label: string, value: unknown) {
  return { label, value };
}

// Stub profiles (evidence_level: "unverified-profile") have no capabilities
// data yet. Fall back to an empty object so the page renders the row table
// as "—" placeholders instead of crashing the build.
const caps = (profile.capabilities ?? {}) as Record<string, unknown>;
const capRows = [
  row('Execute shell', caps.execute_shell),
  row('Read filesystem', caps.read_filesystem),
  row('Write filesystem', caps.write_filesystem),
  row('Network egress', caps.network_egress),
  row('Spawn subprocesses', caps.spawn_subprocesses),
  row('Use MCP', caps.use_mcp),
  row('Modify git state', caps.modify_git_state),
  row('Install packages', caps.install_packages),
  row('Run browsers', caps.run_browsers),
];

const verifiedColor: Record<string, string> = {
  verified: '#22C55E',
  draft: '#F59E0B',
  unverified: '#71717A',
  stale: '#EF4444',
  invalid: '#EF4444',
};
const verification = (profile.verification ?? { status: 'unverified', method: '—', verified_by: null }) as any;
const vColor = verifiedColor[verification.status] ?? '#71717A';

// Common slim metadata shared by both paths.
const repoUrl = (profile as any).repo_url || ((profile as any).onexus?.source_github
  ? `https://github.com/${(profile as any).onexus.source_github}`
  : null);
---

{isUnverified ? (
  <Layout title={`${profile.name} — SMADP`} description={`${profile.name}: catalog stub, awaiting enrichment.`}>
    <section class="container-page mt-8">
      <a href="/agents" class="font-mono text-xs text-ink-400 hover:text-brand-300">← all agents</a>
      <div class="mt-6">
        <h1 class="h1 text-white">{profile.name}</h1>
        <p class="lead mt-3 max-w-2xl">
          This agent is in the catalog but its safety profile has not yet been
          enriched. Capabilities, IO surfaces, data classes touched, and risk
          mappings will populate once the autopilot picks it up.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-2 text-xs">
          <span class="pill">{categoryName(profile.category) ?? (profile as any).category ?? '—'}</span>
          <span class="pill">evidence: unverified-profile</span>
          {(profile as any).composite_score != null && (
            <span class="pill">composite score: <span class="text-brand-300 ml-1">{Number((profile as any).composite_score).toFixed(2)}</span></span>
          )}
        </div>
        {repoUrl && (
          <div class="mt-6">
            <a class="btn-ghost" href={repoUrl}>Source on GitHub</a>
          </div>
        )}
      </div>
    </section>
  </Layout>
) : (() => {
// Defensive defaults for the rich-detail branch.
const vendor = (profile as any).vendor ?? { handle: '—', type: '—' };
const ioSurfaces = ((profile as any).io_surfaces ?? {}) as any;
const ioFiles = Array.isArray(ioSurfaces.files) ? ioSurfaces.files : [];
const ioApis = Array.isArray(ioSurfaces.calls_apis) ? ioSurfaces.calls_apis : [];
const permissions = ((profile as any).permissions_requested ?? {}) as any;
const oauthScopes = Array.isArray(permissions.oauth_scopes) ? permissions.oauth_scopes : [];
const secretsHandled = Array.isArray(permissions.secrets_handled) ? permissions.secrets_handled : [];
const elevatedPrivs = Array.isArray(permissions.elevated_privileges) ? permissions.elevated_privileges : [];
const pairings = Array.isArray((profile as any).pairings) ? (profile as any).pairings : [];
const docsUrls = Array.isArray(profile.docs_urls) ? profile.docs_urls : [];
const dataClassesTouched = Array.isArray((profile as any).data_classes_touched) ? (profile as any).data_classes_touched : [];
const sandboxing = ((profile as any).sandboxing ?? {}) as any;
const concurrencyModel = ((profile as any).concurrency_model ?? {}) as any;
return (
<Layout title={`${profile.name} — Safety Profile — SMADP`} description={profile.tagline ?? ''}>
  <!-- Header -->
  <section class="container-page mt-8">
    <a href="/agents" class="font-mono text-xs text-ink-400 hover:text-brand-300">← all agents</a>

    <div class="mt-4 flex flex-wrap items-start justify-between gap-6">
      <div class="min-w-0">
        <div class="flex items-center gap-3">
          <h1 class="h1 text-white">{profile.name}</h1>
          <span
            class="inline-flex h-3 w-3 rounded-full"
            style={`background:${vColor}; box-shadow:0 0 12px ${vColor}aa;`}
          ></span>
        </div>
        {profile.tagline && <p class="lead mt-3 max-w-2xl">{profile.tagline}</p>}
        <div class="mt-4 flex flex-wrap items-center gap-2 text-xs">
          <span class="pill">{categoryName(profile.category)}</span>
          <span class="pill">{profile.source_type}</span>
          <span class="pill">vendor: <span class="text-brand-300 ml-1">{vendor.handle}</span></span>
          <span class="pill">verification: {verification.status}</span>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        {profile.homepage && <a class="btn-ghost" href={profile.homepage}>Homepage</a>}
        {profile.repo_url && <a class="btn-ghost" href={profile.repo_url}>Source</a>}
      </div>
    </div>
  </section>

  {pairings && pairings.length > 0 && (
    <section class="container-page mt-8">
      <h2 class="h3 text-white">Commonly paired with</h2>
      <div class="mt-3 flex flex-wrap gap-2">
        {pairings.map((p) => (
          <a
            href={`/agents/${p}`}
            class="inline-flex items-center gap-1 rounded-md bg-brand-600/10 px-2 py-1 text-xs text-brand-200 ring-1 ring-inset ring-brand-500/30 hover:bg-brand-600/20 hover:text-white"
          >
            <span class="font-mono">{p}</span>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Body -->
  <section class="container-page mt-12 grid gap-8 lg:grid-cols-12">
    <!-- Left: profile detail -->
    <div class="space-y-8 lg:col-span-8">
      <!-- Capabilities -->
      <div class="card">
        <h2 class="h3 text-white">Capabilities</h2>
        <p class="mt-1 text-sm text-ink-400">
          What this agent is documented to do at runtime.
        </p>
        <dl class="mt-5 grid gap-3 sm:grid-cols-2">
          {capRows.map((r) => (
            <div class="flex items-center justify-between rounded-lg border border-white/5 bg-ink-900/40 px-3 py-2">
              <dt class="font-mono text-[11px] uppercase tracking-wider text-ink-400">{r.label}</dt>
              <dd class="text-sm">
                {typeof r.value === 'boolean' ? (
                  r.value ? (
                    <span class="text-emerald-400">yes</span>
                  ) : (
                    <span class="text-ink-500">no</span>
                  )
                ) : r.value === undefined || r.value === null ? (
                  <span class="text-ink-500">—</span>
                ) : (
                  <span class="text-ink-100 font-mono text-xs">{String(r.value)}</span>
                )}
              </dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- IO surfaces -->
      <div class="card">
        <h2 class="h3 text-white">IO surfaces</h2>
        <div class="mt-4 grid gap-3 sm:grid-cols-2 text-sm">
          <div>
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Stdin/stdout</div>
            <div class="mt-1">{ioSurfaces.stdin_stdout ? 'yes' : 'no'}</div>
          </div>
          <div>
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Clipboard</div>
            <div class="mt-1">{ioSurfaces.clipboard ? 'yes' : 'no'}</div>
          </div>
          <div>
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Screen capture</div>
            <div class="mt-1">{ioSurfaces.screen_capture ? 'yes' : 'no'}</div>
          </div>
          <div>
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Audio</div>
            <div class="mt-1">{ioSurfaces.audio ? 'yes' : 'no'}</div>
          </div>
        </div>

        {ioFiles && ioFiles.length > 0 && (
          <div class="mt-5">
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-400">File surfaces</div>
            <ul class="mt-2 flex flex-wrap gap-2">
              {ioFiles.map((f) => (
                <li class="pill font-mono normal-case tracking-normal text-ink-200">{f}</li>
              ))}
            </ul>
          </div>
        )}

        {ioApis && ioApis.length > 0 && (
          <div class="mt-5">
            <div class="font-mono text-[11px] uppercase tracking-wider text-ink-400">External APIs called</div>
            <ul class="mt-2 flex flex-wrap gap-2">
              {ioApis.map((a) => (
                <li class="pill font-mono normal-case tracking-normal text-cyber-400">{a}</li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- Permissions -->
      <div class="card">
        <h2 class="h3 text-white">Permissions requested</h2>
        <div class="mt-4 grid gap-4 sm:grid-cols-3 text-sm">
          {[
            { label: 'OAuth scopes', items: oauthScopes },
            { label: 'Secrets handled', items: secretsHandled },
            { label: 'Elevated privileges', items: elevatedPrivs },
          ].map((g) => (
            <div>
              <div class="font-mono text-[11px] uppercase tracking-wider text-ink-400">{g.label}</div>
              {g.items && g.items.length > 0 ? (
                <ul class="mt-2 space-y-1">
                  {g.items.map((it) => (
                    <li class="font-mono text-xs text-ink-200">{it}</li>
                  ))}
                </ul>
              ) : (
                <div class="mt-2 text-xs text-ink-500">none documented</div>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- Data classes touched -->
      {dataClassesTouched.length > 0 && (
        <div class="card">
          <h2 class="h3 text-white">Data classes touched</h2>
          <ul class="mt-4 flex flex-wrap gap-2">
            {dataClassesTouched.map((c) => (
              <li class="pill normal-case tracking-normal" style="color:#F59E0B; border-color:#F59E0B55;">{c}</li>
            ))}
          </ul>
        </div>
      )}

      <!-- Sandboxing & concurrency -->
      <div class="grid gap-4 md:grid-cols-2">
        <div class="card">
          <h2 class="h3 text-white">Sandboxing</h2>
          <dl class="mt-4 space-y-2 text-sm">
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Self isolation</dt>
              <dd class="mt-1 text-ink-100">{sandboxing.self_isolation ?? '—'}</dd>
            </div>
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Subagent model</dt>
              <dd class="mt-1 text-ink-100">{sandboxing.subagent_model ?? '—'}</dd>
            </div>
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Tool-use pattern</dt>
              <dd class="mt-1 text-ink-100">{sandboxing.tool_use_pattern ?? '—'}</dd>
            </div>
          </dl>
        </div>

        <div class="card">
          <h2 class="h3 text-white">Concurrency</h2>
          <dl class="mt-4 space-y-2 text-sm">
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Session scope</dt>
              <dd class="mt-1 text-ink-100">{concurrencyModel.session_scope ?? '—'}</dd>
            </div>
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Shared state w/ instances</dt>
              <dd class="mt-1 text-ink-100">{concurrencyModel.shared_state_with_other_instances ?? '—'}</dd>
            </div>
            <div>
              <dt class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Multiple instances</dt>
              <dd class="mt-1 text-ink-100">
                {concurrencyModel.supports_multiple_instances === undefined
                  ? '—'
                  : concurrencyModel.supports_multiple_instances
                    ? 'supported'
                    : 'unsupported'}
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Raw JSON -->
      <details class="rounded-xl border border-white/10 bg-ink-900/40">
        <summary class="cursor-pointer px-5 py-3 font-mono text-xs text-ink-300 hover:text-white">
          show raw profile JSON
        </summary>
        <div class="border-t border-white/10 p-2">
          <CodeBlock code={profile} title={`${profile.slug}.json`} />
        </div>
      </details>
    </div>

    <!-- Right rail: verdicts and meta -->
    <aside class="space-y-6 lg:col-span-4">
      <div class="card">
        <h3 class="heading-eyebrow">Provenance</h3>
        <dl class="mt-3 space-y-2 text-xs">
          <div class="flex justify-between gap-3">
            <dt class="text-ink-400">Schema</dt>
            <dd class="font-mono text-ink-200">{profile.schema_version}</dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-ink-400">First seen</dt>
            <dd class="font-mono text-ink-200">{profile.first_seen_at.slice(0, 10)}</dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-ink-400">Last refreshed</dt>
            <dd class="font-mono text-ink-200">{profile.last_refreshed_at.slice(0, 10)}</dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-ink-400">Verified by</dt>
            <dd class="font-mono text-ink-200">{verification.verified_by ?? '—'}</dd>
          </div>
          <div class="flex justify-between gap-3">
            <dt class="text-ink-400">Method</dt>
            <dd class="font-mono text-ink-200">{verification.method}</dd>
          </div>
        </dl>
      </div>

      <div class="card">
        <h3 class="heading-eyebrow">Verdicts involving this agent</h3>
        {verdicts.length === 0 ? (
          <p class="mt-3 text-xs text-ink-500">No verdicts yet for this agent.</p>
        ) : (
          <ul class="mt-4 space-y-3">
            {verdicts.map((v) => {
              const other = v.pair[0] === profile.slug ? v.pair[1] : v.pair[0];
              return (
                <li>
                  <a
                    href={`/verdicts/${v.verdict_id}`}
                    class="block rounded-lg border border-white/5 bg-ink-900/40 p-3 transition hover:border-brand-500/40 hover:bg-white/5"
                  >
                    <div class="flex items-center justify-between gap-2">
                      <span class="text-sm font-medium text-white truncate">× {other}</span>
                      <span
                        class="font-mono text-xs"
                        style={`color:${
                          v.composite_score < 0.3
                            ? '#22C55E'
                            : v.composite_score < 0.6
                              ? '#F59E0B'
                              : '#EF4444'
                        };`}
                      >
                        {v.composite_score.toFixed(2)}
                      </span>
                    </div>
                    <p class="mt-1 line-clamp-2 text-xs text-ink-400">{v.headline}</p>
                    <div class="mt-2">
                      <EvidenceLevelBadge level={v.evidence_level} />
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        )}
      </div>

      {profile.docs_urls && profile.docs_urls.length > 0 && (
        <div class="card">
          <h3 class="heading-eyebrow">Documentation</h3>
          <ul class="mt-3 space-y-2 text-sm">
            {profile.docs_urls.map((u) => (
              <li><a class="link-quiet" href={u}>{u}</a></li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </section>
</Layout>
);
})()}
