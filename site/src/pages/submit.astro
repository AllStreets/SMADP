---
import Layout from '../layouts/Layout.astro';

const apiUrl = import.meta.env.PUBLIC_SMADP_API_URL || 'http://localhost:8000';
---

<Layout title="Submit an agent — SMADP">
  <section class="container-page mt-10">
    <span class="heading-eyebrow">Contribute</span>
    <h1 class="h1 mt-3 text-white">Submit an agent</h1>
    <p class="lead mt-4 max-w-2xl">
      Add an agent to the catalog or queue a multi-agent compatibility evaluation.
      Submissions land in <code class="font-mono text-brand-300">_unverified/</code>
      first; an admin promotes once citations validate.
    </p>
  </section>

  <section class="container-page mt-10 grid gap-6 lg:grid-cols-2">
    <!-- Single agent -->
    <form
      class="card"
      data-form="single"
      action={`${apiUrl}/api/agents`}
      method="post"
    >
      <div class="flex items-center gap-3">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-brand-600/15 text-brand-300">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 5v14M5 12h14"/>
          </svg>
        </span>
        <h2 class="h3 text-white">Submit one agent</h2>
      </div>
      <p class="mt-2 text-sm text-ink-400">
        Profile is auto-extracted by the Profiler from the source URL and flagged
        <span class="font-mono">unverified</span> until reviewed.
      </p>

      <label class="mt-6 block">
        <span class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Source URL</span>
        <input
          required
          type="url"
          name="source_url"
          placeholder="https://github.com/your-org/your-agent"
          class="mt-1 block w-full rounded-lg border border-white/10 bg-ink-900/80 px-3 py-2 text-sm text-ink-100 placeholder:text-ink-500 focus:border-brand-500/60"
        />
      </label>

      <label class="mt-4 block">
        <span class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Suggested category</span>
        <input
          name="category"
          placeholder="coding, web-dev, search-rag, …"
          class="mt-1 block w-full rounded-lg border border-white/10 bg-ink-900/80 px-3 py-2 text-sm text-ink-100 placeholder:text-ink-500 focus:border-brand-500/60"
        />
      </label>

      <label class="mt-4 block">
        <span class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Notes</span>
        <textarea
          name="notes"
          rows="3"
          placeholder="Anything reviewers should know — sandbox model, OAuth scopes, license."
          class="mt-1 block w-full rounded-lg border border-white/10 bg-ink-900/80 px-3 py-2 text-sm text-ink-100 placeholder:text-ink-500 focus:border-brand-500/60"
        ></textarea>
      </label>

      <button class="btn-primary mt-6 w-full" type="submit">
        Submit agent
      </button>
      <p class="mt-3 text-[11px] text-ink-500">
        POSTs to <span class="font-mono">{apiUrl}/api/agents</span>
      </p>
    </form>

    <!-- Compatibility set -->
    <form
      class="card"
      data-form="set"
      action={`${apiUrl}/api/evaluate`}
      method="post"
    >
      <div class="flex items-center gap-3">
        <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-cyber-500/15 text-cyber-400">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" rx="1.5"/>
            <rect x="14" y="3" width="7" height="7" rx="1.5"/>
            <rect x="3" y="14" width="7" height="7" rx="1.5"/>
            <rect x="14" y="14" width="7" height="7" rx="1.5"/>
          </svg>
        </span>
        <h2 class="h3 text-white">Evaluate a set of agents</h2>
      </div>
      <p class="mt-2 text-sm text-ink-400">
        Paste a list of agent slugs or source URLs. SMADP returns the full pairwise
        verdict bundle for the set.
      </p>

      <label class="mt-6 block">
        <span class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Agents (one per line)</span>
        <textarea
          name="agents"
          rows="8"
          placeholder={"claude-code\ncursor\nhttps://github.com/some-org/some-agent"}
          class="mt-1 block w-full rounded-lg border border-white/10 bg-ink-900/80 px-3 py-2 font-mono text-xs text-ink-100 placeholder:text-ink-500 focus:border-brand-500/60"
          required
        ></textarea>
      </label>

      <button class="btn-cyber mt-6 w-full" type="submit">
        Run pairwise evaluation
      </button>
      <p class="mt-3 text-[11px] text-ink-500">
        POSTs to <span class="font-mono">{apiUrl}/api/evaluate</span>
      </p>
    </form>
  </section>

  <section class="container-page mt-12">
    <div class="card">
      <h2 class="h3 text-white">Or open a pull request</h2>
      <p class="mt-3 text-sm text-ink-300">
        Hand-author the profile under
        <code class="font-mono text-brand-300">catalog/profiles/&lt;your-agent&gt;.json</code>
        matching <code class="font-mono">_meta/schema/1.0/profile.schema.json</code>,
        add evidence references for every populated field, and open a PR using the
        <span class="text-brand-300">Agent submission</span> template. CI runs
        <code class="font-mono">smadp lint</code>; an admin reviews and merges.
      </p>
      <a
        class="btn-ghost mt-5"
        href="https://github.com/AllStreets/SMADP/blob/main/catalog/_meta/schema/1.0/profile.schema.json"
      >
        View profile schema →
      </a>
    </div>
  </section>
</Layout>

<script>
  // Progressive enhancement: intercept submit, post JSON, show inline status.
  document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const status = document.createElement('p');
      status.className = 'mt-3 text-xs font-mono';
      form.appendChild(status);

      const kind = form.dataset.form;
      let body: Record<string, unknown>;
      if (kind === 'single') {
        body = {
          source_url: fd.get('source_url'),
          category: fd.get('category') || null,
          notes: fd.get('notes') || null,
        };
      } else {
        body = {
          agents: String(fd.get('agents') || '')
            .split('\n')
            .map((s) => s.trim())
            .filter(Boolean),
        };
      }

      status.textContent = 'submitting…';
      status.classList.add('text-ink-400');
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body),
        });
        if (res.ok) {
          status.textContent = 'submitted ✓ — your request is queued.';
          status.className = 'mt-3 text-xs font-mono text-emerald-400';
          form.reset();
        } else {
          const txt = await res.text();
          status.textContent = `error ${res.status}: ${txt.slice(0, 200)}`;
          status.className = 'mt-3 text-xs font-mono text-red-400';
        }
      } catch (err) {
        status.textContent = `network error: ${(err as Error).message}`;
        status.className = 'mt-3 text-xs font-mono text-red-400';
      }
    });
  });
</script>
