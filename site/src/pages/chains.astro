---
import Layout from '../layouts/Layout.astro';
import { getProfileSummariesForClient } from '../data/catalog';
import { getChains } from '../lib/chains';

const profiles = getProfileSummariesForClient();
const profilesJson = JSON.stringify(profiles);
const chainCount = getChains().length;

const ROLES = [
  'planner', 'executor', 'critic', 'retriever', 'reasoner',
  'writer', 'router', 'tool', 'judge', 'memory',
];
const TOPOLOGIES = ['linear', 'star', 'loop', 'tree', 'dag'];
const CHANNELS = ['prompt', 'tool-call', 'shared-memory', 'filesystem', 'message-bus'];
---

<Layout title="Build a chain — SMADP">
  <section class="container-page mt-10">
    <span class="heading-eyebrow">Catalog · Builder</span>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="h1 text-white">Build a chain</h1>
        <p class="lead mt-4 max-w-2xl">
          Compose 3+ agents, draw the edges, pick a topology — and watch the
          five sub-verdicts recompute in real time. Drafts save to your
          workspace; submissions ride through the operator gate before they
          land in the public library.
        </p>
      </div>
      <a href="/chains/library" class="btn-ghost gap-2">
        <span>Browse the library</span>
        <span class="font-mono text-xs text-ink-400">{chainCount} chains →</span>
      </a>
    </div>
  </section>

  <section class="container-page mt-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
    <!-- LEFT: builder -->
    <div class="space-y-6">

      <!-- Author (required) -->
      <div class="card space-y-2">
        <div class="flex items-baseline justify-between gap-3">
          <label class="label" for="cb-author">Your name or username</label>
          <span class="font-mono text-[10px] uppercase tracking-wider text-amber-300/90">required</span>
        </div>
        <input id="cb-author" type="text" class="input mt-1 w-full" placeholder="e.g. connor.evans or @connorevans" autocomplete="username"/>
        <p class="text-xs text-ink-400">
          Every chain built, tested, or submitted here is signed with this name so the catalog stays attributable.
          Stored only in your browser unless you submit.
        </p>
      </div>

      <!-- Header -->
      <div class="card space-y-4">
        <div class="grid gap-3 sm:grid-cols-[minmax(0,1fr)_180px]">
          <div>
            <label class="label" for="cb-name">Chain name</label>
            <input id="cb-name" type="text" class="input mt-1 w-full" placeholder="My research pipeline"/>
          </div>
          <div>
            <label class="label" for="cb-topology">Topology</label>
            <select id="cb-topology" class="input mt-1 w-full">
              {TOPOLOGIES.map((t) => <option value={t}>{t}</option>)}
            </select>
          </div>
        </div>
        <div>
          <label class="label" for="cb-tagline">Tagline (optional)</label>
          <input id="cb-tagline" type="text" class="input mt-1 w-full" placeholder="One-line description"/>
        </div>
      </div>

      <!-- Participants -->
      <div class="card">
        <div class="flex items-center justify-between">
          <h2 class="h3 text-white">Participants</h2>
          <button id="cb-add-part" class="btn-ghost">+ Add participant</button>
        </div>
        <p class="mt-1 text-sm text-ink-300">Pick 3+ agents from the catalog.</p>
        <ul id="cb-participants" class="mt-4 space-y-2"></ul>
      </div>

      <!-- Edges -->
      <div class="card">
        <div class="flex items-center justify-between">
          <h2 class="h3 text-white">Edges</h2>
          <button id="cb-add-edge" class="btn-ghost">+ Add edge</button>
        </div>
        <p class="mt-1 text-sm text-ink-300">Define how data flows between participants.</p>
        <ul id="cb-edges" class="mt-4 space-y-2"></ul>
      </div>

      <!-- Drafts -->
      <div class="card">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="h3 text-white">My drafts</h2>
          <div class="flex flex-wrap gap-2">
            <button id="cb-save" class="btn-ghost">Save draft</button>
            <button id="cb-export" class="btn-ghost">Export JSON</button>
            <button id="cb-publish" class="btn-primary">Submit to catalog</button>
          </div>
        </div>
        <p id="cb-publish-status" class="mt-3 hidden rounded-md px-3 py-2 text-xs"></p>
        <ul id="cb-drafts" class="mt-4 grid gap-2"></ul>
      </div>

    </div>

    <!-- RIGHT: live analysis -->
    <aside class="space-y-4">
      <div class="card sticky top-20">
        <div class="flex items-baseline justify-between">
          <h2 class="h3 text-white">Live analysis</h2>
          <span class="font-mono text-[10px] uppercase tracking-wider text-ink-400">unverified · heuristic</span>
        </div>

        <div class="mt-4 flex items-center gap-3">
          <div class="flex-1">
            <div class="font-mono text-[10px] uppercase tracking-wider text-ink-400">Composite</div>
            <div id="cb-composite" class="font-display text-3xl font-bold text-white">0.00</div>
          </div>
          <div class="h-10 w-10 rounded-full" id="cb-composite-orb" style="background:#22C55E;"></div>
        </div>

        <ul id="cb-subverdicts" class="mt-5 space-y-3"></ul>

        <p id="cb-missing" class="mt-4 hidden rounded-md bg-amber-500/10 px-3 py-2 text-xs text-amber-200"></p>
      </div>

      <div class="card">
        <h3 class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Library</h3>
        <p class="mt-2 text-sm text-ink-200">
          Every chain that's been built and accepted on the site lives in the
          library. Browse to see what compositions other authors have already
          analyzed.
        </p>
        <a href="/chains/library" class="mt-3 inline-flex items-center gap-1 text-xs text-brand-300 hover:text-brand-200">
          Open the library →
        </a>
      </div>
    </aside>

  </section>

  <!-- Embed catalog summary for client-side analysis -->
  <script type="application/json" id="cb-profiles" set:html={profilesJson}></script>
</Layout>

<style>
.label {
  display: block;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: rgb(161 161 170);
}
.input {
  border-radius: 0.375rem;
  border: 1px solid rgba(255, 255, 255, 0.10);
  background: rgba(11, 7, 18, 0.60);
  padding: 0.5rem 0.75rem;
  font-size: 0.875rem;
  color: #FAFAFA;
  height: 2.5rem;
}
.input:focus {
  border-color: rgba(167, 139, 250, 0.60);
  outline: none;
  box-shadow: 0 0 0 1px rgba(167, 139, 250, 0.40);
}
.input.error {
  border-color: rgba(244, 63, 94, 0.60);
  box-shadow: 0 0 0 1px rgba(244, 63, 94, 0.40);
}
.cb-row {
  display: grid;
  gap: 0.5rem;
  border-radius: 0.5rem;
  border: 1px solid rgba(255, 255, 255, 0.05);
  background: rgba(11, 7, 18, 0.40);
  padding: 0.75rem;
}
.cb-row.compact { grid-template-columns: minmax(0,1fr) 140px 28px; }
.cb-row.edge { grid-template-columns: minmax(0,1fr) minmax(0,1fr) 140px minmax(0,1fr) 28px; }
.x-btn {
  display: inline-flex;
  height: 1.75rem;
  width: 1.75rem;
  align-items: center;
  justify-content: center;
  border-radius: 0.375rem;
  border: 1px solid rgba(255, 255, 255, 0.10);
  background: rgba(255, 255, 255, 0.05);
  color: rgb(161 161 170);
  cursor: pointer;
}
.x-btn:hover {
  background: rgba(244, 63, 94, 0.15);
  color: rgb(254, 205, 211);
}
</style>

<script>
  import { analyze, type ProfileSummary, type DraftChain, type ChainTopology, type ChainChannel } from '../lib/chain-analyze';
  import { getWorkspaceId } from '../lib/session';
  import { apiFetch, ApiError } from '../lib/api';

  const RISKS = [
    { id: 'A_prompt_injection', short: 'A', label: 'Prompt injection' },
    { id: 'B_data_leakage', short: 'B', label: 'Data leakage' },
    { id: 'C_capability_conflict', short: 'C', label: 'Capability conflict' },
    { id: 'D_cascading_error', short: 'D', label: 'Cascading error' },
    { id: 'E_compliance', short: 'E', label: 'Compliance' },
  ] as const;

  const SEV_COLOR: Record<string, string> = {
    none: '#22C55E', low: '#84CC16', medium: '#F59E0B', high: '#EF4444', critical: '#7F1D1D',
  };
  const compositeColor = (s: number) => {
    if (s < 0.3) return '#22C55E';
    if (s < 0.6) return '#F59E0B';
    return '#EF4444';
  };

  // Load catalog summaries embedded at build time.
  const profileNode = document.getElementById('cb-profiles');
  const profileList: ProfileSummary[] = profileNode ? JSON.parse(profileNode.textContent || '[]') : [];
  const profileMap: Record<string, ProfileSummary> = Object.fromEntries(profileList.map((p) => [p.slug, p]));
  const profileOptions = profileList
    .slice()
    .sort((a, b) => a.name.localeCompare(b.name))
    .map((p) => `<option value="${p.slug}">${p.name}</option>`).join('');

  const ROLES = ['planner','executor','critic','retriever','reasoner','writer','router','tool','judge','memory'];
  const CHANNELS = ['prompt','tool-call','shared-memory','filesystem','message-bus'];

  // ---------- State ----------
  type Participant = { slug: string; role: string; notes?: string };
  type Edge = { from: string; to: string; channel: ChainChannel; carries: string[] };
  type State = { author: string; name: string; tagline: string; topology: ChainTopology; participants: Participant[]; edges: Edge[] };

  const AUTHOR_KEY = 'smadp.chain-author';
  const initialAuthor = (() => {
    try { return localStorage.getItem(AUTHOR_KEY) ?? ''; } catch { return ''; }
  })();

  let state: State = {
    author: initialAuthor,
    name: '',
    tagline: '',
    topology: 'linear',
    participants: [],
    edges: [],
  };

  // ---------- DOM helpers ----------
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const authorInput = $<HTMLInputElement>('#cb-author');
  authorInput.value = state.author;
  const partsList = $('#cb-participants');
  const edgesList = $('#cb-edges');
  const subList = $('#cb-subverdicts');
  const missingEl = $<HTMLParagraphElement>('#cb-missing');

  function persistAuthor(value: string) {
    state.author = value;
    try { localStorage.setItem(AUTHOR_KEY, value); } catch {}
  }
  function authorOk(): boolean {
    return state.author.trim().length >= 2;
  }

  function renderParticipants() {
    partsList.innerHTML = state.participants.length === 0
      ? `<li class="text-xs text-ink-500">No participants yet — click "+ Add participant".</li>`
      : '';
    state.participants.forEach((p, i) => {
      const li = document.createElement('li');
      li.className = 'cb-row compact';
      li.innerHTML = `
        <select class="input cb-pslug">
          <option value="">— pick agent —</option>
          ${profileOptions}
        </select>
        <select class="input cb-prole">
          ${ROLES.map(r => `<option value="${r}">${r}</option>`).join('')}
        </select>
        <button class="x-btn" title="Remove" data-i="${i}">×</button>
      `;
      const slugSel = li.querySelector<HTMLSelectElement>('.cb-pslug')!;
      const roleSel = li.querySelector<HTMLSelectElement>('.cb-prole')!;
      slugSel.value = p.slug;
      roleSel.value = p.role;
      slugSel.addEventListener('change', () => { state.participants[i]!.slug = slugSel.value; renderEdges(); update(); });
      roleSel.addEventListener('change', () => { state.participants[i]!.role = roleSel.value; update(); });
      li.querySelector<HTMLButtonElement>('.x-btn')!.addEventListener('click', () => {
        const removed = state.participants[i]!.slug;
        state.participants.splice(i, 1);
        state.edges = state.edges.filter(e => e.from !== removed && e.to !== removed);
        renderParticipants();
        renderEdges();
        update();
      });
      partsList.appendChild(li);
    });
  }

  function renderEdges() {
    edgesList.innerHTML = state.edges.length === 0
      ? `<li class="text-xs text-ink-500">No edges yet — click "+ Add edge".</li>`
      : '';
    const slugChoices = state.participants
      .filter(p => p.slug)
      .map(p => `<option value="${p.slug}">${profileMap[p.slug]?.name ?? p.slug}</option>`)
      .join('');
    state.edges.forEach((e, i) => {
      const li = document.createElement('li');
      li.className = 'cb-row edge';
      li.innerHTML = `
        <select class="input cb-from"><option value="">— from —</option>${slugChoices}</select>
        <select class="input cb-to"><option value="">— to —</option>${slugChoices}</select>
        <select class="input cb-channel">
          ${CHANNELS.map(c => `<option value="${c}">${c}</option>`).join('')}
        </select>
        <input class="input cb-carries" type="text" placeholder="raw HTML, summary, ..."/>
        <button class="x-btn" title="Remove" data-i="${i}">×</button>
      `;
      const fromSel = li.querySelector<HTMLSelectElement>('.cb-from')!;
      const toSel = li.querySelector<HTMLSelectElement>('.cb-to')!;
      const chSel = li.querySelector<HTMLSelectElement>('.cb-channel')!;
      const carInput = li.querySelector<HTMLInputElement>('.cb-carries')!;
      fromSel.value = e.from; toSel.value = e.to; chSel.value = e.channel; carInput.value = e.carries.join(', ');
      fromSel.addEventListener('change', () => { state.edges[i]!.from = fromSel.value; update(); });
      toSel.addEventListener('change', () => { state.edges[i]!.to = toSel.value; update(); });
      chSel.addEventListener('change', () => { state.edges[i]!.channel = chSel.value as ChainChannel; update(); });
      carInput.addEventListener('input', () => {
        state.edges[i]!.carries = carInput.value.split(',').map(s => s.trim()).filter(Boolean);
        update();
      });
      li.querySelector<HTMLButtonElement>('.x-btn')!.addEventListener('click', () => {
        state.edges.splice(i, 1); renderEdges(); update();
      });
      edgesList.appendChild(li);
    });
  }

  function renderAnalysis(result: ReturnType<typeof analyze>) {
    $('#cb-composite').textContent = result.composite.toFixed(2);
    ($('#cb-composite-orb') as HTMLElement).style.background = compositeColor(result.composite);
    subList.innerHTML = '';
    for (const r of RISKS) {
      const sv = result.sub_verdicts[r.id];
      const li = document.createElement('li');
      li.className = 'rounded-md border border-white/5 bg-ink-950/40 p-3';
      li.innerHTML = `
        <div class="flex items-center justify-between">
          <span class="font-mono text-[11px]">
            <span class="font-bold text-brand-300">${r.short}</span>
            <span class="ml-2 text-ink-200">${r.label}</span>
          </span>
          <span class="inline-flex items-center gap-1.5 font-mono text-[10px] text-ink-300">
            <span class="inline-block h-2.5 w-2.5 rounded-sm" style="background:${SEV_COLOR[sv.severity]}"></span>
            ${sv.severity}
          </span>
        </div>
        <p class="mt-2 text-[11px] leading-relaxed text-ink-400">${sv.rationale}</p>
      `;
      subList.appendChild(li);
    }
    if (result.missing.length > 0) {
      missingEl.textContent = `Unknown agent slug${result.missing.length > 1 ? 's' : ''}: ${result.missing.join(', ')}`;
      missingEl.classList.remove('hidden');
    } else {
      missingEl.classList.add('hidden');
    }
  }

  function update() {
    const draft: DraftChain = {
      name: state.name,
      topology: state.topology,
      participants: state.participants.filter(p => p.slug),
      edges: state.edges.filter(e => e.from && e.to),
    };
    const result = analyze(draft, profileMap);
    renderAnalysis(result);
  }

  // ---------- Author input ----------
  authorInput.addEventListener('input', () => {
    persistAuthor(authorInput.value);
    if (authorOk()) authorInput.classList.remove('error');
  });

  // ---------- Header inputs ----------
  $('#cb-name').addEventListener('input', () => { state.name = ($('#cb-name') as HTMLInputElement).value; });
  $('#cb-tagline').addEventListener('input', () => { state.tagline = ($('#cb-tagline') as HTMLInputElement).value; });
  $('#cb-topology').addEventListener('change', () => {
    state.topology = ($('#cb-topology') as HTMLSelectElement).value as ChainTopology;
    update();
  });

  // ---------- Add buttons ----------
  $('#cb-add-part').addEventListener('click', () => {
    if (!authorOk()) { focusAuthor('add a participant'); return; }
    state.participants.push({ slug: '', role: 'executor' });
    renderParticipants(); renderEdges(); update();
  });
  $('#cb-add-edge').addEventListener('click', () => {
    if (!authorOk()) { focusAuthor('add an edge'); return; }
    state.edges.push({ from: '', to: '', channel: 'prompt', carries: [] });
    renderEdges(); update();
  });

  function focusAuthor(action: string) {
    authorInput.classList.add('error');
    authorInput.focus();
    showStatus(`Enter your name or username before you ${action}.`, 'err');
  }

  // ---------- Drafts (localStorage, scoped per workspace) ----------
  const ws = getWorkspaceId();
  const draftsKey = `smadp.chains.drafts.${ws ?? 'anon'}`;
  type SavedDraft = { id: string; saved_at: string } & State;

  function loadDrafts(): SavedDraft[] {
    try { return JSON.parse(localStorage.getItem(draftsKey) ?? '[]'); } catch { return []; }
  }
  function writeDrafts(d: SavedDraft[]) {
    localStorage.setItem(draftsKey, JSON.stringify(d));
  }
  function uid() {
    return `cd_${Date.now().toString(36)}_${Math.random().toString(36).slice(2, 7)}`;
  }
  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (ch) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[ch]!));
  }
  function renderDrafts() {
    const ul = $('#cb-drafts');
    const drafts = loadDrafts();
    ul.innerHTML = drafts.length === 0
      ? `<li class="text-xs text-ink-500">No saved drafts yet.</li>`
      : '';
    for (const d of drafts) {
      const li = document.createElement('li');
      li.className = 'flex items-center justify-between rounded-md border border-white/5 bg-ink-950/40 px-3 py-2';
      const byline = d.author ? `by ${escapeHtml(d.author)} · ` : '';
      li.innerHTML = `
        <div class="min-w-0">
          <div class="truncate font-mono text-xs text-ink-100">${escapeHtml(d.name || '(untitled)')}</div>
          <div class="font-mono text-[10px] text-ink-500">${byline}${d.participants.length} agents · ${d.topology}</div>
        </div>
        <div class="flex gap-2">
          <button class="btn-ghost" data-load="${d.id}">Load</button>
          <button class="x-btn" data-del="${d.id}" title="Delete">×</button>
        </div>
      `;
      li.querySelector<HTMLButtonElement>('[data-load]')!.addEventListener('click', () => {
        state = { author: d.author || state.author, name: d.name, tagline: d.tagline, topology: d.topology, participants: d.participants, edges: d.edges };
        authorInput.value = state.author;
        ($('#cb-name') as HTMLInputElement).value = state.name;
        ($('#cb-tagline') as HTMLInputElement).value = state.tagline;
        ($('#cb-topology') as HTMLSelectElement).value = state.topology;
        renderParticipants(); renderEdges(); update();
      });
      li.querySelector<HTMLButtonElement>('[data-del]')!.addEventListener('click', () => {
        writeDrafts(loadDrafts().filter(x => x.id !== d.id));
        renderDrafts();
      });
      ul.appendChild(li);
    }
  }

  $('#cb-save').addEventListener('click', () => {
    if (!authorOk()) { focusAuthor('save a draft'); return; }
    if (!state.name.trim()) {
      showStatus('Give your chain a name first.', 'err');
      return;
    }
    const drafts = loadDrafts();
    drafts.unshift({ id: uid(), saved_at: new Date().toISOString(), ...state });
    writeDrafts(drafts.slice(0, 50));
    renderDrafts();
    showStatus('Draft saved locally.', 'ok');
  });

  function buildChainPayload() {
    const filteredParts = state.participants.filter(p => p.slug);
    const filteredEdges = state.edges.filter(e => e.from && e.to);
    const slug = (state.name || 'chain').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const result = analyze(
      { name: state.name, topology: state.topology, participants: filteredParts, edges: filteredEdges },
      profileMap,
    );
    const headline = state.tagline.trim() ||
      `${state.name || 'Untitled chain'}: ${result.sub_verdicts.A_prompt_injection.severity}/` +
      `${result.sub_verdicts.B_data_leakage.severity}/` +
      `${result.sub_verdicts.C_capability_conflict.severity}/` +
      `${result.sub_verdicts.D_cascading_error.severity}/` +
      `${result.sub_verdicts.E_compliance.severity} (composite ${result.composite.toFixed(2)}).`;
    const now = new Date().toISOString();
    return {
      schema_version: '1.0' as const,
      chain_id: `c_${slug || 'draft'}-${Date.now().toString(36)}`,
      name: state.name || 'Untitled chain',
      ...(state.tagline ? { tagline: state.tagline } : {}),
      author: state.author.trim(),
      topology: state.topology,
      participants: filteredParts.map(p => ({ slug: p.slug, role: p.role, ...(p.notes ? { notes: p.notes } : {}) })),
      edges: filteredEdges.map(e => ({ from: e.from, to: e.to, channel: e.channel, carries: e.carries })),
      headline: headline.length > 240 ? headline.slice(0, 237) + '...' : headline,
      sub_verdicts: result.sub_verdicts,
      framework_mappings: {},
      evidence_refs: [],
      first_seen_at: now,
      last_refreshed_at: now,
    };
  }

  $('#cb-export').addEventListener('click', () => {
    if (!authorOk()) { focusAuthor('export'); return; }
    const payload = buildChainPayload();
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `${payload.chain_id}.json`; a.click();
    URL.revokeObjectURL(url);
  });

  const statusEl = $<HTMLParagraphElement>('#cb-publish-status');
  function showStatus(text: string, kind: 'ok' | 'err' | 'info') {
    statusEl.textContent = text;
    statusEl.className = 'mt-3 rounded-md px-3 py-2 text-xs ' + (
      kind === 'ok'
        ? 'bg-emerald-500/10 text-emerald-200'
        : kind === 'err'
          ? 'bg-rose-500/10 text-rose-200'
          : 'bg-white/5 text-ink-300'
    );
    statusEl.classList.remove('hidden');
  }

  $('#cb-publish').addEventListener('click', async () => {
    if (!authorOk()) { focusAuthor('submit'); return; }
    const filteredParts = state.participants.filter(p => p.slug);
    if (filteredParts.length < 3) {
      showStatus('A chain needs at least 3 participants.', 'err');
      return;
    }
    if (!state.name.trim()) {
      showStatus('Give your chain a name first.', 'err');
      return;
    }
    const payload = buildChainPayload();
    showStatus('Submitting...', 'info');
    try {
      const created = await apiFetch<{ chain_id: string }>('/chains', {
        method: 'POST',
        json: payload,
      });
      showStatus(`Submitted as ${created.chain_id} by ${state.author}. It will appear in /chains/library once accepted.`, 'ok');
    } catch (e) {
      const err = e as ApiError;
      showStatus(`Submission failed: ${err.title}${err.detail ? ` — ${err.detail}` : ''}`, 'err');
    }
  });

  // Initial paint.
  renderParticipants();
  renderEdges();
  renderDrafts();
  update();
</script>
</Layout>
