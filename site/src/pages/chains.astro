---
import Layout from '../layouts/Layout.astro';
import Panel from '../components/Panel.astro';
import SeverityBar from '../components/SeverityBar.astro';
import ChainTopologyBadge from '../components/ChainTopologyBadge.astro';
import { getChains, maxSeverity } from '../lib/chains';

const chains = getChains();
---

<Layout title="Multi-Agent Chains — SMADP">
  <section class="container-page mt-10">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="heading-eyebrow">Catalog</span>
        <h1 class="h1 mt-3 text-white">Multi-agent compositions</h1>
        <p class="lead mt-4 max-w-2xl">
          {chains.length} canonical 3+-agent chains with sub-verdict analyses.
        </p>
      </div>
      <a href="/chains/new" class="btn-primary">+ Build a chain</a>
    </div>
  </section>

  <section class="container-page mt-10 grid gap-4">
    {chains.length === 0 && (
      <p class="card p-6 text-ink-300">No chains yet.</p>
    )}
    {chains.map((c) => (
      <Panel title={c.name} icon="link" id={c.chain_id} defaultOpen={false}>
        <Fragment slot="badge">
          <ChainTopologyBadge topology={c.topology} />
        </Fragment>
        <p class="text-sm text-ink-200">{c.headline}</p>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          {c.participants.map((p) => (
            <a
              href={`/agents/${p.slug}`}
              class="inline-flex items-center gap-1 rounded-md bg-white/5 px-2 py-1 text-xs text-ink-200 ring-1 ring-inset ring-white/10 hover:bg-white/10 hover:text-white"
            >
              <span class="font-medium">{p.slug}</span>
              <span class="text-ink-400">·</span>
              <span class="text-ink-400">{p.role}</span>
            </a>
          ))}
        </div>
        <div class="mt-3 flex items-center gap-3">
          <SeverityBar severity={maxSeverity(c)} />
          <a
            class="text-xs text-brand-300 hover:text-brand-200"
            href={`/chains/${c.chain_id}`}
          >
            Open chain →
          </a>
        </div>
      </Panel>
    ))}
  </section>
</Layout>
