---
import Layout from '../layouts/Layout.astro';
import { getProfileSummariesForClient } from '../data/catalog';
import { getChains } from '../lib/chains';

const profiles = getProfileSummariesForClient();
const profilesJson = JSON.stringify(profiles);
const chainCount = getChains().length;
---

<Layout title="Build a chain — SMADP">
  <section class="container-page mt-10">
    <span class="heading-eyebrow">Catalog · Builder</span>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="h1 text-white">Build a chain</h1>
        <p class="lead mt-4 max-w-2xl">
          Three fields. Pick a topology. Watch the five sub-verdicts compute live.
          Submit when you're happy with the analysis.
        </p>
      </div>
      <a href="/chains/library" class="btn-ghost gap-2">
        <span>Browse the library</span>
        <span class="font-mono text-xs text-ink-400">{chainCount} chains →</span>
      </a>
    </div>
  </section>

  <section class="container-page mt-10 grid gap-6 lg:grid-cols-[minmax(0,1fr)_380px]">
    <!-- LEFT: three fields + topology + submit -->
    <div class="space-y-6">

      <!-- 1. Author -->
      <div class="card space-y-2">
        <div class="flex items-baseline justify-between gap-3">
          <label class="label" for="cb-author">1 · Your name or username</label>
          <span class="font-mono text-[10px] uppercase tracking-wider text-amber-300/90">required</span>
        </div>
        <input id="cb-author" type="text" class="input mt-1 w-full" placeholder="e.g. connor.evans or @connorevans" autocomplete="username"/>
      </div>

      <!-- 2. Chain name -->
      <div class="card space-y-2">
        <div class="flex items-baseline justify-between gap-3">
          <label class="label" for="cb-name">2 · Chain name</label>
          <span class="font-mono text-[10px] uppercase tracking-wider text-amber-300/90">required</span>
        </div>
        <input id="cb-name" type="text" class="input mt-1 w-full" placeholder="e.g. Research → Write → Cite"/>
      </div>

      <!-- 3. Agents (search) -->
      <div class="card space-y-3">
        <div class="flex items-baseline justify-between gap-3">
          <label class="label" for="cb-search">3 · Add agents (3+)</label>
          <span class="font-mono text-[10px] uppercase tracking-wider text-amber-300/90">required</span>
        </div>
        <div class="relative">
          <input id="cb-search" type="search" class="input w-full" placeholder={`Search ${profiles.length.toLocaleString()} agents in the catalog by name, slug, or capability`} autocomplete="off"/>
          <ul id="cb-search-results" class="absolute left-0 right-0 top-full z-20 mt-1 hidden max-h-80 overflow-y-auto rounded-lg border border-white/10 bg-ink-950/95 shadow-glow-sm backdrop-blur"></ul>
        </div>
        <p class="text-xs text-ink-400">
          Searches the live SMADP profile catalog. Each result shows the agent's source type and capabilities, the same fields the sub-verdict analysis reads from. Click to add; the participant's role is auto-assigned by topology and order (click the role chip to cycle).
        </p>
        <ul id="cb-participants" class="mt-1 flex flex-wrap gap-2"></ul>
      </div>

      <!-- Topology -->
      <div class="card">
        <div class="label">Topology</div>
        <div id="cb-topology" class="mt-3 inline-flex rounded-lg border border-white/10 bg-ink-950/60 p-1 text-sm" role="tablist">
          <button type="button" data-topo="linear" class="topo-pill topo-pill-active" aria-pressed="true">linear</button>
          <button type="button" data-topo="star" class="topo-pill" aria-pressed="false">star</button>
          <button type="button" data-topo="loop" class="topo-pill" aria-pressed="false">loop</button>
        </div>
        <p class="mt-3 text-xs text-ink-400" id="cb-topology-hint">linear: p₁ → p₂ → … → pₙ. Edges, channels and roles are auto-derived.</p>
      </div>

      <!-- Submit -->
      <div class="card">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-xs text-ink-400">
            Submissions land in <code class="font-mono text-brand-300">catalog/pending/</code> for operator review.
            Drafts are auto-saved in your browser.
          </p>
          <button id="cb-publish" class="btn-primary px-5 py-2.5">Submit to catalog →</button>
        </div>
        <p id="cb-publish-status" class="mt-3 hidden rounded-md px-3 py-2 text-xs"></p>
      </div>

    </div>

    <!-- RIGHT: live analysis -->
    <aside class="space-y-4">
      <div class="card sticky top-20">
        <div class="flex items-baseline justify-between">
          <h2 class="h3 text-white">Live analysis</h2>
          <span class="font-mono text-[10px] uppercase tracking-wider text-ink-400">unverified · heuristic</span>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-3">
          <div class="rounded-xl border border-white/10 bg-ink-950/60 p-3 text-center">
            <div class="font-mono text-[10px] uppercase tracking-wider text-ink-400">Composite</div>
            <div id="cb-composite" class="font-display text-3xl font-extrabold text-white">0.00</div>
            <div class="text-[10px] text-ink-500">lower is safer</div>
          </div>
          <div class="rounded-xl border border-white/10 bg-ink-950/60 p-3 text-center">
            <div class="font-mono text-[10px] uppercase tracking-wider text-ink-400">Max severity</div>
            <div id="cb-maxsev" class="font-display text-2xl font-extrabold uppercase leading-tight text-emerald-400">none</div>
            <div class="text-[10px] text-ink-500">across A–E</div>
          </div>
        </div>

        <ul id="cb-subverdicts" class="mt-5 space-y-3"></ul>

        <p id="cb-missing" class="mt-4 hidden rounded-md bg-amber-500/10 px-3 py-2 text-xs text-amber-200"></p>
      </div>

      <div class="card">
        <h3 class="font-mono text-[11px] uppercase tracking-wider text-ink-400">Library</h3>
        <p class="mt-2 text-sm text-ink-200">
          Every chain that's been authored on the site lives in the library.
          Browse to see how others modeled their compositions.
        </p>
        <a href="/chains/library" class="mt-3 inline-flex items-center gap-1 text-xs text-brand-300 hover:text-brand-200">
          Open the library →
        </a>
      </div>
    </aside>

  </section>

  <script type="application/json" id="cb-profiles" set:html={profilesJson}></script>
</Layout>

<style>
.label {
  display: block;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: rgb(196 196 215);
}
.input {
  border-radius: 0.5rem;
  border: 1px solid rgba(255, 255, 255, 0.12);
  background: rgba(11, 7, 18, 0.70);
  padding: 0.55rem 0.85rem;
  font-size: 0.9rem;
  color: #FAFAFA;
  height: 2.65rem;
  transition: border-color 120ms, box-shadow 120ms;
}
.input:focus {
  border-color: rgba(167, 139, 250, 0.65);
  outline: none;
  box-shadow: 0 0 0 2px rgba(167, 139, 250, 0.30);
}
.input.error {
  border-color: rgba(244, 63, 94, 0.65);
  box-shadow: 0 0 0 2px rgba(244, 63, 94, 0.30);
}
.topo-pill {
  padding: 0.4rem 1rem;
  border-radius: 0.4rem;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.78rem;
  text-transform: lowercase;
  color: rgb(161 161 170);
  transition: all 120ms;
  cursor: pointer;
}
.topo-pill:hover { color: white; background: rgba(255,255,255,0.04); }
.topo-pill-active {
  color: white;
  background: rgba(124, 58, 237, 0.18);
  box-shadow: inset 0 0 0 1px rgba(167, 139, 250, 0.40);
}
.search-result {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 0.5rem;
  padding: 0.5rem 0.75rem;
  cursor: pointer;
  border-bottom: 1px solid rgba(255, 255, 255, 0.04);
}
.search-result:hover, .search-result[aria-selected="true"] {
  background: rgba(167, 139, 250, 0.10);
}
.participant-chip {
  display: inline-flex;
  align-items: center;
  gap: 0.4rem;
  padding: 0.35rem 0.55rem 0.35rem 0.75rem;
  border-radius: 0.5rem;
  background: rgba(11, 7, 18, 0.50);
  border: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 0.78rem;
}
.role-pill {
  padding: 0.15rem 0.5rem;
  border-radius: 0.3rem;
  background: rgba(124, 58, 237, 0.15);
  color: rgb(196, 181, 253);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 0.7rem;
  cursor: pointer;
  transition: background 100ms;
}
.role-pill:hover { background: rgba(124, 58, 237, 0.25); }
.x-btn {
  display: inline-flex;
  height: 1.5rem;
  width: 1.5rem;
  align-items: center;
  justify-content: center;
  border-radius: 0.3rem;
  border: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.04);
  color: rgb(161 161 170);
  cursor: pointer;
}
.x-btn:hover { background: rgba(244, 63, 94, 0.18); color: rgb(254, 205, 211); }
</style>

<script>
  import { analyze, type ProfileSummary, type DraftChain, type ChainTopology, type ChainChannel } from '../lib/chain-analyze';
  import { apiFetch, ApiError } from '../lib/api';

  type Role = 'planner'|'executor'|'critic'|'retriever'|'reasoner'|'writer'|'router'|'tool'|'judge'|'memory';
  const ROLES: Role[] = ['planner','executor','critic','retriever','reasoner','writer','router','tool','judge','memory'];

  const RISKS = [
    { id: 'A_prompt_injection', short: 'A', label: 'Prompt injection' },
    { id: 'B_data_leakage', short: 'B', label: 'Data leakage' },
    { id: 'C_capability_conflict', short: 'C', label: 'Capability conflict' },
    { id: 'D_cascading_error', short: 'D', label: 'Cascading error' },
    { id: 'E_compliance', short: 'E', label: 'Compliance' },
  ] as const;

  const SEV_COLOR: Record<string, string> = {
    none: '#22C55E', low: '#84CC16', medium: '#F59E0B', high: '#EF4444', critical: '#7F1D1D',
  };
  const compositeColor = (s: number) => {
    if (s < 0.3) return '#22C55E';
    if (s < 0.6) return '#F59E0B';
    return '#EF4444';
  };
  const maxSeverity = (svs: Record<string, { severity: string }>): string => {
    const order = ['none','low','medium','high','critical'];
    let i = 0;
    for (const sv of Object.values(svs)) {
      const r = order.indexOf(sv.severity);
      if (r > i) i = r;
    }
    return order[i]!;
  };

  // ----- Catalog -----
  const profileNode = document.getElementById('cb-profiles');
  const profileList: ProfileSummary[] = profileNode ? JSON.parse(profileNode.textContent || '[]') : [];
  const profileMap: Record<string, ProfileSummary> = Object.fromEntries(profileList.map((p) => [p.slug, p]));
  const profileIndex = profileList.slice().sort((a, b) => a.name.localeCompare(b.name));

  // ----- State + persistence -----
  type Participant = { slug: string; role: Role };
  type State = { author: string; name: string; topology: ChainTopology; participants: Participant[] };

  const AUTHOR_KEY = 'smadp.chain-author';
  const DRAFT_KEY = 'smadp.chain-draft';
  const initial: State = (() => {
    let author = '';
    let draft: Partial<State> = {};
    try { author = localStorage.getItem(AUTHOR_KEY) ?? ''; } catch {}
    try { draft = JSON.parse(localStorage.getItem(DRAFT_KEY) ?? '{}'); } catch {}
    return {
      author,
      name: draft.name ?? '',
      topology: (draft.topology as ChainTopology) ?? 'linear',
      participants: (draft.participants as Participant[]) ?? [],
    };
  })();

  const state: State = initial;

  function persistAuthor() { try { localStorage.setItem(AUTHOR_KEY, state.author); } catch {} }
  function persistDraft() {
    try {
      localStorage.setItem(DRAFT_KEY, JSON.stringify({
        name: state.name, topology: state.topology, participants: state.participants,
      }));
    } catch {}
  }

  // ----- DOM -----
  const $ = <T extends HTMLElement = HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
  const authorInput = $<HTMLInputElement>('#cb-author');
  const nameInput = $<HTMLInputElement>('#cb-name');
  const searchInput = $<HTMLInputElement>('#cb-search');
  const resultsList = $<HTMLUListElement>('#cb-search-results');
  const partsList = $<HTMLUListElement>('#cb-participants');
  const subList = $<HTMLUListElement>('#cb-subverdicts');
  const missingEl = $<HTMLParagraphElement>('#cb-missing');
  const statusEl = $<HTMLParagraphElement>('#cb-publish-status');
  const topologyGroup = $('#cb-topology');
  const topologyHint = $('#cb-topology-hint');

  authorInput.value = state.author;
  nameInput.value = state.name;

  // ----- Helpers -----
  function defaultRoleFor(topology: ChainTopology, index: number, count: number): Role {
    if (topology === 'linear') {
      if (index === 0) return 'planner';
      if (index === count - 1) return 'critic';
      if (index === 1) return 'executor';
      return 'reasoner';
    }
    if (topology === 'star') {
      if (index === 0) return 'router';
      if (index === count - 1) return 'writer';
      return 'executor';
    }
    // loop
    if (index === 0) return 'planner';
    if (index === 1) return 'executor';
    if (index === 2) return 'critic';
    return 'reasoner';
  }

  function deriveEdges(participants: Participant[], topology: ChainTopology) {
    const edges: { from: string; to: string; channel: ChainChannel; carries: string[] }[] = [];
    const slugs = participants.filter((p) => p.slug).map((p) => p.slug);
    if (slugs.length < 2) return edges;
    if (topology === 'linear') {
      for (let i = 0; i < slugs.length - 1; i++) {
        edges.push({ from: slugs[i]!, to: slugs[i + 1]!, channel: 'prompt', carries: [] });
      }
    } else if (topology === 'star') {
      const hub = slugs[0]!;
      const merger = slugs[slugs.length - 1]!;
      for (let i = 1; i < slugs.length - 1; i++) {
        edges.push({ from: hub, to: slugs[i]!, channel: 'message-bus', carries: [] });
        edges.push({ from: slugs[i]!, to: merger, channel: 'message-bus', carries: [] });
      }
      if (slugs.length === 2) {
        edges.push({ from: hub, to: merger, channel: 'message-bus', carries: [] });
      }
    } else if (topology === 'loop') {
      for (let i = 0; i < slugs.length; i++) {
        edges.push({ from: slugs[i]!, to: slugs[(i + 1) % slugs.length]!, channel: 'prompt', carries: [] });
      }
    }
    return edges;
  }

  // ----- Search -----
  // Matches against name, slug, vendor, category, and any capability flag
  // that's set on the profile (e.g., typing "shell" surfaces agents with
  // execute_shell:true). These are the same caps the chain analyzer reads
  // from, so the search is literally over the catalog's research data.
  function capTokens(p: ProfileSummary): string[] {
    const t: string[] = [];
    if (p.caps.execute_shell) t.push('shell', 'execute');
    if (p.caps.write_filesystem) t.push('filesystem', 'write', 'files');
    if (p.caps.modify_git_state) t.push('git');
    if (p.caps.install_packages) t.push('install', 'packages');
    if (p.caps.spawn_subprocesses) t.push('subprocess', 'spawn');
    if (p.caps.use_mcp) t.push('mcp');
    if (p.caps.run_browsers) t.push('browser', 'browsers');
    if (p.io.calls_apis) t.push('api', 'apis', 'network');
    if (p.caps.network_egress === 'broad') t.push('network', 'broad');
    return t;
  }
  function capSummary(p: ProfileSummary): string {
    const tags: string[] = [];
    if (p.caps.execute_shell) tags.push('shell');
    if (p.caps.write_filesystem) tags.push('fs-write');
    if (p.caps.modify_git_state) tags.push('git');
    if (p.caps.use_mcp) tags.push('mcp');
    if (p.caps.run_browsers) tags.push('browser');
    if (p.io.calls_apis) tags.push('apis');
    return tags.slice(0, 4).join(' · ') || 'read-only';
  }
  const sourceColor: Record<string, string> = {
    'open-source': '#22C55E',
    'closed-source': '#EF4444',
    'source-available': '#F59E0B',
    'unknown': '#71717A',
  };

  function renderResults(query: string) {
    const q = query.trim().toLowerCase();
    if (!q) {
      resultsList.classList.add('hidden');
      resultsList.innerHTML = '';
      return;
    }
    const matches = profileIndex
      .filter((p) => {
        const inName = p.name.toLowerCase().includes(q);
        const inSlug = p.slug.toLowerCase().includes(q);
        const inVendor = p.vendor.toLowerCase().includes(q);
        const inCategory = p.category.toLowerCase().includes(q);
        const inCaps = capTokens(p).some((tok) => tok.includes(q));
        return inName || inSlug || inVendor || inCategory || inCaps;
      })
      .slice(0, 8);
    if (matches.length === 0) {
      resultsList.innerHTML = `<li class="px-3 py-2 text-xs text-ink-500">No agents in the catalog match "${escapeHtml(q)}"</li>`;
      resultsList.classList.remove('hidden');
      return;
    }
    resultsList.innerHTML = matches.map((p) => {
      const dot = sourceColor[p.source_type] ?? sourceColor.unknown;
      return `
        <li class="search-result" data-slug="${escapeHtml(p.slug)}" role="option">
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="inline-block h-2 w-2 rounded-full" style="background:${dot}" title="${escapeHtml(p.source_type)}"></span>
              <div class="truncate font-medium text-ink-100">${escapeHtml(p.name)}</div>
            </div>
            <div class="mt-0.5 flex flex-wrap items-center gap-1.5 font-mono text-[10px]">
              <span class="text-ink-500">${escapeHtml(p.slug)}</span>
              <span class="text-ink-600">·</span>
              <span class="text-ink-400">${escapeHtml(p.category)}</span>
              <span class="text-ink-600">·</span>
              <span class="text-brand-300">${escapeHtml(capSummary(p))}</span>
            </div>
          </div>
          <span class="font-mono text-[10px] uppercase tracking-wider text-ink-400">add →</span>
        </li>
      `;
    }).join('');
    resultsList.classList.remove('hidden');
    resultsList.querySelectorAll<HTMLLIElement>('.search-result').forEach((li) => {
      li.addEventListener('click', () => {
        const slug = li.dataset.slug!;
        addParticipant(slug);
        searchInput.value = '';
        resultsList.classList.add('hidden');
        resultsList.innerHTML = '';
        searchInput.focus();
      });
    });
  }

  searchInput.addEventListener('input', () => renderResults(searchInput.value));
  searchInput.addEventListener('focus', () => renderResults(searchInput.value));
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement)?.closest('#cb-search, #cb-search-results')) {
      resultsList.classList.add('hidden');
    }
  });

  // ----- Participant ops -----
  function addParticipant(slug: string) {
    if (!profileMap[slug]) return;
    const index = state.participants.length;
    state.participants.push({ slug, role: defaultRoleFor(state.topology, index, index + 1) });
    rebalanceRoles();
    renderParticipants();
    update();
    persistDraft();
  }
  function removeParticipant(i: number) {
    state.participants.splice(i, 1);
    rebalanceRoles();
    renderParticipants();
    update();
    persistDraft();
  }
  function cycleRole(i: number) {
    const cur = state.participants[i]!.role;
    const next = ROLES[(ROLES.indexOf(cur) + 1) % ROLES.length]!;
    state.participants[i]!.role = next;
    renderParticipants();
    update();
    persistDraft();
  }
  function rebalanceRoles() {
    // Re-assign defaults if the participant order changes meaningfully (topology positions matter).
    const n = state.participants.length;
    state.participants.forEach((p, i) => {
      // Only auto-set roles that look default-y; leave user-edited roles alone.
      // Heuristic: if the current role matches what the OTHER topology would have suggested, treat it as default.
      const wouldBe = defaultRoleFor(state.topology, i, n);
      const isLikelyDefault = (
        p.role === defaultRoleFor('linear', i, n) ||
        p.role === defaultRoleFor('star', i, n) ||
        p.role === defaultRoleFor('loop', i, n)
      );
      if (isLikelyDefault) p.role = wouldBe;
    });
  }
  function renderParticipants() {
    if (state.participants.length === 0) {
      partsList.innerHTML = `<li class="text-xs text-ink-500">No agents yet. Search above and click to add.</li>`;
      return;
    }
    partsList.innerHTML = '';
    state.participants.forEach((p, i) => {
      const li = document.createElement('li');
      li.className = 'participant-chip';
      const name = profileMap[p.slug]?.name ?? p.slug;
      li.innerHTML = `
        <span class="font-mono text-[10px] text-ink-500">${i + 1}</span>
        <span class="text-ink-100">${escapeHtml(name)}</span>
        <span class="role-pill" data-cycle="${i}" title="Click to cycle role">${p.role}</span>
        <button class="x-btn" data-remove="${i}" title="Remove">×</button>
      `;
      li.querySelector<HTMLButtonElement>('[data-remove]')!.addEventListener('click', () => removeParticipant(i));
      li.querySelector<HTMLSpanElement>('[data-cycle]')!.addEventListener('click', () => cycleRole(i));
      partsList.appendChild(li);
    });
  }

  // ----- Topology -----
  topologyGroup.querySelectorAll<HTMLButtonElement>('[data-topo]').forEach((btn) => {
    btn.addEventListener('click', () => {
      state.topology = (btn.dataset.topo as ChainTopology) ?? 'linear';
      topologyGroup.querySelectorAll<HTMLButtonElement>('[data-topo]').forEach((b) => {
        const active = b === btn;
        b.classList.toggle('topo-pill-active', active);
        b.setAttribute('aria-pressed', active ? 'true' : 'false');
      });
      const hints: Record<ChainTopology, string> = {
        linear: 'linear: p₁ → p₂ → … → pₙ. Edges, channels and roles are auto-derived.',
        star: 'star: p₁ orchestrates, p₂..pₙ₋₁ are workers, pₙ merges. Roles auto-assigned per position.',
        loop: 'loop: p₁ → p₂ → … → pₙ → p₁. The last participant feeds back into the first.',
        tree: '', dag: '',
      };
      topologyHint.textContent = hints[state.topology] ?? '';
      rebalanceRoles();
      renderParticipants();
      update();
      persistDraft();
    });
    if (btn.dataset.topo === state.topology) btn.click();
  });

  // ----- Live analysis -----
  function renderAnalysis(result: ReturnType<typeof analyze>) {
    document.getElementById('cb-composite')!.textContent = result.composite.toFixed(2);
    (document.getElementById('cb-composite') as HTMLElement).style.color = compositeColor(result.composite);
    const sev = maxSeverity(result.sub_verdicts as unknown as Record<string, { severity: string }>);
    const maxsevEl = document.getElementById('cb-maxsev')!;
    maxsevEl.textContent = sev;
    maxsevEl.style.color = SEV_COLOR[sev]!;

    subList.innerHTML = '';
    for (const r of RISKS) {
      const sv = result.sub_verdicts[r.id];
      const li = document.createElement('li');
      li.className = 'rounded-md border border-white/5 bg-ink-950/40 p-3';
      li.innerHTML = `
        <div class="flex items-center justify-between">
          <span class="font-mono text-[11px]">
            <span class="font-bold text-brand-300">${r.short}</span>
            <span class="ml-2 text-ink-200">${r.label}</span>
          </span>
          <span class="inline-flex items-center gap-1.5 font-mono text-[10px] text-ink-300">
            <span class="inline-block h-2.5 w-2.5 rounded-sm" style="background:${SEV_COLOR[sv.severity]}"></span>
            ${sv.severity}
          </span>
        </div>
        <p class="mt-2 text-[11px] leading-relaxed text-ink-400">${escapeHtml(sv.rationale)}</p>
      `;
      subList.appendChild(li);
    }
    if (result.missing && result.missing.length > 0) {
      missingEl.textContent = `Unknown agent slug${result.missing.length > 1 ? 's' : ''}: ${result.missing.join(', ')}`;
      missingEl.classList.remove('hidden');
    } else {
      missingEl.classList.add('hidden');
    }
  }
  function update() {
    const filtered = state.participants.filter((p) => p.slug);
    const edges = deriveEdges(filtered, state.topology);
    const draft: DraftChain = {
      name: state.name,
      topology: state.topology,
      participants: filtered.map((p) => ({ slug: p.slug, role: p.role })),
      edges,
    };
    renderAnalysis(analyze(draft, profileMap));
  }

  // ----- Inputs -----
  authorInput.addEventListener('input', () => {
    state.author = authorInput.value;
    persistAuthor();
    if (state.author.trim().length >= 2) authorInput.classList.remove('error');
  });
  nameInput.addEventListener('input', () => {
    state.name = nameInput.value;
    persistDraft();
  });

  function authorOk() { return state.author.trim().length >= 2; }
  function showStatus(text: string, kind: 'ok' | 'err' | 'info') {
    statusEl.textContent = text;
    statusEl.className = 'mt-3 rounded-md px-3 py-2 text-xs ' + (
      kind === 'ok' ? 'bg-emerald-500/10 text-emerald-200'
      : kind === 'err' ? 'bg-rose-500/10 text-rose-200'
      : 'bg-white/5 text-ink-300'
    );
    statusEl.classList.remove('hidden');
  }

  // ----- Submit -----
  function buildChainPayload() {
    const filtered = state.participants.filter((p) => p.slug);
    const edges = deriveEdges(filtered, state.topology);
    const slug = (state.name || 'chain').toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    const result = analyze({ name: state.name, topology: state.topology, participants: filtered, edges }, profileMap);
    const headline =
      `${state.name || 'Untitled chain'}: ${result.sub_verdicts.A_prompt_injection.severity}/` +
      `${result.sub_verdicts.B_data_leakage.severity}/` +
      `${result.sub_verdicts.C_capability_conflict.severity}/` +
      `${result.sub_verdicts.D_cascading_error.severity}/` +
      `${result.sub_verdicts.E_compliance.severity} (composite ${result.composite.toFixed(2)}).`;
    const now = new Date().toISOString();
    return {
      schema_version: '1.0' as const,
      chain_id: `c_${slug || 'draft'}-${Date.now().toString(36)}`,
      name: state.name || 'Untitled chain',
      author: state.author.trim(),
      topology: state.topology,
      participants: filtered.map((p) => ({ slug: p.slug, role: p.role })),
      edges,
      headline: headline.length > 240 ? headline.slice(0, 237) + '...' : headline,
      sub_verdicts: result.sub_verdicts,
      composite_score: Math.round(result.composite * 100) / 100,
      max_severity: maxSeverity(result.sub_verdicts as unknown as Record<string, { severity: string }>),
      evidence_level: 'docs-only',
      confidence: 0.55,
      framework_mappings: {},
      evidence_refs: [],
      first_seen_at: now,
      last_refreshed_at: now,
    };
  }

  document.getElementById('cb-publish')!.addEventListener('click', async () => {
    if (!authorOk()) {
      authorInput.classList.add('error');
      authorInput.focus();
      showStatus('Enter your name or username before submitting.', 'err');
      return;
    }
    if (!state.name.trim()) {
      nameInput.classList.add('error');
      nameInput.focus();
      showStatus('Give your chain a name first.', 'err');
      return;
    }
    nameInput.classList.remove('error');
    if (state.participants.filter((p) => p.slug).length < 3) {
      searchInput.focus();
      showStatus('A chain needs at least 3 participants.', 'err');
      return;
    }
    const payload = buildChainPayload();
    showStatus('Submitting…', 'info');
    try {
      const created = await apiFetch<{ chain_id: string }>('/chains', { method: 'POST', json: payload });
      showStatus(`Submitted as ${created.chain_id} by ${state.author}. It will appear in /chains/library once accepted.`, 'ok');
    } catch (e) {
      const err = e as ApiError;
      showStatus(`Submission failed: ${err.title}${err.detail ? `, ${err.detail}` : ''}`, 'err');
    }
  });

  // ----- Helpers -----
  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (ch) => ({
      '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
    }[ch]!));
  }

  // ----- Initial paint -----
  renderParticipants();
  update();
</script>
</Layout>
