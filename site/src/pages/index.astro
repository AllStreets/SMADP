---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import VerdictCard from '../components/VerdictCard.astro';
import AgentCard from '../components/AgentCard.astro';
import RiskBadge from '../components/RiskBadge.astro';
import { getVerdicts, getProfiles, getRiskTaxonomy } from '../data/catalog';
import type { RiskId } from '../data/types';

const recentVerdicts = getVerdicts().slice(0, 6);
const tickerVerdicts = getVerdicts().slice(0, 12);
const featuredProfiles = getProfiles().slice(0, 6);
const risks = getRiskTaxonomy().risks;
---

<Layout title="SMADP — Safe Multi-Agent Deployment Platform">
  <Hero />

  <!-- Recent verdicts ticker -->
  {tickerVerdicts.length > 0 && (
    <section class="border-y border-white/5 bg-ink-950/60 py-3">
      <div class="container-page">
        <div class="flex items-center gap-4">
          <span class="heading-eyebrow shrink-0">Recent verdicts</span>
          <div class="marquee-pause overflow-hidden">
            <div class="marquee whitespace-nowrap">
              {[...tickerVerdicts, ...tickerVerdicts].map((v) => (
                <a
                  href={`/verdicts/${v.verdict_id}`}
                  class="inline-flex items-center gap-2 text-sm text-ink-300 hover:text-white"
                >
                  <span class="font-mono text-xs text-ink-500">{v.generated_at.slice(0, 10)}</span>
                  <span>{v.pair[0]} × {v.pair[1]}</span>
                  <span
                    class="font-mono text-xs"
                    style={`color:${
                      v.composite_score < 0.3
                        ? '#22C55E'
                        : v.composite_score < 0.6
                          ? '#F59E0B'
                          : '#EF4444'
                    };`}
                  >
                    {v.composite_score.toFixed(2)}
                  </span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Value prop -->
  <section class="container-page mt-20">
    <div class="grid gap-6 md:grid-cols-3">
      {[
        {
          t: 'Evidence-cited',
          d: 'Every claim points to a verbatim quote from the agent\'s docs, source, or ToS — content-addressed and reproducible.',
          c: '#A78BFA',
        },
        {
          t: 'Risk-typed',
          d: 'Five distinct risk categories evaluated independently — prompt injection, data leakage, capability conflict, cascading error, compliance.',
          c: '#22D3EE',
        },
        {
          t: 'Honestly layered',
          d: 'docs-only / profile-verified / sandbox-validated badges tell you exactly which evidence layer supports each verdict.',
          c: '#22C55E',
        },
      ].map((f) => (
        <div class="card relative overflow-hidden">
          <div
            class="absolute -right-10 -top-10 h-32 w-32 rounded-full opacity-25 blur-3xl"
            style={`background:${f.c};`}
          ></div>
          <h3 class="h3 text-white">{f.t}</h3>
          <p class="mt-3 text-sm text-ink-300 leading-relaxed">{f.d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Risks at a glance -->
  <section class="container-page mt-20">
    <div class="flex items-end justify-between">
      <div>
        <span class="heading-eyebrow">Risk taxonomy</span>
        <h2 class="h2 mt-2 text-white">Five things that go wrong when agents share an environment.</h2>
      </div>
      <a href="/risks" class="btn-ghost">Read more →</a>
    </div>

    <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-5">
      {risks.map((r) => (
        <a
          href={`/risks#${r.id}`}
          class="card card-hover block"
        >
          <div class="flex items-center gap-3">
            <RiskBadge risk={r.id as RiskId} size="md" />
            <div class="font-mono text-[10px] uppercase tracking-wider text-ink-400">
              weight {r.weight.toFixed(2)}
            </div>
          </div>
          <div class="mt-3 font-display font-semibold text-white">{r.name}</div>
          <p class="mt-2 line-clamp-3 text-xs text-ink-400 leading-relaxed">{r.description}</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Recent verdicts grid -->
  {recentVerdicts.length > 0 && (
    <section class="container-page mt-20">
      <div class="flex items-end justify-between">
        <div>
          <span class="heading-eyebrow">Recent</span>
          <h2 class="h2 mt-2 text-white">Latest pairwise verdicts</h2>
        </div>
        <a href="/verdicts" class="btn-ghost">Browse all →</a>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {recentVerdicts.map((v) => <VerdictCard verdict={v} />)}
      </div>
    </section>
  )}

  <!-- Featured agents -->
  {featuredProfiles.length > 0 && (
    <section class="container-page mt-20">
      <div class="flex items-end justify-between">
        <div>
          <span class="heading-eyebrow">Catalog</span>
          <h2 class="h2 mt-2 text-white">Featured agents</h2>
        </div>
        <a href="/agents" class="btn-ghost">All agents →</a>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {featuredProfiles.map((p) => <AgentCard profile={p} />)}
      </div>
    </section>
  )}

  <!-- Big matrix CTA -->
  <section class="container-page mt-24">
    <div class="relative overflow-hidden rounded-2xl border border-brand-500/20 bg-gradient-to-br from-brand-900/30 via-ink-900/40 to-cyber-600/10 p-10 text-center">
      <div class="absolute inset-0 bg-dot-grid opacity-50" aria-hidden="true"></div>
      <div class="relative">
        <span class="heading-eyebrow">Centerpiece</span>
        <h2 class="h2 mt-2 text-white">The Risk Atlas.</h2>
        <p class="mx-auto mt-3 max-w-xl text-ink-300">
          Every pair × every risk axis in one view. Distribution, top-10 hot
          spots, and per-agent risk profiles — click any row to drill into the
          verdict.
        </p>
        <a href="/risk-atlas" class="btn-primary mt-6">Open the Risk Atlas</a>
      </div>
    </div>
  </section>
</Layout>
