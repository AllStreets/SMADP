---
import Layout from '../layouts/Layout.astro';
import CompatibilityMatrix from '../components/CompatibilityMatrix.astro';
import { getProfiles, getVerdicts } from '../data/catalog';

const profileCount = getProfiles().length;
const verdictCount = getVerdicts().length;
---

<Layout title="Compatibility Matrix — SMADP" variant="wide">
  <section class="container-page mt-10">
    <span class="heading-eyebrow">Centerpiece</span>
    <div class="mt-3 flex flex-wrap items-end justify-between gap-4">
      <h1 class="h1 text-white">Compatibility Matrix</h1>
      <div class="font-mono text-xs text-ink-400">
        {profileCount} agents · {verdictCount} verdicts
      </div>
    </div>
    <p class="lead mt-4 max-w-3xl">
      Every cell is a verdict. Color encodes composite score across all five risk
      categories — lower is safer. Switch the filter to see how a single risk
      flows through the catalog. Click into any cell for the full evidence-cited
      report.
    </p>
  </section>

  <section class="container-page mt-10">
    <CompatibilityMatrix />
  </section>

  <section class="container-page mt-16">
    <div class="card">
      <h2 class="h3 text-white">How to read the matrix</h2>
      <ul class="mt-4 grid gap-3 text-sm text-ink-300 sm:grid-cols-2">
        <li>
          <span class="text-emerald-400 font-mono">green ≤ 0.30</span> — composable with documented mitigations.
        </li>
        <li>
          <span class="text-amber-400 font-mono">amber 0.30 – 0.60</span> — composable only under listed conditions.
        </li>
        <li>
          <span class="text-red-400 font-mono">red ≥ 0.60</span> — high-severity sub-verdicts present; review before composing.
        </li>
        <li>
          <span class="text-ink-400 font-mono">empty</span> — no verdict generated yet for this pair.
        </li>
      </ul>
    </div>
  </section>
</Layout>
