---
import type { VerdictSignature } from '../data/types';

interface Props {
  signature: VerdictSignature;
}

const { signature } = Astro.props;

const shortPub =
  signature.public_key_hex.length > 16
    ? `${signature.public_key_hex.slice(0, 8)}…${signature.public_key_hex.slice(-8)}`
    : signature.public_key_hex;
---

<section
  class="rounded-lg border border-emerald-500/30 bg-emerald-500/[0.04] p-4"
  aria-label="Verdict signature"
>
  <header class="mb-3 flex items-center gap-2">
    <span
      class="h-1.5 w-1.5 rounded-full"
      style="background:#22C55E; box-shadow:0 0 8px #22C55E80;"
    ></span>
    <h3 class="font-mono text-xs uppercase tracking-wider text-emerald-400">
      Signed verdict — {signature.signing_strategy}
    </h3>
  </header>

  <dl class="space-y-1.5 text-xs">
    <div class="flex gap-2">
      <dt class="w-32 shrink-0 text-zinc-500">canonical sha256</dt>
      <dd class="break-all font-mono text-zinc-300">{signature.canonical_sha256}</dd>
    </div>
    <div class="flex gap-2">
      <dt class="w-32 shrink-0 text-zinc-500">public key</dt>
      <dd class="font-mono text-zinc-300" title={signature.public_key_hex}>{shortPub}</dd>
    </div>
  </dl>

  <details class="mt-3 text-xs">
    <summary class="cursor-pointer text-zinc-400 hover:text-zinc-200">
      › Verify this signature
    </summary>
    <div class="mt-2 space-y-2 text-zinc-400">
      <p>
        The signature is a detached Ed25519 signature over the verdict's
        canonical sha256 (the UTF-8 bytes of
        <code class="font-mono text-zinc-300">{signature.canonical_sha256}</code>).
        Recompute the canonical sha256 over the verdict JSON
        (sorted keys, compact separators) and verify:
      </p>
      <pre class="overflow-x-auto rounded bg-black/40 p-2 font-mono text-[11px] text-zinc-300"><code>from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
import hashlib, json

pub = Ed25519PublicKey.from_public_bytes(bytes.fromhex("{signature.public_key_hex}"))
canonical = json.dumps(verdict, sort_keys=True, separators=(",", ":")).encode()
sha = "sha256:" + hashlib.sha256(canonical).hexdigest()
assert sha == "{signature.canonical_sha256}"
pub.verify(bytes.fromhex("{signature.signature_hex}"), sha.encode())</code></pre>
    </div>
  </details>
</section>
