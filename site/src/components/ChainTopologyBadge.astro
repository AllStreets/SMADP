---
import type { ChainTopology } from '../lib/chains';

export interface Props {
  topology: ChainTopology;
}

const { topology } = Astro.props;

const COPY: Record<ChainTopology, { label: string; tone: string }> = {
  linear: {
    label: 'Linear',
    tone: 'bg-brand-600/15 text-brand-200 ring-brand-500/30',
  },
  star: {
    label: 'Star',
    tone: 'bg-amber-500/15 text-amber-200 ring-amber-500/30',
  },
  loop: {
    label: 'Loop',
    tone: 'bg-rose-500/15 text-rose-200 ring-rose-500/30',
  },
  tree: {
    label: 'Tree',
    tone: 'bg-emerald-500/15 text-emerald-200 ring-emerald-500/30',
  },
  dag: {
    label: 'DAG',
    tone: 'bg-cyan-500/15 text-cyan-200 ring-cyan-500/30',
  },
};

const c = COPY[topology];
---

<span
  class:list={[
    'inline-flex items-center rounded-md px-2 py-0.5 text-[11px] font-medium ring-1 ring-inset',
    c.tone,
  ]}
>
  {c.label}
</span>
