---
import { getStats } from '../data/catalog';

const stats = getStats();
---

<section class="relative overflow-hidden">
  <!-- Background fx -->
  <div class="pointer-events-none absolute inset-0">
    <div class="absolute inset-0 bg-line-grid opacity-50"></div>
    <div
      class="absolute -top-40 left-1/2 h-[700px] w-[1100px] -translate-x-1/2 rounded-full"
      style="background: radial-gradient(closest-side, rgba(124,58,237,0.35), transparent 70%); filter: blur(40px);"
    ></div>
    <div
      class="absolute bottom-0 right-0 h-[400px] w-[600px]"
      style="background: radial-gradient(closest-side, rgba(6,182,212,0.20), transparent 70%); filter: blur(60px);"
    ></div>
  </div>

  <div class="container-page relative pt-16 sm:pt-24 pb-20">
    <div class="mx-auto max-w-3xl text-center">
      <span class="heading-eyebrow">Safe Multi-Agent Deployment Platform</span>

      <h1 class="h1 mt-4">
        <span class="text-gradient">Can these two agents</span><br />
        <span class="text-white">safely run together?</span>
      </h1>

      <p class="lead mx-auto mt-6 max-w-2xl">
        SMADP publishes the matrix. Every pair of popular AI agents gets an
        evidence-cited, reproducible verdict — across five risk categories — so
        you know what breaks before you ship it.
      </p>

      <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
        <a href="/matrix" class="btn-primary">
          View the matrix
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M13 5l7 7-7 7"/>
          </svg>
        </a>
        <a href="/methodology" class="btn-ghost">How verdicts are produced</a>
        <a href="/submit" class="btn-cyber">Submit an agent</a>
      </div>
    </div>

    <!-- Topline stats -->
    <div class="mx-auto mt-16 grid max-w-4xl grid-cols-2 gap-3 sm:grid-cols-4">
      {[
        { v: stats.profile_count, l: 'agents profiled', a: 'brand' as const },
        { v: stats.verdict_count, l: 'pairwise verdicts', a: 'cyber' as const },
        { v: `${stats.sandbox_validated_pct}%`, l: 'sandbox-validated', a: 'green' as const },
        { v: stats.open_source_count, l: 'open-source agents', a: 'amber' as const },
      ].map((s) => (
        <div class="glass rounded-lg px-4 py-4 text-center">
          <div
            class={`font-display text-3xl font-extrabold ${
              s.a === 'brand'
                ? 'text-brand-300'
                : s.a === 'cyber'
                  ? 'text-cyber-400'
                  : s.a === 'green'
                    ? 'text-emerald-400'
                    : 'text-amber-400'
            }`}
          >
            {s.v}
          </div>
          <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-ink-400">
            {s.l}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
