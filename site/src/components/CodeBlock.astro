---
interface Props {
  code: string | object;
  lang?: string;
  /** Optional title shown in the block's header bar. */
  title?: string;
}

const { code, lang = 'json', title } = Astro.props;
const text =
  typeof code === 'string' ? code : JSON.stringify(code, null, 2);
---

<div class="overflow-hidden rounded-xl border border-white/10 bg-ink-900/80 shadow-inner">
  {(title || lang) && (
    <div class="flex items-center justify-between border-b border-white/5 bg-ink-850/60 px-4 py-2">
      <span class="font-mono text-[11px] uppercase tracking-wider text-ink-400">
        {title ?? lang}
      </span>
      <span class="font-mono text-[10px] text-ink-500">{lang}</span>
    </div>
  )}
  <pre class="scrollbar-thin overflow-x-auto p-4 font-mono text-xs leading-relaxed text-ink-200"><code>{text}</code></pre>
</div>
