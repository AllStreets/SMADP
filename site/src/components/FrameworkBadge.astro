---
interface Props {
  framework: string;
  control: string;
  href?: string;
}

const { framework, control, href } = Astro.props;

const labels: Record<string, { short: string; color: string }> = {
  nist_ai_rmf: { short: 'NIST', color: '#22D3EE' },
  iso_42001: { short: 'ISO', color: '#A78BFA' },
  owasp_llm_top_10: { short: 'OWASP', color: '#F59E0B' },
};
const meta = labels[framework] ?? { short: framework.toUpperCase(), color: '#A78BFA' };
const styleStr = `color:${meta.color}; border-color:${meta.color}55; background:${meta.color}10;`;
---

{href ? (
  <a href={href} class="hover:opacity-80">
    <span
      class="inline-flex items-center gap-1.5 rounded-md border px-2 py-0.5 font-mono text-[11px] tracking-wider"
      style={styleStr}
    >
      <span class="opacity-70">{meta.short}</span>
      <span class="font-semibold">{control}</span>
    </span>
  </a>
) : (
  <span
    class="inline-flex items-center gap-1.5 rounded-md border px-2 py-0.5 font-mono text-[11px] tracking-wider"
    style={styleStr}
  >
    <span class="opacity-70">{meta.short}</span>
    <span class="font-semibold">{control}</span>
  </span>
)}
