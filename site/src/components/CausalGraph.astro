---
/**
 * CausalGraph — deterministic SVG of the causal risk DAG for one verdict.
 *
 * Fixed layout (no force simulation, build-time only): the five risk nodes are
 * placed on a fixed grid; edges are drawn between them with stroke width scaled
 * by the (Python-parity) amplification, and only active edges are solid. The
 * highest-leverage mitigation node is ringed and named in the caption.
 *
 * No emoji anywhere (CLAUDE.md hard rule) — unicode glyphs / plain labels only.
 */
import { severityColor } from '../data/catalog';
import { RISK_ORDER } from '../data/types';
import type { RiskId, Severity } from '../data/types';
import type { CausalityReport } from '../lib/causality';

interface Props {
  report: CausalityReport;
}
const { report } = Astro.props as Props;

// Short glyph labels (no emoji): the risk letter prefix.
const LETTER: Record<string, string> = {
  A_prompt_injection: 'A',
  B_data_leakage: 'B',
  C_capability_conflict: 'C',
  D_cascading_error: 'D',
  E_compliance: 'E',
};
const SHORT: Record<string, string> = {
  A_prompt_injection: 'Prompt injection',
  B_data_leakage: 'Data leakage',
  C_capability_conflict: 'Capability conflict',
  D_cascading_error: 'Cascading error',
  E_compliance: 'Compliance',
};

// Fixed pentagon layout in a 360×260 viewBox.
const W = 360;
const H = 260;
const POS: Record<string, { x: number; y: number }> = {
  A_prompt_injection: { x: 180, y: 36 },
  B_data_leakage: { x: 320, y: 120 },
  C_capability_conflict: { x: 256, y: 224 },
  D_cascading_error: { x: 104, y: 224 },
  E_compliance: { x: 40, y: 120 },
};
const R = 26;

const severities = report.severities as Record<RiskId, Severity>;
const best = report.best_mitigation;

// Trim an edge endpoint to the node circle boundary so arrowheads sit outside.
function trim(
  from: { x: number; y: number },
  to: { x: number; y: number },
  rad: number,
) {
  const dx = to.x - from.x;
  const dy = to.y - from.y;
  const len = Math.hypot(dx, dy) || 1;
  return { x: to.x - (dx / len) * rad, y: to.y - (dy / len) * rad };
}
---

<div class="not-prose">
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="img"
    aria-label="Causal risk graph"
    class="w-full max-w-md"
  >
    <defs>
      <marker
        id="cg-arrow"
        viewBox="0 0 10 10"
        refX="8"
        refY="5"
        markerWidth="6"
        markerHeight="6"
        orient="auto-start-reverse"
      >
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#94a3b8" />
      </marker>
    </defs>

    {report.edges.map((e) => {
      const from = POS[e.from]!;
      const to = trim(from, POS[e.to]!, R);
      const width = e.active ? 1 + e.amplification * 5 : 1;
      return (
        <line
          x1={from.x}
          y1={from.y}
          x2={to.x}
          y2={to.y}
          stroke={e.active ? '#94a3b8' : '#3f3f46'}
          stroke-width={width}
          stroke-dasharray={e.active ? '0' : '4 4'}
          opacity={e.active ? 0.9 : 0.4}
          marker-end="url(#cg-arrow)"
        />
      );
    })}

    {RISK_ORDER.map((rid: RiskId) => {
      const p = POS[rid]!;
      const isBest = rid === best;
      return (
        <g>
          {isBest && (
            <circle cx={p.x} cy={p.y} r={R + 5} fill="none" stroke="#22d3ee" stroke-width="2" />
          )}
          <circle
            cx={p.x}
            cy={p.y}
            r={R}
            fill={severityColor(severities[rid])}
            stroke="#0b0b0f"
            stroke-width="2"
          />
          <text
            x={p.x}
            y={p.y + 5}
            text-anchor="middle"
            font-family="ui-monospace, monospace"
            font-size="15"
            font-weight="700"
            fill="#0b0b0f"
          >
            {LETTER[rid]}
          </text>
        </g>
      );
    })}
  </svg>

  <p class="mt-3 text-sm text-ink-300">
    {best ? (
      <span>
        Highest-leverage mitigation: <span class="font-mono text-cyber-400">{LETTER[best]}</span>
        {' — '}{SHORT[best]} (leverage {report.leverage[best]!.toFixed(2)}).
        Addressing it deterministically deflates the most downstream amplification.
      </span>
    ) : (
      <span>No active causal amplification for this verdict; every risk leverage is zero.</span>
    )}
  </p>
</div>
