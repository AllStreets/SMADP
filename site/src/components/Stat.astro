---
interface Props {
  label: string;
  value: string | number;
  /** Small extra hint under the value. */
  hint?: string;
  accent?: 'brand' | 'cyber' | 'green' | 'amber';
}

const { label, value, hint, accent = 'brand' } = Astro.props;

const accentClass = {
  brand: 'text-brand-300',
  cyber: 'text-cyber-400',
  green: 'text-emerald-400',
  amber: 'text-amber-400',
}[accent];
---

<div class="card relative overflow-hidden">
  <div
    class="absolute -right-8 -top-8 h-32 w-32 rounded-full opacity-30 blur-3xl"
    style={`background: ${
      accent === 'brand' ? '#7C3AED' : accent === 'cyber' ? '#06B6D4' : accent === 'green' ? '#22C55E' : '#F59E0B'
    };`}
    aria-hidden="true"
  ></div>
  <div class="heading-eyebrow">{label}</div>
  <div class={`mt-3 font-display text-4xl font-extrabold tracking-tight ${accentClass}`}>
    {value}
  </div>
  {hint && <div class="mt-2 text-xs text-ink-400">{hint}</div>}
</div>
