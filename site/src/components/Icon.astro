---
const ICON_NAMES = [
  'shield',
  'layers',
  'refresh',
  'clock',
  'zap',
  'link',
  'alert-triangle',
  'file-text',
  'briefcase',
  'eye',
  'check-circle',
  'webhook',
  'building',
  'gavel',
] as const;

export type IconName = (typeof ICON_NAMES)[number];

export interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
  ariaLabel?: string;
}

const {
  name,
  size = 18,
  class: className = '',
  strokeWidth = 1.75,
  ariaLabel,
} = Astro.props;

// Lucide-style 24x24 stroke icons. Source paths from lucide.dev (ISC license).
const SHIELD_PATH = '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>';
const LAYERS_PATH = '<path d="m12 2 9 5-9 5-9-5 9-5z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/>';
const REFRESH_PATH = '<path d="M3 12a9 9 0 0 1 15-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-15 6.7L3 16"/><path d="M3 21v-5h5"/>';
const CLOCK_PATH = '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>';
const ZAP_PATH = '<path d="M13 2 3 14h7l-1 8 11-14h-7l1-6z"/>';
const LINK_PATH = '<path d="M10 13a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"/>';
const ALERT_TRIANGLE_PATH = '<path d="m10.29 3.86-8.36 14.49A2 2 0 0 0 3.66 21h16.68a2 2 0 0 0 1.73-2.65L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>';
const FILE_TEXT_PATH = '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/>';
const BRIEFCASE_PATH = '<rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>';
const EYE_PATH = '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>';
const CHECK_CIRCLE_PATH = '<path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>';
const WEBHOOK_PATH = '<path d="M18 16.98h-5.99c-1.1 0-1.95.94-2.48 1.9a4 4 0 1 1-5.49-5.5"/><path d="m11 7.5 4.5 4.5-4.5 4.5"/><path d="M16 3a4 4 0 0 1 4 4c0 2.21-1.79 4-4 4"/>';
const BUILDING_PATH = '<rect x="4" y="2" width="16" height="20" rx="2"/><line x1="9" y1="22" x2="9" y2="2"/><line x1="15" y1="22" x2="15" y2="2"/>';
const GAVEL_PATH = '<path d="m14 14-7.5 7.5"/><path d="M16 4 8 12l4 4 8-8z"/><path d="M14 6l4 4"/><path d="M3 21h18"/>';

const PATHS: Record<IconName, string> = {
  shield: SHIELD_PATH,
  layers: LAYERS_PATH,
  refresh: REFRESH_PATH,
  clock: CLOCK_PATH,
  zap: ZAP_PATH,
  link: LINK_PATH,
  'alert-triangle': ALERT_TRIANGLE_PATH,
  'file-text': FILE_TEXT_PATH,
  briefcase: BRIEFCASE_PATH,
  eye: EYE_PATH,
  'check-circle': CHECK_CIRCLE_PATH,
  webhook: WEBHOOK_PATH,
  building: BUILDING_PATH,
  gavel: GAVEL_PATH,
};

const inner = PATHS[name];
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  role={ariaLabel ? 'img' : 'presentation'}
  aria-label={ariaLabel}
  aria-hidden={ariaLabel ? undefined : 'true'}
  set:html={inner}
></svg>
