---
import type { RiskId } from '../data/types';
import { riskMeta } from '../data/catalog';

interface Props {
  risk: RiskId;
  size?: 'sm' | 'md';
}
const { risk, size = 'sm' } = Astro.props;
const meta = riskMeta(risk);

const palette: Record<string, string> = {
  A: '#A78BFA',
  B: '#22D3EE',
  C: '#F59E0B',
  D: '#EC4899',
  E: '#84CC16',
};
const letter = meta?.letter ?? risk[0];
const color = palette[letter] ?? '#A78BFA';
const cls = size === 'sm' ? 'h-6 w-6 text-[11px]' : 'h-8 w-8 text-sm';
---

<span
  class={`inline-flex items-center justify-center rounded-md font-mono font-bold ${cls}`}
  style={`color:${color}; background:${color}1A; border:1px solid ${color}55;`}
  title={meta?.name ?? risk}
>
  {letter}
</span>
