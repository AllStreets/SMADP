---
import { severityScore, severityColor } from '../data/catalog';
import type { Severity } from '../data/types';

interface Props {
  severity: Severity;
  /** Show the label after the bar. */
  showLabel?: boolean;
  /** Compact / inline rendering. */
  compact?: boolean;
}

const { severity, showLabel = true, compact = false } = Astro.props;
const pct = Math.round(severityScore(severity) * 100);
const color = severityColor(severity);
---

<div class={compact ? 'flex items-center gap-2' : 'flex w-full items-center gap-3'}>
  <div class={compact ? 'sev-bar w-20' : 'sev-bar flex-1'}>
    <span style={`width:${Math.max(pct, severity === 'none' ? 8 : pct)}%; background:${color};`}></span>
  </div>
  {
    showLabel && (
      <span
        class="font-mono text-[11px] uppercase tracking-wider"
        style={`color:${color};`}
      >
        {severity}
      </span>
    )
  }
</div>
