---
import type { Profile } from '../data/types';
import { categoryName } from '../data/catalog';

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;

const sourceColor = {
  'open-source': '#22C55E',
  'closed-source': '#A78BFA',
  'source-available': '#F59E0B',
}[profile.source_type];

const verifiedColors: Record<string, string> = {
  verified: '#22C55E',
  draft: '#F59E0B',
  unverified: '#71717A',
  stale: '#EF4444',
  invalid: '#EF4444',
};
const verification = (profile as any).verification ?? { status: 'unverified' };
const vColor = verifiedColors[verification.status] ?? '#71717A';

const caps = (profile.capabilities ?? {}) as any;
const networkLabel = caps.network_egress ?? 'unknown';
const vendorHandle = (profile as any).vendor?.handle ?? '—';
---

<a href={`/agents/${profile.slug}`} class="card card-hover group block">
  <div class="flex items-start justify-between gap-4">
    <div class="min-w-0">
      <div class="flex items-center gap-2">
        <h3 class="truncate font-display text-lg font-semibold text-white group-hover:text-brand-200">
          {profile.name}
        </h3>
        <span
          class="h-2 w-2 shrink-0 rounded-full"
          style={`background:${vColor}; box-shadow:0 0 8px ${vColor}aa;`}
          title={`Verification: ${verification.status}`}
        ></span>
      </div>
      {profile.tagline && (
        <p class="mt-1.5 line-clamp-2 text-sm text-ink-300">{profile.tagline}</p>
      )}
    </div>
    <span
      class="pill shrink-0"
      style={`color:${sourceColor}; border-color:${sourceColor}55;`}
    >
      {(profile.source_type ?? '—').replace('-', ' ')}
    </span>
  </div>

  <div class="mt-4 flex flex-wrap items-center gap-1.5 text-[11px]">
    <span class="pill">{categoryName(profile.category)}</span>
    <span class="pill" title="Network egress">net: {networkLabel}</span>
    {caps.write_filesystem && (
      <span class="pill" style="color:#F59E0B; border-color:#F59E0B55;">fs:write</span>
    )}
    {caps.execute_shell && (
      <span class="pill" style="color:#EF4444; border-color:#EF444455;">exec:shell</span>
    )}
    {caps.use_mcp && (
      <span class="pill" style="color:#22D3EE; border-color:#22D3EE55;">mcp</span>
    )}
  </div>

  <div class="mt-4 flex items-center justify-between text-[11px] text-ink-500">
    <span class="font-mono">{vendorHandle}</span>
    <span class="opacity-0 transition group-hover:opacity-100 text-brand-300">view profile →</span>
  </div>
</a>
