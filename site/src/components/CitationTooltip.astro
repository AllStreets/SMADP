---
import type { Citation } from '../data/types';
import { getEvidenceQuote } from '../data/catalog';
import { humanizeField } from '../lib/evidence';

interface Props {
  citation: Citation;
}

const { citation } = Astro.props;

// Resolve a quote if one exists (inline, or from the evidence store).
let quote = citation.quote;
if (!quote && citation.evidence_ref) {
  quote = getEvidenceQuote(citation.evidence_ref);
}

const label = humanizeField(citation.profile_field) || 'Evidence';
const truncatedRef = citation.evidence_ref
  ? citation.evidence_ref.slice(0, 19) + '…'
  : null;
---

{
  quote ? (
    // Has a real quote — render an expandable pill that reveals it in flow.
    <details class="ev-pill ev-pill--has-quote">
      <summary class="ev-pill__summary">
        <span class="ev-pill__label">{label}</span>
        <svg class="ev-pill__caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </summary>
      <div class="ev-pill__body">
        <blockquote class="ev-pill__quote">“{quote}”</blockquote>
        {truncatedRef && (
          <div class="ev-pill__ref" title={citation.evidence_ref}>{truncatedRef}</div>
        )}
      </div>
    </details>
  ) : (
    // Provenance only — a clean, non-interactive chip. No empty dropdown.
    <span class="ev-pill ev-pill--static">{label}</span>
  )
}

<style>
  .ev-pill {
    display: inline-block;
    border: 1px solid rgb(139 92 246 / 0.22);
    border-radius: 9999px;
    background: rgb(139 92 246 / 0.06);
    font-size: 0.72rem;
    line-height: 1.2;
    color: rgb(203 213 225);
    max-width: 100%;
  }
  .ev-pill--static {
    padding: 0.3rem 0.7rem;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Quote-bearing pills can expand; give them a softer rounded-rect so the
     revealed quote reads as a card rather than a stretched pill. */
  .ev-pill--has-quote {
    border-radius: 0.6rem;
    vertical-align: top;
  }
  .ev-pill__summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    list-style: none;
    padding: 0.3rem 0.7rem;
  }
  .ev-pill__summary::-webkit-details-marker { display: none; }
  .ev-pill--has-quote:hover { background: rgb(139 92 246 / 0.1); }
  .ev-pill__label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ev-pill__caret {
    width: 0.8rem;
    height: 0.8rem;
    flex-shrink: 0;
    color: rgb(148 163 184);
    transition: transform 0.15s ease;
  }
  .ev-pill--has-quote[open] .ev-pill__caret { transform: rotate(180deg); }
  .ev-pill__body {
    padding: 0 0.7rem 0.55rem;
  }
  .ev-pill__quote {
    border-left: 2px solid rgb(139 92 246 / 0.6);
    padding-left: 0.7rem;
    font-style: italic;
    font-size: 0.78rem;
    line-height: 1.5;
    color: rgb(226 232 240);
  }
  .ev-pill__ref {
    margin-top: 0.45rem;
    font-family: ui-monospace, monospace;
    font-size: 0.62rem;
    color: rgb(100 116 139);
  }
</style>
