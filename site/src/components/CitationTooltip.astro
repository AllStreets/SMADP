---
import type { Citation } from '../data/types';
import { getEvidenceQuote } from '../data/catalog';

interface Props {
  citation: Citation;
  /** Visible reference label (e.g. "[1]"). */
  label?: string;
}

const { citation, label } = Astro.props;

// Resolve the actual quote text from the evidence store; fall back to inline.
let quote = citation.quote;
if (!quote && citation.evidence_ref) {
  quote = getEvidenceQuote(citation.evidence_ref);
}

const truncatedRef = citation.evidence_ref
  ? citation.evidence_ref.slice(0, 19) + '…'
  : null;
---

{/*
  An evidence footnote. Renders as a closed chip that expands IN FLOW (it
  pushes following content down rather than floating over it), so several can
  be open at once without overlapping each other or bleeding through the prose.
*/}
<details class="cite-fn">
  <summary class="cite-summary">
    <span class="cite-num">{label ?? 'cite'}</span>
    {citation.profile_field && (
      <span class="cite-field">{citation.profile_field}</span>
    )}
    <svg class="cite-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9" /></svg>
  </summary>
  <div class="cite-body">
    {quote ? (
      <blockquote class="cite-quote">“{quote}”</blockquote>
    ) : (
      <p class="cite-missing">Quote not available offline.</p>
    )}
    {truncatedRef && (
      <div class="cite-ref" title={citation.evidence_ref}>{truncatedRef}</div>
    )}
  </div>
</details>

<style>
  .cite-fn {
    display: block;
    border: 1px solid rgb(139 92 246 / 0.22);
    border-radius: 0.5rem;
    background: rgb(139 92 246 / 0.05);
    overflow: hidden;
  }
  .cite-summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    list-style: none;
    padding: 0.4rem 0.65rem;
    font-size: 0.75rem;
    transition: background 0.15s ease;
  }
  .cite-summary::-webkit-details-marker { display: none; }
  .cite-summary:hover { background: rgb(139 92 246 / 0.1); }
  .cite-num {
    font-family: ui-monospace, monospace;
    font-size: 0.65rem;
    color: rgb(196 181 253);
    flex-shrink: 0;
  }
  .cite-field {
    font-family: ui-monospace, monospace;
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgb(148 163 184);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cite-caret {
    width: 0.85rem;
    height: 0.85rem;
    margin-left: auto;
    flex-shrink: 0;
    color: rgb(148 163 184);
    transition: transform 0.15s ease;
  }
  .cite-fn[open] .cite-caret { transform: rotate(180deg); }

  /* Expanded body renders IN FLOW (opaque, no absolute positioning) so it
     never overlaps the prose or other open footnotes. */
  .cite-body {
    padding: 0 0.65rem 0.6rem;
    border-top: 1px solid rgb(139 92 246 / 0.15);
    padding-top: 0.55rem;
  }
  .cite-quote {
    border-left: 2px solid rgb(139 92 246 / 0.6);
    padding-left: 0.75rem;
    font-style: italic;
    font-size: 0.78rem;
    line-height: 1.5;
    color: rgb(226 232 240);
  }
  .cite-missing {
    font-style: italic;
    font-size: 0.78rem;
    color: rgb(148 163 184);
  }
  .cite-ref {
    margin-top: 0.5rem;
    font-family: ui-monospace, monospace;
    font-size: 0.625rem;
    color: rgb(100 116 139);
  }
</style>
