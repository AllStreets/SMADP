---
import type { Citation } from '../data/types';
import { getEvidenceQuote } from '../data/catalog';

interface Props {
  citation: Citation;
  /** Visible inline reference label (e.g. "[1]"). */
  label?: string;
}

const { citation, label } = Astro.props;

// Try to resolve the actual quote text from the evidence store; fall back to inline.
let quote = citation.quote;
if (!quote && citation.evidence_ref) {
  quote = getEvidenceQuote(citation.evidence_ref);
}

const truncatedRef = citation.evidence_ref
  ? citation.evidence_ref.replace(/^sha256:/, 'sha256:').slice(0, 19) + '…'
  : null;
---

<details class="citation group inline align-baseline">
  <summary
    class="cursor-pointer list-none rounded border border-brand-500/30 bg-brand-500/10 px-1.5 py-0.5 font-mono text-[10px] text-brand-300 transition hover:bg-brand-500/20 hover:text-white"
    title={quote ? quote : 'Citation'}
  >
    {label ?? 'cite'}
  </summary>
  <div
    class="absolute z-30 mt-2 w-80 max-w-[90vw] rounded-lg border border-brand-500/30 bg-ink-900/95 p-3 text-xs shadow-glow backdrop-blur"
  >
    {citation.profile_field && (
      <div class="mb-1 font-mono text-[10px] uppercase tracking-wider text-brand-300">
        from {citation.profile_field}
      </div>
    )}
    {quote ? (
      <blockquote class="border-l-2 border-brand-500/60 pl-3 text-ink-100 italic">
        “{quote}”
      </blockquote>
    ) : (
      <p class="text-ink-300 italic">Quote not available offline.</p>
    )}
    {truncatedRef && (
      <div class="mt-2 font-mono text-[10px] text-ink-500" title={citation.evidence_ref}>
        {truncatedRef}
      </div>
    )}
  </div>
</details>

<style>
  .citation { position: relative; }
  .citation > div { display: none; }
  .citation[open] > div { display: block; }
</style>
