---
const links = [
  { href: '/agents', label: 'Agents' },
  { href: '/matrix', label: 'Matrix' },
  { href: '/verdicts', label: 'Verdicts' },
  { href: '/risks', label: 'Risks' },
  { href: '/frameworks', label: 'Frameworks' },
  { href: '/methodology', label: 'Methodology' },
  { href: '/chronicle', label: 'Chronicle' },
];

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-white/5 bg-ink-950/80 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a href="/" class="group flex items-center gap-2.5">
      <span class="relative inline-flex h-7 w-7 items-center justify-center">
        <span class="absolute inset-0 rounded-md bg-brand-600 blur-md opacity-50 transition group-hover:opacity-80"></span>
        <svg viewBox="0 0 64 64" class="relative h-7 w-7" aria-hidden="true">
          <defs>
            <linearGradient id="navg" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#A78BFA"/>
              <stop offset="1" stop-color="#7C3AED"/>
            </linearGradient>
          </defs>
          <path d="M32 4 L56 14 V32 C56 46 45 56 32 60 C19 56 8 46 8 32 V14 Z" fill="url(#navg)"/>
          <path d="M22 32 l8 8 l14 -16" stroke="#0B0712" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </span>
      <span class="font-mono text-sm font-bold tracking-[0.2em] text-ink-100">SMADP</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm">
        {
          links.map((l) => {
            const isActive = here === l.href || here.startsWith(l.href + '/');
            return (
              <li>
                <a
                  href={l.href}
                  class:list={[
                    'rounded-md px-3 py-1.5 transition-colors',
                    isActive
                      ? 'text-white bg-white/5 shadow-glow-sm'
                      : 'text-ink-300 hover:text-white hover:bg-white/5',
                  ]}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {l.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href="/search" class="hidden sm:inline-flex btn-ghost px-3 py-1.5 text-xs">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
        <span>Search</span>
        <kbd class="ml-1 rounded border border-white/10 bg-white/5 px-1.5 py-0.5 font-mono text-[10px] text-ink-400">/</kbd>
      </a>
      <a href="/submit" class="btn-primary px-3 py-1.5 text-xs">Submit agent</a>
    </div>
  </div>

  <!-- Mobile nav strip -->
  <nav aria-label="Primary mobile" class="md:hidden border-t border-white/5">
    <ul class="container-page flex items-center gap-1 overflow-x-auto py-2 text-xs scrollbar-thin">
      {
        links.map((l) => {
          const isActive = here === l.href || here.startsWith(l.href + '/');
          return (
            <li class="shrink-0">
              <a
                href={l.href}
                class:list={[
                  'rounded-md px-2.5 py-1 transition-colors',
                  isActive ? 'bg-white/5 text-white' : 'text-ink-300 hover:bg-white/5 hover:text-white',
                ]}
              >
                {l.label}
              </a>
            </li>
          );
        })
      }
    </ul>
  </nav>
</header>

<script>
  // "/" focuses search link
  document.addEventListener('keydown', (e) => {
    if (
      e.key === '/' &&
      !['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement)?.tagName)
    ) {
      e.preventDefault();
      window.location.href = '/search';
    }
  });
</script>
