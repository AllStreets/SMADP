---
import Icon from './Icon.astro';
import PersonaSwitcher from './PersonaSwitcher.astro';
import SessionBadge from './SessionBadge.astro';

type Leaf = { href: string; label: string; hint?: string };
type Group = { id: string; label: string; items: Leaf[] };

const home: Leaf = { href: '/home', label: 'Home' };

const groups: Group[] = [
  {
    id: 'catalog',
    label: 'Catalog',
    items: [
      { href: '/agents', label: 'Agents', hint: 'Profiles, capabilities, evidence' },
      { href: '/chains', label: 'Chains', hint: '3+-agent compositions' },
      { href: '/matrix', label: 'Compatibility matrix', hint: 'Agent × control coverage' },
      { href: '/verdicts', label: 'Verdicts', hint: 'Pairwise judgements' },
      { href: '/risks', label: 'Risks', hint: 'Taxonomy & severity' },
    ],
  },
  {
    id: 'compliance',
    label: 'Compliance',
    items: [
      { href: '/frameworks', label: 'Frameworks', hint: 'NIST, ISO, EU AI Act, …' },
      { href: '/workspaces', label: 'Workspaces', hint: 'Tenant dashboards' },
      { href: '/chronicle', label: 'Chronicle', hint: 'Append-only audit log' },
    ],
  },
  {
    id: 'docs',
    label: 'Docs',
    items: [
      { href: '/methodology', label: 'Methodology', hint: 'How verdicts are produced' },
      { href: '/submit', label: 'Submit agent', hint: 'Add a new profile' },
    ],
  },
];

const here = Astro.url.pathname.replace(/\/$/, '') || '/';
const isLeafActive = (href: string) => here === href || here.startsWith(href + '/');
const isGroupActive = (g: Group) => g.items.some((l) => isLeafActive(l.href));
---

<header class="sticky top-0 z-40 border-b border-white/5 bg-ink-950/80 backdrop-blur-md">
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a href="/" class="group flex items-center gap-2.5">
      <span class="relative inline-flex h-7 w-7 items-center justify-center">
        <span class="absolute inset-0 rounded-md bg-brand-600 blur-md opacity-50 transition group-hover:opacity-80"></span>
        <svg viewBox="0 0 64 64" class="relative h-7 w-7" aria-hidden="true">
          <defs>
            <linearGradient id="navg" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#A78BFA"/>
              <stop offset="1" stop-color="#7C3AED"/>
            </linearGradient>
          </defs>
          <path d="M32 4 L56 14 V32 C56 46 45 56 32 60 C19 56 8 46 8 32 V14 Z" fill="url(#navg)"/>
          <path d="M22 32 l8 8 l14 -16" stroke="#0B0712" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        </svg>
      </span>
      <span class="font-mono text-sm font-bold tracking-[0.2em] text-ink-100">SMADP</span>
    </a>

    <nav aria-label="Primary" class="hidden md:block">
      <ul class="flex items-center gap-1 text-sm">
        <li>
          <a
            href={home.href}
            class:list={[
              'rounded-md px-3 py-1.5 transition-colors',
              isLeafActive(home.href)
                ? 'text-white bg-white/5 shadow-glow-sm'
                : 'text-ink-300 hover:text-white hover:bg-white/5',
            ]}
            aria-current={isLeafActive(home.href) ? 'page' : undefined}
          >
            {home.label}
          </a>
        </li>
        {
          groups.map((g) => {
            const active = isGroupActive(g);
            return (
              <li class="relative" data-nav-group={g.id}>
                <button
                  type="button"
                  class:list={[
                    'inline-flex items-center gap-1 rounded-md px-3 py-1.5 transition-colors',
                    active
                      ? 'text-white bg-white/5 shadow-glow-sm'
                      : 'text-ink-300 hover:text-white hover:bg-white/5',
                  ]}
                  aria-haspopup="true"
                  aria-expanded="false"
                  data-nav-trigger={g.id}
                  id={`nav-${g.id}-trigger`}
                >
                  <span>{g.label}</span>
                  <Icon name="chevron-down" size={14} class="text-current transition-transform" />
                </button>
                <div
                  role="menu"
                  aria-labelledby={`nav-${g.id}-trigger`}
                  data-nav-panel={g.id}
                  class="invisible absolute left-0 top-full z-50 mt-1 w-72 origin-top-left scale-95 rounded-lg border border-white/10 bg-ink-900/95 p-1.5 opacity-0 shadow-xl backdrop-blur-md transition-all duration-100"
                >
                  <ul class="space-y-0.5">
                    {
                      g.items.map((l) => (
                        <li>
                          <a
                            href={l.href}
                            role="menuitem"
                            class:list={[
                              'flex flex-col rounded-md px-3 py-2 text-sm transition-colors',
                              isLeafActive(l.href)
                                ? 'bg-brand-600/10 text-white ring-1 ring-inset ring-brand-500/30'
                                : 'text-ink-200 hover:bg-white/5 hover:text-white',
                            ]}
                          >
                            <span class="font-medium">{l.label}</span>
                            {l.hint && (
                              <span class="text-xs text-ink-400">{l.hint}</span>
                            )}
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <SessionBadge />
      <PersonaSwitcher />
      <a href="/search" class="hidden sm:inline-flex btn-ghost px-3 py-1.5 text-xs">
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
        <span>Search</span>
        <kbd class="ml-1 rounded border border-white/10 bg-white/5 px-1.5 py-0.5 font-mono text-[10px] text-ink-400">/</kbd>
      </a>
      <a href="/submit" class="btn-primary px-3 py-1.5 text-xs">Submit agent</a>
    </div>
  </div>

  <!-- Mobile nav: native accordion sections -->
  <nav aria-label="Primary mobile" class="md:hidden border-t border-white/5">
    <div class="container-page py-2">
      <a
        href={home.href}
        class:list={[
          'block rounded-md px-3 py-2 text-sm transition-colors',
          isLeafActive(home.href)
            ? 'bg-white/5 text-white'
            : 'text-ink-200 hover:bg-white/5 hover:text-white',
        ]}
      >
        {home.label}
      </a>
      {
        groups.map((g) => {
          const active = isGroupActive(g);
          return (
            <details class="group/m mt-1" open={active ? '' : undefined}>
              <summary
                class:list={[
                  'flex cursor-pointer list-none items-center justify-between rounded-md px-3 py-2 text-sm transition-colors',
                  active ? 'text-white bg-white/5' : 'text-ink-300 hover:text-white hover:bg-white/5',
                ]}
              >
                <span>{g.label}</span>
                <Icon
                  name="chevron-down"
                  size={14}
                  class="text-current transition-transform group-open/m:rotate-180"
                />
              </summary>
              <ul class="mt-1 space-y-0.5 pl-3">
                {
                  g.items.map((l) => (
                    <li>
                      <a
                        href={l.href}
                        class:list={[
                          'block rounded-md px-3 py-1.5 text-xs transition-colors',
                          isLeafActive(l.href)
                            ? 'bg-brand-600/10 text-white ring-1 ring-inset ring-brand-500/30'
                            : 'text-ink-300 hover:bg-white/5 hover:text-white',
                        ]}
                      >
                        {l.label}
                      </a>
                    </li>
                  ))
                }
              </ul>
            </details>
          );
        })
      }
    </div>
  </nav>
</header>

<script>
  // "/" focuses search link
  document.addEventListener('keydown', (e) => {
    if (
      e.key === '/' &&
      !['INPUT', 'TEXTAREA', 'SELECT'].includes((e.target as HTMLElement)?.tagName)
    ) {
      e.preventDefault();
      window.location.href = '/search';
    }
  });

  // Desktop dropdown menus: click to open, click-outside / Esc to close, single-open at a time.
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-nav-trigger]'),
  );
  const panels = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLElement>('[data-nav-panel]').forEach((el) => {
    const id = el.dataset.navPanel;
    if (id) panels.set(id, el);
  });

  function setOpen(id: string, open: boolean) {
    const trigger = triggers.find((t) => t.dataset.navTrigger === id);
    const panel = panels.get(id);
    if (!trigger || !panel) return;
    trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) {
      panel.classList.remove('invisible', 'opacity-0', 'scale-95');
      panel.classList.add('visible', 'opacity-100', 'scale-100');
    } else {
      panel.classList.add('invisible', 'opacity-0', 'scale-95');
      panel.classList.remove('visible', 'opacity-100', 'scale-100');
    }
  }

  function closeAll(except?: string) {
    triggers.forEach((t) => {
      const id = t.dataset.navTrigger!;
      if (id !== except) setOpen(id, false);
    });
  }

  triggers.forEach((trigger) => {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const id = trigger.dataset.navTrigger!;
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      closeAll(id);
      setOpen(id, !isOpen);
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('[data-nav-group]')) return;
    closeAll();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeAll();
  });
</script>
