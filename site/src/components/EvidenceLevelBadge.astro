---
import { evidenceLevelColor } from '../data/catalog';
import type { EvidenceLevel } from '../data/types';

interface Props {
  level: EvidenceLevel;
  size?: 'sm' | 'md';
}

const { level, size = 'sm' } = Astro.props;
const color = evidenceLevelColor(level);

const labels: Record<EvidenceLevel, string> = {
  'unverified-profile': 'unverified',
  'docs-only': 'docs-only',
  'behavior-observed': 'behavior-observed',
  'profile-verified': 'profile-verified',
  'sandbox-validated': 'sandbox-validated',
};

const cls = size === 'sm'
  ? 'px-2 py-0.5 text-[10px]'
  : 'px-2.5 py-1 text-xs';
---

<span
  class={`inline-flex items-center gap-1.5 rounded-full border font-mono uppercase tracking-wider ${cls}`}
  style={`color:${color}; border-color:${color}55; background:${color}15;`}
  title={`Evidence level: ${labels[level]}`}
>
  <span class="h-1.5 w-1.5 rounded-full" style={`background:${color}; box-shadow:0 0 8px ${color}80;`}></span>
  {labels[level]}
</span>
