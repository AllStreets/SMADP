---
const year = new Date().getFullYear();
const cols: { title: string; links: { href: string; label: string }[] }[] = [
  {
    title: 'Catalog',
    links: [
      { href: '/agents', label: 'Browse agents' },
      { href: '/risk-atlas', label: 'Risk Atlas' },
      { href: '/verdicts', label: 'All verdicts' },
      { href: '/search', label: 'Search' },
    ],
  },
  {
    title: 'Methodology',
    links: [
      { href: '/methodology', label: 'How verdicts are produced' },
      { href: '/risks', label: 'Risk taxonomy' },
      { href: '/frameworks', label: 'Framework mappings' },
      { href: '/chronicle', label: 'Chronicle (audit log)' },
    ],
  },
  {
    title: 'Project',
    links: [
      { href: 'https://github.com/AllStreets/SMADP', label: 'GitHub repo' },
      { href: '/submit', label: 'Submit an agent' },
      { href: '/methodology#evidence-policy', label: 'Evidence policy' },
      { href: '/methodology#scoring', label: 'Composite scoring' },
    ],
  },
];
---

<footer class="border-t border-white/5 bg-ink-950/60">
  <div class="container-page py-14">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <div class="flex items-center gap-2.5">
          <svg viewBox="0 0 64 64" class="h-6 w-6" aria-hidden="true">
            <defs>
              <linearGradient id="footerg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#A78BFA"/>
                <stop offset="1" stop-color="#7C3AED"/>
              </linearGradient>
            </defs>
            <path d="M32 4 L56 14 V32 C56 46 45 56 32 60 C19 56 8 46 8 32 V14 Z" fill="url(#footerg)"/>
            <path d="M22 32 l8 8 l14 -16" stroke="#0B0712" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <span class="font-mono text-sm font-bold tracking-[0.2em] text-ink-100">SMADP</span>
        </div>
        <p class="mt-4 max-w-md text-sm leading-relaxed text-ink-400">
          Safe Multi-Agent Deployment Platform. Auditable, evidence-cited verdicts on
          whether two autonomous agents can safely run together. Apache-2.0. Catalog is publicly
          redistributable.
        </p>
      </div>

      {
        cols.map((c) => (
          <div class="md:col-span-2">
            <h4 class="heading-eyebrow mb-4">{c.title}</h4>
            <ul class="space-y-2.5 text-sm">
              {c.links.map((l) => (
                <li>
                  <a class="link-quiet" href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="md:col-span-1 md:text-right">
        <h4 class="heading-eyebrow mb-4 md:text-right">Sibling</h4>
        <a class="link-quiet text-sm" href="https://github.com/AllStreets/ONEXUS">NEXUS</a>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-white/5 pt-6 text-xs text-ink-500 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} SMADP contributors. Apache-2.0.</p>
      <p class="font-mono">
        catalog · git-backed · <span class="text-brand-400">evidence-first</span>
      </p>
    </div>
  </div>
</footer>
