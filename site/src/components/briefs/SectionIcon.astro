---
interface Props {
  name: string;
  size?: number;
  class?: string;
}
const { name, size = 18, class: cls = '' } = Astro.props;
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={`section-icon ${cls}`}
>
  {name === 'question' && (<>
    <circle cx="12" cy="12" r="9" />
    <path d="M9.5 9a2.5 2.5 0 1 1 4.5 1.6c-1 .8-1.5 1.2-1.5 2.4" />
    <circle cx="12" cy="17.2" r=".6" fill="currentColor" stroke="none" />
  </>)}
  {name === 'methodology' && (<>
    <path d="M3 6h18" />
    <path d="M3 12h13" />
    <path d="M3 18h16" />
    <circle cx="20" cy="6" r="1.4" fill="currentColor" stroke="none" />
    <circle cx="18" cy="12" r="1.4" fill="currentColor" stroke="none" />
    <circle cx="21" cy="18" r="1.4" fill="currentColor" stroke="none" />
  </>)}
  {name === 'taxonomy' && (<>
    <rect x="3.5" y="3.5" width="6.5" height="6.5" />
    <rect x="14" y="3.5" width="6.5" height="6.5" />
    <rect x="3.5" y="14" width="6.5" height="6.5" />
    <rect x="14" y="14" width="6.5" height="6.5" />
  </>)}
  {name === 'finding' && (<>
    <path d="M5 3v18" />
    <path d="M5 3l12 2.5L13 11l4 5L5 14" />
  </>)}
  {name === 'limits' && (<>
    <path d="M3 7V4h3" />
    <path d="M18 4h3v3" />
    <path d="M3 17v3h3" />
    <path d="M18 20h3v-3" />
    <path d="M8 12h8" />
  </>)}
  {name === 'next' && (<>
    <circle cx="12" cy="12" r="9" />
    <path d="M9 8l5 4-5 4" />
  </>)}
  {name === 'evidence' && (<>
    <rect x="4" y="3" width="13" height="17" rx="1" />
    <path d="M7 3v17M20 7v14H7" />
    <path d="M10 9h6M10 13h6M10 17h4" />
  </>)}
  {name === 'citations' && (<>
    <path d="M6 6h4v4c0 2-1 3-3 3" />
    <path d="M14 6h4v4c0 2-1 3-3 3" />
    <path d="M5 19h14" />
  </>)}
  {name === 'framework' && (<>
    <circle cx="6" cy="6" r="2.2" />
    <circle cx="18" cy="6" r="2.2" />
    <circle cx="12" cy="18" r="2.2" />
    <path d="M7.5 7.5l3 8.5M16.5 7.5l-3 8.5M8 6h8" />
  </>)}
  {name === 'upstream' && (<>
    <path d="M12 20V5" />
    <path d="M6 11l6-6 6 6" />
    <path d="M5 21h14" />
  </>)}
  {name === 'reproducibility' && (<>
    <circle cx="12" cy="12" r="9" />
    <path d="M12 7v5l3 2" />
  </>)}
  {name === 'sandbox' && (<>
    <path d="M3 7l9-4 9 4-9 4z" />
    <path d="M3 7v10l9 4 9-4V7" />
    <path d="M12 11v10" />
  </>)}
  {name === 'pairwise' && (<>
    <circle cx="9.5" cy="12" r="5" />
    <circle cx="14.5" cy="12" r="5" />
  </>)}
  {name === 'headline' && (<>
    <circle cx="12" cy="12" r="9" />
    <circle cx="12" cy="12" r="4.5" />
    <circle cx="12" cy="12" r=".8" fill="currentColor" stroke="none" />
  </>)}
  {name === 'highrisk' && (<>
    <path d="M12 3L2 21h20z" />
    <path d="M12 10v5" />
    <circle cx="12" cy="18" r=".8" fill="currentColor" stroke="none" />
  </>)}
  {name === 'closed' && (<>
    <rect x="5" y="11" width="14" height="10" rx="1" />
    <path d="M8 11V7a4 4 0 0 1 8 0v4" />
  </>)}
  {name === 'open' && (<>
    <rect x="5" y="11" width="14" height="10" rx="1" />
    <path d="M8 11V7a4 4 0 0 1 7-1.3" />
  </>)}
  {name === 'register' && (<>
    <path d="M4 6h16" />
    <path d="M4 12h16" />
    <path d="M4 18h16" />
    <circle cx="2.5" cy="6" r=".8" fill="currentColor" stroke="none" />
    <circle cx="2.5" cy="12" r=".8" fill="currentColor" stroke="none" />
    <circle cx="2.5" cy="18" r=".8" fill="currentColor" stroke="none" />
  </>)}
  {name === 'thesis' && (<>
    <path d="M5 4h10l4 4v12H5z" />
    <path d="M15 4v4h4" />
    <path d="M9 13h6M9 17h4" />
  </>)}
  {name === 'why' && (<>
    <circle cx="12" cy="12" r="9" />
    <path d="M12 8v4" />
    <circle cx="12" cy="16" r=".8" fill="currentColor" stroke="none" />
  </>)}
  {name === 'ask' && (<>
    <path d="M4 5h12l4 4v10H4z" />
    <path d="M8 12h8M8 16h5" />
  </>)}
  {name === 'severity' && (<>
    <path d="M5 16c2-4 4-4 6 0s4 4 6-2" />
    <path d="M3 21h18" />
    <path d="M12 4v3" />
  </>)}
  {name === 'pipeline' && (<>
    <circle cx="5" cy="12" r="2" />
    <circle cx="19" cy="12" r="2" />
    <path d="M7 12h3" />
    <path d="M14 12h3" />
    <rect x="10" y="8" width="4" height="8" />
  </>)}
  {(name === 'default' || !['question','methodology','taxonomy','finding','limits','next','evidence','citations','framework','upstream','reproducibility','sandbox','pairwise','headline','highrisk','closed','open','register','thesis','why','ask','severity','pipeline'].includes(name)) && (<>
    <circle cx="12" cy="12" r="2" />
    <circle cx="12" cy="12" r="8" />
  </>)}
</svg>

<style>
  .section-icon {
    display: inline-block;
    vertical-align: -2px;
    flex-shrink: 0;
  }
</style>
