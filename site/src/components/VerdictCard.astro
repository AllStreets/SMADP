---
import type { Verdict } from '../data/types';
import { compositeColor, getProfile, severityColor } from '../data/catalog';
import EvidenceLevelBadge from './EvidenceLevelBadge.astro';
import RiskBadge from './RiskBadge.astro';

interface Props {
  verdict: Verdict;
}

const { verdict } = Astro.props;
const a = getProfile(verdict.pair[0]);
const b = getProfile(verdict.pair[1]);
const aName = a?.name ?? verdict.pair[0];
const bName = b?.name ?? verdict.pair[1];
const score = verdict.composite_score;
const scoreColor = compositeColor(score);

const riskKeys = [
  'A_prompt_injection',
  'B_data_leakage',
  'C_capability_conflict',
  'D_cascading_error',
  'E_compliance',
] as const;
---

<a
  href={`/verdicts/${verdict.verdict_id}`}
  class="card card-hover group block"
>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="flex items-center gap-2 text-sm">
        <span class="font-display font-semibold text-white truncate">{aName}</span>
        <span class="text-ink-500">×</span>
        <span class="font-display font-semibold text-white truncate">{bName}</span>
      </div>
      <p class="mt-2 line-clamp-2 text-sm text-ink-300">{verdict.headline}</p>
    </div>

    <div class="shrink-0 text-right">
      <div
        class="font-mono text-2xl font-bold leading-none"
        style={`color:${scoreColor};`}
        title={`Composite score: ${score.toFixed(2)} (lower is safer)`}
      >
        {score.toFixed(2)}
      </div>
      <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-ink-500">composite</div>
    </div>
  </div>

  <div class="mt-4 flex items-center gap-3">
    <div class="flex items-center gap-1.5">
      {
        riskKeys.map((rk) => {
          const sev = verdict.sub_verdicts[rk]?.severity ?? 'none';
          const c = severityColor(sev);
          return (
            <span class="relative">
              <RiskBadge risk={rk} />
              <span
                class="absolute -bottom-0.5 -right-0.5 h-2 w-2 rounded-full ring-2 ring-ink-900"
                style={`background:${c};`}
                title={`${rk}: ${sev}`}
              ></span>
            </span>
          );
        })
      }
    </div>
  </div>

  <div class="mt-4 flex items-center justify-between text-xs text-ink-500">
    <EvidenceLevelBadge level={verdict.evidence_level} />
    <span class="font-mono">{verdict.generated_at.slice(0, 10)}</span>
  </div>
</a>
