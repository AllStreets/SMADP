{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"],
      "@data/*": ["src/data/*"]
    },
    "types": ["astro/client", "node"]
  },
  "include": ["src/**/*", "astro.config.mjs", "tailwind.config.ts"],
  "exclude": ["dist", "node_modules"]
}
