---
interface Props { slug: string; label?: string }
const { slug, label = 'Download PDF' } = Astro.props;
const filename = `SMADP-${slug.charAt(0).toUpperCase()}${slug.slice(1)}.pdf`;
---
<a
  class="export-button no-print"
  href={`/${slug}.pdf`}
  download={filename}
>
  {label}
</a>

<style>
  .export-button {
    display: inline-block;
    border: 1px solid var(--ink-navy);
    background: var(--ink-navy);
    color: var(--cream);
    padding: 8px 16px;
    font-family: inherit;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    border-radius: 0;
  }
  .export-button:hover { background: #051430; }
</style>
