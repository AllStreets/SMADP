---
import MemoLayout from '@/components/MemoLayout.astro';
import { loadPendingVerdicts } from '@/lib/catalog';

const pending = loadPendingVerdicts();
---
<MemoLayout pageTitle="SMADP · Pending verdicts" layoutName="SMADP">
  <div class="pending-page">
    <header class="page-head">
      <div class="container">
        <div class="ph-eyebrow">
          <span class="ph-mark">[ Pending · Autopilot review queue ]</span>
          <span class="ph-dot" aria-hidden="true">·</span>
          <span>{pending.length} awaiting approval</span>
        </div>
        <h1 class="ph-title">Pending verdicts</h1>
        <p class="ph-lede">
          First-time agent-combination verdicts awaiting review. To publish, run
          <code>smadp autopilot approve &lt;key&gt;</code>.
        </p>
      </div>
    </header>

    <section class="container pending-body">
      {pending.length === 0 ? (
        <p class="empty">No pending verdicts. The autopilot is caught up.</p>
      ) : (
        <table class="pending-table">
          <thead>
            <tr>
              <th>Key</th>
              <th>Scenario</th>
              <th>Participants</th>
              <th>Verdict</th>
            </tr>
          </thead>
          <tbody>
            {pending.map((v) => (
              <tr>
                <td><code>{v.participants.join('__')}</code></td>
                <td>{v.headline}</td>
                <td>{v.participants.join(' → ')}</td>
                <td>{v.evidence_level}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </section>
  </div>
</MemoLayout>

<style>
  .pending-page {
    background: var(--ink-navy);
    color: var(--cream);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: calc(100vh - 80px);
  }
  .pending-page::before {
    content: ""; position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(245,233,204,0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(245,233,204,0.035) 1px, transparent 1px);
    background-size: 64px 64px;
  }
  .pending-page > * { position: relative; z-index: 1; }

  .page-head { padding: 72px 0 30px; }
  .ph-eyebrow {
    display: flex; gap: 14px; align-items: center; flex-wrap: wrap;
    font-family: var(--font-mono); font-size: 10.5px; letter-spacing: 0.22em;
    color: var(--gold); text-transform: uppercase;
  }
  .ph-eyebrow > :not(.ph-mark) { color: var(--cream-soft); letter-spacing: 0.16em; }
  .ph-dot { opacity: 0.55; }
  .ph-title {
    font-family: "Iowan Old Style", "Palatino", "Georgia", serif;
    font-weight: 500;
    font-size: clamp(38px, 5.4vw, 76px);
    letter-spacing: -0.02em;
    line-height: 1.02;
    color: var(--cream);
    margin: 22px 0 14px;
    max-width: 16ch;
  }
  .ph-lede {
    color: var(--cream-soft);
    font-size: clamp(14px, 1.2vw, 17px);
    line-height: 1.6;
    max-width: 72ch;
    margin: 0 0 12px;
  }
  .ph-lede code {
    background: rgba(245,233,204,0.10);
    color: var(--cream);
    padding: 1px 6px;
    font-family: var(--font-mono);
    font-size: 0.9em;
  }

  .pending-body { padding: 28px 0 88px; }

  .empty {
    padding: 40px 28px;
    border: 1px dashed rgba(245,233,204,0.20);
    text-align: center;
    color: var(--cream-soft);
    font-family: var(--font-mono);
    font-size: 12.5px;
    letter-spacing: 0.10em;
  }

  .pending-table {
    width: 100%;
    border-collapse: collapse;
    background: rgba(245,233,204,0.04);
    border: 1px solid rgba(245,233,204,0.10);
  }
  .pending-table th,
  .pending-table td {
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(245,233,204,0.08);
    font-size: 13px;
    color: var(--cream-soft);
  }
  .pending-table th {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    background: rgba(11,27,58,0.55);
  }
  .pending-table td code {
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--cream);
    background: rgba(245,233,204,0.06);
    padding: 1px 6px;
  }
  .pending-table tr:last-child td { border-bottom: none; }
</style>
