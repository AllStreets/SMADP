---
import MemoLayout from '@/components/MemoLayout.astro';
import { loadVerdicts, loadProfiles } from '@/lib/catalog';
import { groupByEvidenceTier, rankByComposite, topAgentsByAppearance } from '@/lib/aggregations';
import { RISK_KEYS } from '@/lib/types';

const verdicts = loadVerdicts();
const profiles = loadProfiles();
const groups = groupByEvidenceTier(verdicts);
const ranked = rankByComposite(verdicts);
const featured = groups.sandbox[0] ?? ranked[0];
const topAgents = topAgentsByAppearance(verdicts, 18);

const stats = [
  { value: profiles.length, label: 'Agents profiled',     accent: false },
  { value: verdicts.length, label: 'Pair verdicts',        accent: false },
  { value: groups.sandbox.length, label: 'Sandbox-validated', accent: true  },
  { value: 5,               label: 'Risk dimensions',      accent: false }
];

const dimensions = [
  { letter: 'A', name: 'Prompt injection',    color: 'var(--dim-a)', tagline: 'Adversarial writes flowing into prompts.' },
  { letter: 'B', name: 'Data leakage',        color: 'var(--dim-b)', tagline: 'Confidential context across trust boundaries.' },
  { letter: 'C', name: 'Capability conflict', color: 'var(--dim-c)', tagline: 'Permissions composing into ones never granted.' },
  { letter: 'D', name: 'Cascading error',     color: 'var(--dim-d)', tagline: "One agent's mistake becoming another's truth." },
  { letter: 'E', name: 'Compliance',          color: 'var(--dim-e)', tagline: 'Pairs that breach what the parts alone would respect.' }
];

const method = [
  { n: '01', name: 'Catalogue',   detail: 'Profile every agent: capabilities, surfaces, evidence tier.' },
  { n: '02', name: 'Compose',     detail: 'Pair agents; bind by required capabilities to each role.' },
  { n: '03', name: 'Sandbox',     detail: 'Run scripted scenarios inside an isolated, image-pinned container.' },
  { n: '04', name: 'Adjudicate',  detail: 'Grade transcripts against the five-dimension rubric. Cite by sha256.' }
];

const layouts = [
  {
    n: '01',
    name: 'Brief',
    href: '/brief',
    pages: 10,
    read: '6 min',
    blurb: 'A linear narrative — thesis, methodology, headline findings, limits. Start here.',
    accent: 'cream',
    contents: ['§ 1  The question', '§ 3  Risk taxonomy', 'Exhibit 1  Severity heatmap', '§ 4  Headline finding']
  },
  {
    n: '02',
    name: 'Prospectus',
    href: '/prospectus',
    pages: 14,
    read: '10 min',
    blurb: 'Investment-bank format. Pitch up front; data appendix in back. For institutional readers who want both.',
    accent: 'navy',
    contents: ['Executive summary', '§ Why this matters', '§ Headline finding', 'Appendix A–H · receipts']
  },
  {
    n: '03',
    name: 'Dossier',
    href: '/dossier',
    pages: 16,
    read: '14 min',
    blurb: 'The complete file. Every risk dimension, every agent of note, every verdict on the books.',
    accent: 'gold',
    contents: ['§ 1  Thesis', '§ 4  Pairwise risk by dimension', '§ 8–9  Agent dossier (closed + open)', '§ 11  Full verdict register']
  }
];

const marqueeNames = [...topAgents, ...topAgents]; // doubled for seamless loop
---
<MemoLayout pageTitle="SMADP · Safe Multi-Agent Deployment Platform" layoutName="SMADP">

  <!-- HERO -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero-mesh" aria-hidden="true"></div>
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-eyebrow">
        <span class="hero-mark">[ S · M · A · D · P ]</span>
        <span class="hero-long">Safe Multi-Agent Deployment Platform</span>
        <span class="hero-dot" aria-hidden="true">·</span>
        <span class="hero-issue">Issue 01 · 2026.05</span>
      </div>
      <h1 id="hero-title" class="hero-title">
        <span class="hero-line line-1">When agents</span>
        <span class="hero-line line-2">work <em>together</em>,</span>
        <span class="hero-line line-3">do they stay <span class="hero-emph">safe</span>?</span>
      </h1>
      <p class="hero-dek">
        A sandbox-tested research catalogue of how AI coding agents behave when paired —
        and the precise seam where each one's safety guarantees start to crack.
      </p>
      <div class="hero-cta-row">
        <a class="cta-primary" href="/brief">Open the Brief <span class="arr">→</span></a>
        <a class="cta-ghost"   href="#methodology">How we test</a>
        <a class="cta-ghost"   href="#roadmap">What's coming</a>
      </div>
      <div class="hero-scroll" aria-hidden="true">
        <span class="hero-scroll-line"></span>
        <span class="hero-scroll-text">Scroll · {verdicts.length} verdicts on file</span>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <section class="marquee" aria-label="Agents in the catalogue">
    <div class="marquee-track">
      {marqueeNames.map((slug) => (
        <span class="marquee-item">
          <span class="marquee-dot" aria-hidden="true">●</span> {slug}
        </span>
      ))}
    </div>
  </section>

  <!-- STATS -->
  <section class="container section stats-section">
    <div class="stats-grid">
      {stats.map((s, i) => (
        <div class={`stat ${s.accent ? 'stat-accent' : ''}`} data-anim-stat={s.value} data-anim-index={i}>
          <div class="stat-num" data-count-to={s.value}>0</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- FEATURED FINDING -->
  <section class="container section featured-wrap">
    <div class="featured">
      <div class="featured-left">
        <div class="featured-tag">
          <span class="ft-pulse" aria-hidden="true"></span>
          {groups.sandbox.length > 0 ? 'Live · latest sandbox-validated finding' : 'Top-ranked finding'}
        </div>
        <h2 class="featured-h">
          <span class="featured-a">{featured.pair[0]}</span>
          <span class="featured-x" aria-hidden="true">×</span>
          <span class="featured-b">{featured.pair[1]}</span>
        </h2>
        <p class="featured-headline">{featured.headline}</p>
        <div class="featured-meta">
          <span class="evidence-stamp" data-tier={featured.evidence_level}>{featured.evidence_level}</span>
          <span class="composite">composite <strong>{featured.composite_score.toFixed(2)}</strong></span>
          <span class="composite">confidence <strong>{featured.confidence.toFixed(2)}</strong></span>
        </div>
      </div>
      <div class="featured-right">
        <div class="featured-tag gold">Risk fingerprint</div>
        <div class="fingerprint">
          {RISK_KEYS.map((k) => {
            const sev = featured.sub_verdicts[k].severity;
            return (
              <div class="fp-row">
                <span class="fp-letter">{k[0]}</span>
                <span class="fp-name">{k.split('_').slice(1).join(' ')}</span>
                <span class="fp-bar"><span class={`fp-fill sev-${sev}`}></span></span>
                <span class="fp-sev">{sev}</span>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- METHODOLOGY -->
  <section id="methodology" class="container section methodology-section" data-fade>
    <div class="section-head">
      <div class="eyebrow gold-eyebrow">§ Methodology</div>
      <h2 class="section-h">Every verdict comes off the same four-step assembly line.</h2>
    </div>
    <ol class="method-list">
      {method.map((m) => (
        <li class="method-step">
          <div class="ms-num">{m.n}</div>
          <div class="ms-body">
            <div class="ms-name">{m.name}</div>
            <p class="ms-detail">{m.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- DIMENSIONS -->
  <section class="container section dimensions-section" data-fade>
    <div class="section-head">
      <div class="eyebrow">Five dimensions</div>
      <h2 class="section-h">A pair fails in one of five ways. We grade every one.</h2>
    </div>
    <div class="dim-board">
      {dimensions.map((d) => (
        <div class="dim-cell">
          <div class="dim-letter" style={`color:${d.color}`}>{d.letter}</div>
          <div class="dim-meta">
            <div class="dim-name">{d.name}</div>
            <div class="dim-tag">{d.tagline}</div>
          </div>
          <div class="dim-rule" style={`background:${d.color}`} aria-hidden="true"></div>
        </div>
      ))}
    </div>
  </section>

  <!-- LAYOUTS PICKER (asymmetric editorial) -->
  <section class="container section picker-section" data-fade>
    <div class="section-head">
      <div class="eyebrow">Three takes · one dataset</div>
      <h2 class="section-h">Pick the read that matches your bandwidth.</h2>
      <p class="section-sub">Each layout is print-ready and exports as a self-contained PDF.</p>
    </div>
    <div class="picker-grid">
      {layouts.map((l, idx) => (
        <a class={`picker-card ${idx === 0 ? 'pc-feature' : 'pc-secondary'} accent-${l.accent}`} href={l.href}>
          <div class="pc-top">
            <div class="pc-num">{l.n}</div>
            <div class="pc-meta">
              <span>{l.pages} pp</span>
              <span class="pc-dot">·</span>
              <span>{l.read}</span>
            </div>
          </div>
          <div class="pc-name">{l.name}</div>
          <p class="pc-blurb">{l.blurb}</p>
          {idx === 0 && (
            <ul class="pc-toc">
              {l.contents.map((c) => <li>{c}</li>)}
            </ul>
          )}
          <div class="pc-cta">
            Open the {l.name} <span class="arr">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ROADMAP TEASER -->
  <section id="roadmap" class="roadmap-section" data-fade>
    <div class="container">
      <div class="roadmap-head">
        <div class="eyebrow gold-eyebrow">What's coming</div>
        <h2 class="roadmap-h">From a research catalogue to an autonomous cross-agent test field.</h2>
      </div>
      <ol class="roadmap-list">
        <li class="roadmap-item rmi-done">
          <span class="rmi-tag">Shipped</span>
          <span class="rmi-text">Three-layout research memo · catalogue at <code>catalog/</code> · sandbox harness.</span>
        </li>
        <li class="roadmap-item rmi-active">
          <span class="rmi-tag">Building</span>
          <span class="rmi-text">Autonomous cross-agent runner — pulls from ONEXUS-Agents, builds containers, queues every viable pairing.</span>
        </li>
        <li class="roadmap-item">
          <span class="rmi-tag">Next</span>
          <span class="rmi-text">Weekly market index · user-submitted agents · semantically-searchable catalogue.</span>
        </li>
        <li class="roadmap-item">
          <span class="rmi-tag">Later</span>
          <span class="rmi-text">Full audit export — every transcript, every rubric pass, every verdict, reproducible end-to-end.</span>
        </li>
      </ol>
    </div>
  </section>

  <!-- ABOUT -->
  <section class="container section about-section">
    <div class="about-grid">
      <div class="about-main">
        <div class="eyebrow">About</div>
        <h2 class="about-h"><span class="about-acronym">SMADP</span> — Safe Multi-Agent Deployment Platform</h2>
        <p>
          SMADP is a pair-level safety catalogue for AI coding agents. Where most agent
          evaluations grade one agent in isolation, SMADP grades <em>compositions</em> —
          what happens when two agents share a workspace, when one's output is another's
          input, when an agent reads files a sibling just wrote.
        </p>
        <p>
          Every verdict on this site carries an explicit evidence tier — sandbox,
          profile, or docs. The site never silently promotes one tier to another.
          Source data lives in <code>catalog/</code>; the methodology, rubric, and every
          transcript are checked in and reproducible.
        </p>
      </div>
      <aside class="about-side">
        <div class="eyebrow">Pointers</div>
        <ul class="about-links">
          <li><a href="/brief">Methodology — in the Brief</a></li>
          <li><a href="/dossier">Full verdict register — in the Dossier</a></li>
          <li><a href="https://github.com/AllStreets/ONEXUS-Agents">ONEXUS-Agents · sibling profile source</a></li>
        </ul>
      </aside>
    </div>
  </section>

</MemoLayout>

<script>
  // Count-up animation on stats when they enter the viewport
  const easeOut = (t: number) => 1 - Math.pow(1 - t, 3);
  const nums = document.querySelectorAll<HTMLElement>('[data-count-to]');
  const seen = new WeakSet<Element>();
  const numObs = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting || seen.has(e.target)) continue;
      seen.add(e.target);
      const el = e.target as HTMLElement;
      const target = parseInt(el.dataset.countTo ?? '0', 10);
      const duration = 1100;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        el.textContent = Math.round(easeOut(t) * target).toString();
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
  }, { threshold: 0.4 });
  nums.forEach((n) => numObs.observe(n));

  // Fade-up sections on scroll
  const fades = document.querySelectorAll<HTMLElement>('[data-fade]');
  const fadeObs = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('is-in');
        fadeObs.unobserve(e.target);
      }
    }
  }, { threshold: 0.12 });
  fades.forEach((f) => fadeObs.observe(f));
</script>

<style>
  /* ----------------------------- HERO ----------------------------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--ink-navy);
    color: var(--cream);
    isolation: isolate;
  }
  .hero-mesh {
    position: absolute; inset: 0; z-index: 0;
    background:
      radial-gradient(60% 70% at 18% 20%, rgba(201,165,92,0.28) 0%, transparent 60%),
      radial-gradient(50% 60% at 82% 75%, rgba(61,90,140,0.55)  0%, transparent 65%),
      radial-gradient(45% 55% at 60% 18%, rgba(168,53,31,0.20)  0%, transparent 65%),
      linear-gradient(135deg, #07142C 0%, #0B1B3A 55%, #122448 100%);
    animation: meshShift 18s ease-in-out infinite alternate;
    filter: saturate(1.05);
  }
  @keyframes meshShift {
    0%   { transform: translate3d(0,0,0) scale(1.00); }
    50%  { transform: translate3d(-2%, 1%, 0) scale(1.04); }
    100% { transform: translate3d(2%, -1%, 0) scale(1.02); }
  }
  .hero-grid {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(245,233,204,0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(245,233,204,0.045) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, rgba(0,0,0,1) 30%, rgba(0,0,0,0) 100%);
  }
  .hero-inner {
    position: relative; z-index: 2;
    padding: 112px 0 96px;
  }
  .hero-eyebrow {
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.22em;
    color: var(--gold);
    text-transform: uppercase;
  }
  .hero-mark   { color: var(--gold); }
  .hero-long   { color: var(--cream); letter-spacing: 0.16em; }
  .hero-dot    { color: var(--cream-soft); opacity: 0.6; }
  .hero-issue  { color: var(--cream-soft); }

  .hero-title {
    font-family: "Iowan Old Style", "Palatino", "Georgia", serif;
    font-weight: 500;
    font-size: clamp(48px, 7.6vw, 108px);
    line-height: 0.98;
    letter-spacing: -0.025em;
    color: var(--cream);
    margin: 28px 0 22px;
    max-width: 16ch;
  }
  .hero-title em {
    font-style: italic;
    color: var(--gold);
  }
  .hero-emph {
    background: linear-gradient(180deg, transparent 62%, rgba(201,165,92,0.45) 62%, rgba(201,165,92,0.45) 92%, transparent 92%);
    padding: 0 6px;
  }
  .hero-line { display: block; opacity: 0; transform: translateY(14px); animation: lineIn 0.7s cubic-bezier(.22,.61,.36,1) forwards; }
  .line-1 { animation-delay: 0.05s; }
  .line-2 { animation-delay: 0.18s; }
  .line-3 { animation-delay: 0.31s; }
  @keyframes lineIn { to { opacity: 1; transform: none; } }

  .hero-dek {
    max-width: 60ch;
    color: var(--cream-soft);
    font-size: clamp(15px, 1.4vw, 18px);
    line-height: 1.55;
    margin: 0 0 32px;
    opacity: 0; transform: translateY(10px);
    animation: lineIn 0.7s cubic-bezier(.22,.61,.36,1) 0.44s forwards;
  }

  .hero-cta-row {
    display: flex; gap: 14px; flex-wrap: wrap; align-items: center;
    opacity: 0; transform: translateY(10px);
    animation: lineIn 0.7s cubic-bezier(.22,.61,.36,1) 0.56s forwards;
  }
  .cta-primary, .cta-ghost {
    text-decoration: none;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 14px 22px;
    transition: transform 0.18s ease, background 0.18s ease, color 0.18s ease, border-color 0.18s ease;
    display: inline-flex; align-items: center; gap: 10px;
  }
  .cta-primary {
    background: var(--gold);
    color: var(--ink-navy);
    border: 1px solid var(--gold);
    font-weight: 600;
  }
  .cta-primary:hover { transform: translateY(-2px); background: #DCB872; border-color: #DCB872; }
  .cta-primary .arr { transition: transform 0.18s ease; }
  .cta-primary:hover .arr { transform: translateX(4px); }
  .cta-ghost {
    color: var(--cream);
    border: 1px solid rgba(245,233,204,0.30);
    background: transparent;
  }
  .cta-ghost:hover { border-color: var(--cream); background: rgba(245,233,204,0.06); }

  .hero-scroll {
    margin-top: 56px;
    display: flex; align-items: center; gap: 14px;
    color: var(--cream-soft);
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    opacity: 0;
    animation: lineIn 0.7s cubic-bezier(.22,.61,.36,1) 0.7s forwards;
  }
  .hero-scroll-line {
    display: inline-block;
    width: 44px; height: 1px;
    background: var(--gold);
    animation: scrollPulse 2.4s ease-in-out infinite;
  }
  @keyframes scrollPulse {
    0%, 100% { transform: scaleX(1); opacity: 1; }
    50%      { transform: scaleX(0.4); opacity: 0.55; }
  }

  /* ----------------------------- MARQUEE ----------------------------- */
  .marquee {
    background: var(--ink-navy);
    color: var(--cream-soft);
    border-top: 1px solid rgba(245,233,204,0.10);
    border-bottom: 1px solid rgba(245,233,204,0.10);
    overflow: hidden;
    padding: 12px 0;
  }
  .marquee-track {
    display: inline-flex; gap: 36px;
    white-space: nowrap;
    animation: marqueeRun 60s linear infinite;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    will-change: transform;
  }
  .marquee-item { display: inline-flex; align-items: center; gap: 10px; }
  .marquee-dot  { color: var(--gold); font-size: 7px; transform: translateY(-1px); }
  @keyframes marqueeRun { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  /* ----------------------------- STATS ----------------------------- */
  .stats-section { padding-top: 48px; padding-bottom: 12px; }
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .stat {
    padding: 30px 28px;
    border-right: 1px solid var(--rule);
    position: relative;
  }
  .stat:last-child { border-right: none; }
  .stat-num {
    font-family: "Iowan Old Style", "Palatino", "Georgia", serif;
    font-size: clamp(40px, 4.8vw, 64px);
    color: var(--ink-navy);
    letter-spacing: -0.025em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stat-accent .stat-num { color: var(--gold); }
  .stat-label {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-top: 10px;
  }
  .stat-accent::after {
    content: "";
    position: absolute; left: 28px; top: 22px;
    width: 6px; height: 6px;
    background: var(--gold);
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(201,165,92,0.55);
    animation: ftPulse 2.2s ease-out infinite;
  }
  @keyframes ftPulse {
    0%   { box-shadow: 0 0 0 0 rgba(201,165,92,0.55); }
    70%  { box-shadow: 0 0 0 10px rgba(201,165,92,0); }
    100% { box-shadow: 0 0 0 0 rgba(201,165,92,0); }
  }

  /* ----------------------------- FEATURED ----------------------------- */
  .featured-wrap { padding-top: 28px; }
  .featured {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 0;
    background: linear-gradient(135deg, #07142C 0%, var(--ink-navy) 60%, #182E5A 100%);
    color: var(--cream);
    border: 1px solid rgba(201,165,92,0.30);
    position: relative;
    overflow: hidden;
  }
  .featured::before {
    content: "";
    position: absolute; left: 0; top: 0; bottom: 0;
    width: 4px;
    background: var(--gold);
  }
  .featured-left  { padding: 34px 36px; }
  .featured-right { padding: 34px 36px; border-left: 1px solid rgba(245,233,204,0.10); background: rgba(0,0,0,0.10); }
  .featured-tag {
    display: inline-flex; align-items: center; gap: 9px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cream-soft);
  }
  .featured-tag.gold { color: var(--gold); }
  .ft-pulse {
    width: 7px; height: 7px; background: var(--gold); border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(201,165,92,0.55);
    animation: ftPulse 1.8s ease-out infinite;
  }
  .featured-h {
    font-family: "Iowan Old Style", "Palatino", "Georgia", serif;
    color: var(--cream);
    font-size: clamp(28px, 3.4vw, 40px);
    letter-spacing: -0.015em;
    margin: 16px 0 14px;
    line-height: 1.04;
  }
  .featured-x { color: var(--gold); margin: 0 12px; font-style: italic; }
  .featured-headline {
    color: var(--cream-soft);
    font-size: 14px;
    line-height: 1.6;
    max-width: 52ch;
    margin: 0 0 22px;
  }
  .featured-meta { display: flex; gap: 22px; align-items: center; flex-wrap: wrap; font-size: 11px; }
  .evidence-stamp {
    padding: 5px 11px;
