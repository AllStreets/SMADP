---
import MemoLayout from '@/components/MemoLayout.astro';
import HeroBand from '@/components/HeroBand.astro';
import DataCallouts from '@/components/DataCallouts.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import { loadVerdicts, loadProfiles } from '@/lib/catalog';
import { groupByEvidenceTier, rankByComposite } from '@/lib/aggregations';
import { RISK_KEYS } from '@/lib/types';

const verdicts = loadVerdicts();
const profiles = loadProfiles();
const groups = groupByEvidenceTier(verdicts);
const ranked = rankByComposite(verdicts);
const featured = groups.sandbox[0] ?? ranked[0];

const callouts = [
  { label: 'Agents profiled', value: profiles.length },
  { label: 'Pair verdicts', value: verdicts.length },
  { label: 'Sandbox-validated', value: groups.sandbox.length, accent: true },
  { label: 'Risk dimensions', value: 5 }
];

const dimensions = [
  { key: 'A_prompt_injection',    letter: 'A', name: 'Prompt injection',    color: 'var(--dim-a)', tagline: 'Adversarial writes flowing into prompts.' },
  { key: 'B_data_leakage',        letter: 'B', name: 'Data leakage',        color: 'var(--dim-b)', tagline: 'Confidential context across trust boundaries.' },
  { key: 'C_capability_conflict', letter: 'C', name: 'Capability conflict', color: 'var(--dim-c)', tagline: 'Permissions composing into ones never granted.' },
  { key: 'D_cascading_error',     letter: 'D', name: 'Cascading error',     color: 'var(--dim-d)', tagline: "One agent's mistake becoming another's truth." },
  { key: 'E_compliance',          letter: 'E', name: 'Compliance',          color: 'var(--dim-e)', tagline: 'Pairs that breach what the parts alone would respect.' }
];

const layouts = [
  {
    n: '01',
    name: 'Brief',
    href: '/brief',
    pages: 10,
    read: '6 min',
    blurb: 'A linear narrative — thesis, methodology, headline findings, limits. Start here.',
    accent: 'cream',
    contents: ['§ 1  The question', '§ 3  Risk taxonomy', 'Exhibit 1  Severity heatmap', '§ 4  Headline finding']
  },
  {
    n: '02',
    name: 'Prospectus',
    href: '/prospectus',
    pages: 14,
    read: '10 min',
    blurb: 'Investment-bank format. Pitch up front; data appendix in back. For institutional readers who want both.',
    accent: 'navy',
    contents: ['Executive summary', '§ Why this matters', '§ Headline finding', 'Appendix A–H · receipts']
  },
  {
    n: '03',
    name: 'Dossier',
    href: '/dossier',
    pages: 16,
    read: '14 min',
    blurb: 'The complete file. Every risk dimension, every agent of note, every verdict on the books.',
    accent: 'gold',
    contents: ['§ 1  Thesis', '§ 4  Pairwise risk by dimension', '§ 8–9  Agent dossier (closed + open)', '§ 11  Full verdict register']
  }
];
---
<MemoLayout pageTitle="SMADP · Report" layoutName="SMADP">
  <HeroBand
    eyebrow="SMADP Research Memo · 2026.05"
    title="When agents work together, do they stay safe?"
    dek="A sandbox-tested study of how AI coding agents behave when paired — and where each one's safety guarantees start to crack."
  />
  <section class="container section compact">
    <DataCallouts items={callouts} />
  </section>

  <section class="container section featured-wrap">
    <div class="featured">
      <div class="featured-left">
        <div class="eyebrow gold-eyebrow">{groups.sandbox.length > 0 ? 'Latest sandbox-validated finding' : 'Top-ranked finding'}</div>
        <h2>{featured.pair[0]} <span class="x">×</span> {featured.pair[1]}</h2>
        <p class="featured-headline">{featured.headline}</p>
        <div class="featured-meta">
          <span class="evidence-stamp" data-tier={featured.evidence_level}>{featured.evidence_level}</span>
          <span class="composite">composite <strong>{featured.composite_score.toFixed(2)}</strong></span>
        </div>
      </div>
      <div class="featured-right">
        <div class="eyebrow gold-eyebrow">Risk fingerprint</div>
        <div class="fingerprint">
          {RISK_KEYS.map((k) => {
            const sev = featured.sub_verdicts[k].severity;
            return (
              <div class="fp-row">
                <span class="fp-letter">{k[0]}</span>
                <span class="fp-bar"><span class={`fp-fill sev-${sev}`}></span></span>
                <span class="fp-sev">{sev}</span>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <section class="container section dim-strip-wrap">
    <SectionHeader eyebrow="Five dimensions" title="The taxonomy at a glance" subtitle="Each pair verdict is graded along all five." />
    <div class="dim-strip">
      {dimensions.map((d) => (
        <div class="dim-chip">
          <span class="dim-square" style={`background:${d.color}`}></span>
          <div>
            <div class="dim-name"><strong>{d.letter}</strong>  ·  {d.name}</div>
            <div class="dim-tag">{d.tagline}</div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="container section">
    <SectionHeader eyebrow="Three takes" title="Choose your read" subtitle="Same underlying data, three formats. Each exports as a self-contained PDF." />
    <div class="picker">
      {layouts.map((l) => (
        <a class={`card accent-${l.accent}`} href={l.href}>
          <div class="card-top">
            <div class="card-num">{l.n}</div>
            <div class="card-meta">
              <div class="card-pages">~{l.pages} pages</div>
              <div class="card-read">{l.read} read</div>
            </div>
          </div>
          <div class="card-name">{l.name}</div>
          <p class="card-blurb">{l.blurb}</p>
          <ul class="card-toc">
            {l.contents.map((c) => <li>{c}</li>)}
          </ul>
          <div class="card-cta">Open the {l.name} <span class="arr">→</span></div>
        </a>
      ))}
    </div>
  </section>

  <section class="container section about">
    <div class="grid-2">
      <div>
        <div class="eyebrow">About SMADP</div>
        <h2 class="about-h">A pair-level safety catalog for AI coding agents</h2>
        <p>SMADP runs scripted scenarios where two AI coding agents collaborate inside an isolated container, then grades the transcripts against a fixed five-dimension rubric. Every verdict on this site carries an explicit evidence tier — sandbox, profile, or docs — and the site never silently promotes one tier to another.</p>
        <p>Source data lives in <code>catalog/</code>. The methodology, rubric, and every transcript are checked in and reproducible.</p>
      </div>
      <div class="about-links">
        <div class="eyebrow">Links</div>
        <ul>
          <li><a href="https://github.com/AllStreets/ONEXUS-Agents">ONEXUS-Agents</a> — sibling project, agent profile source</li>
          <li><a href="/brief">Methodology (in the Brief)</a></li>
          <li><a href="/dossier">Full verdict register (in the Dossier)</a></li>
        </ul>
      </div>
    </div>
  </section>
</MemoLayout>

<style>
  /* Featured panel */
  .featured-wrap { padding-top: 0; }
  .featured {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 28px;
    background: linear-gradient(135deg, var(--ink-navy) 0%, #122448 100%);
    color: var(--cream);
    padding: 26px 30px;
    border-left: 3px solid var(--gold);
  }
  .featured h2 {
    color: var(--cream);
    font-size: 26px;
    margin: 8px 0 10px;
    letter-spacing: -0.01em;
  }
  .featured h2 .x { color: var(--gold); margin: 0 4px; }
  .featured-headline {
    color: var(--cream-soft);
    font-size: 13px;
    line-height: 1.55;
    margin: 0 0 14px;
    max-width: 50ch;
  }
  .featured-meta { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; font-size: 11px; }
  .evidence-stamp {
    padding: 4px 10px;
    background: var(--gold);
    color: var(--ink-navy);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .evidence-stamp[data-tier="profile-verified"] { background: var(--blue-mid); color: var(--cream); }
  .evidence-stamp[data-tier="docs-only"]        { background: var(--cream-soft); color: var(--ink-navy); }
  .composite { color: var(--cream-soft); letter-spacing: 0.08em; }
  .composite strong { color: var(--cream); font-size: 14px; margin-left: 4px; font-variant-numeric: tabular-nums; }
  .gold-eyebrow { color: var(--gold); }

  .fingerprint { display: grid; gap: 6px; margin-top: 10px; }
  .fp-row { display: grid; grid-template-columns: 16px 1fr 56px; align-items: center; gap: 10px; font-size: 11px; }
  .fp-letter { color: var(--gold); font-weight: 600; font-family: var(--font-mono); }
  .fp-bar { background: rgba(255,255,255,0.08); height: 6px; position: relative; }
  .fp-fill { position: absolute; left: 0; top: 0; bottom: 0; }
  .fp-fill.sev-none     { width: 6%;  background: var(--sev-none); }
  .fp-fill.sev-low      { width: 30%; background: var(--sev-low); }
  .fp-fill.sev-medium   { width: 60%; background: var(--sev-medium); }
  .fp-fill.sev-high     { width: 85%; background: var(--sev-high); }
  .fp-fill.sev-critical { width: 100%; background: var(--sev-critical); }
  .fp-sev { color: var(--cream-soft); letter-spacing: 0.10em; text-transform: uppercase; font-size: 9.5px; text-align: right; }

  /* Dimension strip */
  .dim-strip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 12px;
    margin-top: 14px;
  }
  .dim-chip {
    display: grid;
    grid-template-columns: 10px 1fr;
    gap: 14px;
    padding: 14px 16px;
    background: var(--paper-warm);
    border: 1px solid var(--rule);
  }
  .dim-square { width: 10px; align-self: stretch; }
  .dim-name { font-size: 13px; color: var(--ink-navy); font-weight: 500; }
  .dim-name strong { font-family: var(--font-mono); color: var(--gold); }
  .dim-tag { font-size: 11px; color: var(--ink-muted); margin-top: 3px; line-height: 1.5; }

  /* Picker cards */
  .picker {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 20px;
    margin-top: 14px;
  }
  .card {
    border: 1px solid var(--rule);
    background: var(--paper);
    padding: 28px 26px 22px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 14px;
    position: relative;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .card::before {
    content: "";
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
  }
  .card.accent-cream::before { background: var(--cream); }
  .card.accent-navy::before  { background: var(--ink-navy); }
  .card.accent-gold::before  { background: var(--gold); }
  .card:hover {
    border-color: var(--ink-navy);
    box-shadow: 0 8px 24px rgba(11,27,58,0.10);
    transform: translateY(-2px);
  }
  .card-top { display: flex; align-items: baseline; justify-content: space-between; }
  .card-num {
    font-family: "Iowan Old Style", "Palatino", "Georgia", serif;
    font-size: 40px;
    color: var(--ink-navy);
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .card.accent-gold .card-num { color: var(--gold); }
  .card-meta { text-align: right; }
  .card-pages, .card-read {
    font-size: 9.5px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .card-name {
    font-size: 26px;
    font-weight: 600;
    color: var(--ink-navy);
    letter-spacing: -0.01em;
    margin-top: -2px;
  }
  .card-blurb { color: var(--ink-body); margin: 0; font-size: 13px; line-height: 1.55; }
  .card-toc {
    list-style: none;
    padding: 12px 0 0;
    margin: auto 0 0;
    border-top: 1px solid var(--rule);
    display: grid;
    gap: 4px;
  }
  .card-toc li {
    font-size: 11px;
    color: var(--ink-muted);
    font-family: var(--font-mono);
  }
  .card-cta {
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    padding-top: 10px;
    border-top: 1px solid var(--rule);
  }
  .card-cta .arr { transition: transform 0.18s ease; display: inline-block; }
  .card:hover .card-cta .arr { transform: translateX(4px); }

  /* About */
  .about-h { font-size: 22px; margin: 6px 0 12px; max-width: 28ch; }
  .about p { max-width: 56ch; font-size: 13px; }
  .about-links ul { list-style: none; padding: 0; margin: 8px 0 0; }
  .about-links li { padding: 8px 0; border-top: 1px solid var(--rule); font-size: 12px; }
  .about-links li:first-child { border-top: 2px solid var(--ink-navy); }
  .about-links a { color: var(--ink-navy); text-decoration: underline; text-decoration-color: var(--gold); text-underline-offset: 3px; }

  @media (max-width: 880px) {
    .featured { grid-template-columns: 1fr; }
    .picker { grid-template-columns: 1fr; }
  }
  @media print {
    .picker { grid-template-columns: 1fr 1fr 1fr; }
    .card:hover { transform: none; box-shadow: none; }
  }
</style>
