---
import MemoLayout from '@/components/MemoLayout.astro';
import { loadVerdicts } from '@/lib/catalog';
import { groupByEvidenceTier } from '@/lib/aggregations';

const verdicts = loadVerdicts();
const groups = groupByEvidenceTier(verdicts);

const layouts = [
  {
    n: '01',
    name: 'Primer',
    href: '/primer',
    pages: 10,
    read: '6 min',
    audience: 'For the reader who needs the whole story by the end of the coffee.',
    blurb: 'A linear narrative — thesis, methodology, headline findings, limits. Built to be the first thing you hand a stakeholder who has never heard of pair-level agent risk.',
    contents: [
      '§ 1  The question — why pair-level risk matters',
      '§ 2  Methodology — how every verdict is built',
      '§ 3  Risk taxonomy — the five dimensions',
      '§ 4  Headline finding — the seam that cracks first',
      'Exhibit 1  Severity heatmap across top pairs'
    ],
    accent: 'cream',
    role: 'feature'
  },
  {
    n: '02',
    name: 'Prospectus',
    href: '/prospectus',
    pages: 14,
    read: '10 min',
    audience: 'For the institutional reader who wants both the pitch and the receipts.',
    blurb: 'An investment-bank format. The thesis sits up front; the data appendix sits in back. Mid-section ties every dimension to a worked example with verdict citations.',
    contents: [
      'Executive summary',
      '§ Why this matters · § Methodology · § Headline finding',
      'Appendix A–H · receipts, framework mappings, raw rankings'
    ],
    accent: 'navy',
    role: 'secondary'
  },
  {
    n: '03',
    name: 'Dossier',
    href: '/dossier',
    pages: 16,
    read: '14 min',
    audience: 'For the auditor, the researcher, the engineer who builds adjacent.',
    blurb: 'The complete file. Every risk dimension, every agent of note, every verdict on the books — laid out the way the catalog actually stores them, with no editorial smoothing.',
    contents: [
      '§ 1  Thesis · § 2  Methodology in full',
      '§ 4  Pairwise risk by dimension · § 6  Severity heatmap',
      '§ 8–9  Agent dossier · closed-source then open-source',
      '§ 11  Full verdict register (all 105 pairs)'
    ],
    accent: 'gold',
    role: 'secondary'
  }
];

const stats = {
  verdicts: verdicts.length,
  sandbox: groups.sandbox.length,
  profileVerified: groups.profileVerified.length,
  docsOnly: groups.docsOnly.length
};
---
<MemoLayout pageTitle="SMADP · Briefs" layoutName="SMADP">
  <div class="briefs-page">

    <!-- HERO -->
    <header class="briefs-hero">
      <div class="container">
        <div class="bh-eyebrow">
          <span class="bh-mark">[ Briefs · Three reads on one dataset ]</span>
          <span class="bh-dot" aria-hidden="true">·</span>
          <span>Same {stats.verdicts} verdicts. Three lengths. One catalog underneath.</span>
        </div>
        <h1 class="bh-title">
          Pick the read that <em>matches your bandwidth</em>.
        </h1>
        <p class="bh-dek">
          Every layout below renders from the same underlying catalog. Nothing on this page
          paraphrases or smooths the dataset — they are three different doors into the same
          110+ profile + verdict corpus. Each is print-ready and exports as a self-contained PDF.
        </p>
        <div class="bh-stats">
          <div class="bs-cell"><span class="bs-num">{stats.verdicts}</span><span class="bs-lab">Pair verdicts on file</span></div>
          <div class="bs-cell"><span class="bs-num">{stats.sandbox}</span><span class="bs-lab">Sandbox-validated</span></div>
          <div class="bs-cell"><span class="bs-num">{stats.profileVerified}</span><span class="bs-lab">Profile-verified</span></div>
          <div class="bs-cell"><span class="bs-num">{stats.docsOnly}</span><span class="bs-lab">Docs-only</span></div>
        </div>
      </div>
    </header>

    <!-- THREE LAYOUTS — full-bleed cards -->
    <section class="container briefs-list">
      {layouts.map((l, idx) => (
        <article class={`brief-card brief-card-${l.role} accent-${l.accent}`}>
          <a class="bc-cover" href={l.href} aria-label={`Open the ${l.name}`}></a>
          <div class="bc-left">
            <div class="bc-num">{l.n}</div>
            <div class="bc-meta">
              <span>{l.pages} pp</span><span class="bc-dot">·</span>
              <span>{l.read} read</span>
            </div>
            <div class="bc-pdf">PDF · {l.name.toLowerCase()}.pdf</div>
          </div>
          <div class="bc-body">
            <div class="bc-eyebrow">Layout {l.n}</div>
            <h2 class="bc-name">{l.name}</h2>
            <p class="bc-audience">{l.audience}</p>
            <p class="bc-blurb">{l.blurb}</p>
            <ul class="bc-toc">
              {l.contents.map((c) => <li>{c}</li>)}
            </ul>
            <div class="bc-cta-row">
              <a class="bc-cta-primary" href={l.href}>Open the {l.name} <span class="arr">→</span></a>
              <a class="bc-cta-ghost" href={`/${l.name.toLowerCase()}.pdf`} download={`SMADP-${l.name}.pdf`}>Download PDF</a>
            </div>
          </div>
          <div class="bc-spine" aria-hidden="true"></div>
        </article>
      ))}
    </section>

    <!-- WHY THREE LAYOUTS -->
    <section class="container briefs-why">
      <div class="bw-grid">
        <div class="bw-left">
          <div class="bw-eyebrow">Why three?</div>
          <h2 class="bw-h">One dataset deserves more than one shape.</h2>
        </div>
        <div class="bw-right">
          <p>
            A board member asking "is this real?" needs a different artifact than an
            auditor asking "show every transcript." The catalog never changes — but the
            framing has to. Same numbers, same citations, three different mental shapes.
          </p>
          <p>
            All three are regenerated from <code>catalog/</code> at build time. When a new
            verdict lands, all three layouts inherit it on the next build. No layout silently
            promotes evidence above its tier; that <a href="/references">distinction lives on the references page</a>.
          </p>
        </div>
      </div>
    </section>

  </div>
</MemoLayout>

<style>
  .briefs-page {
    background: var(--ink-navy);
    color: var(--cream);
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .briefs-page::before {
    content: "";
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image:
      linear-gradient(to right, rgba(245,233,204,0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(245,233,204,0.035) 1px, transparent 1px);
    background-size: 64px 64px;
  }
  .briefs-page::after {
    content: "";
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background:
      radial-gradient(60% 50% at 80% 14%, rgba(201,165,92,0.08) 0%, transparent 70%),
      radial-gradient(60% 60% at 14% 86%, rgba(61,90,140,0.18) 0%, transparent 75%);
  }
  .briefs-page > * { position: relative; z-index: 1; }

  /* HERO */
  .briefs-hero { padding: 84px 0 56px; }
  .bh-eyebrow {
    display: flex; gap: 14px; align-items: center; flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.22em;
    color: var(--gold);
    text-transform: uppercase;
  }
  .bh-eyebrow > :not(.bh-mark) { color: var(--cream-soft); letter-spacing: 0.16em; }
  .bh-dot { opacity: 0.55; }
  .bh-title {
    font-family: "Iowan Old Style", "Palatino", "Georgia", serif;
    font-weight: 500;
    font-size: clamp(40px, 6.4vw, 92px);
    letter-spacing: -0.022em;
    line-height: 1.02;
    color: var(--cream);
    margin: 22px 0 18px;
    max-width: 16ch;
  }
  .bh-title em { font-style: italic; color: var(--gold); }
  .bh-dek {
    color: var(--cream-soft);
    font-size: clamp(14px, 1.2vw, 17px);
    line-height: 1.6;
    max-width: 70ch;
    margin: 0 0 36px;
  }
  .bh-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    border-top: 1px solid rgba(245,233,204,0.12);
    border-bottom: 1px solid rgba(245,233,204,0.12);
  }
  .bs-cell {
    padding: 22px 26px 22px 0;
    border-right: 1px solid rgba(245,233,204,0.10);
    display: flex; flex-direction: column; gap: 6px;
  }
  .bs-cell:last-child { border-right: none; }
  .bs-num {
    font-family: "Iowan Old Style", "Palatino", "Georgia", serif;
    font-size: clamp(28px, 3.4vw, 44px);
    color: var(--cream);
    letter-spacing: -0.02em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .bs-cell:nth-child(2) .bs-num { color: var(--gold); }
  .bs-lab {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--cream-soft);
  }

  /* BRIEF CARDS */
  .briefs-list { padding: 56px 0 24px; display: grid; gap: 24px; }
  .brief-card {
    position: relative;
    display: grid;
    grid-template-columns: 200px 1fr 6px;
    gap: 0;
    background: var(--paper);
    color: var(--ink-body);
    border: 1px solid rgba(245,233,204,0.12);
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
    overflow: hidden;
  }
  .brief-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 22px 48px rgba(0,0,0,0.45);
    border-color: var(--gold);
  }
  .bc-cover { position: absolute; inset: 0; z-index: 5; }
  .bc-cover:focus { outline: 2px solid var(--gold); outline-offset: -4px; }

  .bc-left {
    background: var(--paper-warm);
    padding: 32px 28px;
    border-right: 1px solid var(--rule);
    display: flex; flex-direction: column; gap: 8px; justify-content: space-between;
  }
  .bc-num {
    font-family: "Iowan Old Style", "Palatino", "Georgia", serif;
    font-size: 84px;
    color: var(--ink-navy);
    letter-spacing: -0.03em;
    line-height: 0.9;
  }
  .brief-card.accent-cream .bc-num { color: var(--ink-navy); }
  .brief-card.accent-navy  .bc-num { color: var(--blue-mid); }
  .brief-card.accent-gold  .bc-num { color: var(--gold); }
  .bc-meta {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--ink-muted);
    text-transform: uppercase;
  }
  .bc-dot { margin: 0 6px; }
  .bc-pdf {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--ink-muted);
    text-transform: uppercase;
    border-top: 1px solid var(--rule);
    padding-top: 10px;
    margin-top: 16px;
  }

  .bc-body { padding: 32px 36px; display: flex; flex-direction: column; gap: 10px; }
  .bc-eyebrow {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 2px;
  }
  .bc-name {
    font-family: "Iowan Old Style", "Palatino", "Georgia", serif;
    font-size: clamp(34px, 4vw, 56px);
    color: var(--ink-navy);
    letter-spacing: -0.02em;
    margin: 0;
    font-weight: 500;
    line-height: 1.0;
  }
  .bc-audience {
    color: var(--ink-navy);
    font-size: 15px;
    line-height: 1.5;
    font-style: italic;
    max-width: 56ch;
    margin: 8px 0 4px;
  }
  .bc-blurb { color: var(--ink-body); font-size: 14px; line-height: 1.65; max-width: 64ch; margin: 0 0 6px; }
  .bc-toc {
    list-style: none; padding: 14px 0 0; margin: 6px 0 14px;
    border-top: 1px solid var(--rule);
    display: grid; gap: 4px;
  }
  .bc-toc li {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--ink-muted);
    letter-spacing: 0.04em;
  }
  .bc-cta-row { display: flex; gap: 10px; flex-wrap: wrap; margin-top: auto; position: relative; z-index: 10; }
  .bc-cta-primary, .bc-cta-ghost {
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 12px 18px;
    text-decoration: none;
    border: 1px solid var(--ink-navy);
    display: inline-flex; align-items: center; gap: 8px;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }
  .bc-cta-primary { background: var(--ink-navy); color: var(--cream); font-weight: 600; }
  .bc-cta-primary:hover { background: #051430; transform: translateY(-1px); }
  .bc-cta-primary .arr { transition: transform 0.18s ease; }
  .bc-cta-primary:hover .arr { transform: translateX(4px); }
  .bc-cta-ghost { background: transparent; color: var(--ink-navy); }
  .bc-cta-ghost:hover { background: var(--ink-navy); color: var(--cream); }

  .bc-spine { background: var(--gold); }
  .brief-card.accent-cream .bc-spine { background: var(--cream); }
  .brief-card.accent-navy  .bc-spine { background: var(--blue-mid); }
  .brief-card.accent-gold  .bc-spine { background: var(--gold); }

  /* Feature card gets a bit more breathing room */
  .brief-card.brief-card-feature .bc-name { font-size: clamp(40px, 5vw, 72px); }
  .brief-card.brief-card-feature .bc-num { font-size: 108px; }

  /* WHY THREE */
  .briefs-why { padding: 64px 0 88px; }
  .bw-grid {
    display: grid; grid-template-columns: 1fr 1.4fr; gap: 60px;
    border-top: 1px solid rgba(245,233,204,0.12); padding-top: 36px;
  }
  .bw-eyebrow {
    font-family: var(--font-mono);
    font-size: 10.5px; letter-spacing: 0.20em;
    color: var(--gold); text-transform: uppercase;
  }
  .bw-h {
    font-family: "Iowan Old Style", "Palatino", "Georgia", serif;
    font-size: clamp(26px, 3vw, 38px);
    color: var(--cream); letter-spacing: -0.015em;
    margin: 10px 0 0; font-weight: 500; line-height: 1.12;
    max-width: 22ch;
  }
  .bw-right p { color: var(--cream-soft); font-size: 15px; line-height: 1.65; max-width: 62ch; }
  .bw-right p + p { margin-top: 14px; }
  .bw-right code {
    background: rgba(245,233,204,0.10); color: var(--cream);
    padding: 1px 6px; font-size: 12px;
  }
  .bw-right a { color: var(--cream); border-bottom: 1px solid var(--gold); text-decoration: none; }
  .bw-right a:hover { color: var(--gold); }

  /* RESPONSIVE */
  @media (max-width: 1024px) {
    .bh-stats { grid-template-columns: 1fr 1fr; }
    .bs-cell:nth-child(2n) { border-right: none; }
    .brief-card { grid-template-columns: 1fr 6px; }
    .bc-left { display: none; }
    .bw-grid { grid-template-columns: 1fr; gap: 24px; }
  }
  @media (max-width: 640px) {
    .bh-stats { grid-template-columns: 1fr; }
    .bs-cell { border-right: none; border-bottom: 1px solid rgba(245,233,204,0.10); }
    .bc-body { padding: 24px 22px; }
  }
</style>
