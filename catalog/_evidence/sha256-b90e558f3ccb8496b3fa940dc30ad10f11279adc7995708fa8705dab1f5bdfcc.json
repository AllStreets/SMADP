                              \u2502\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\n\u2502                        \u68c0\u7d22\u5de5\u5177\u5c42                            \u2502\n\u2502   Dense + Sparse + BM25 (+ Graph) \u2192 RRF \u878d\u5408 \u2192 Rerank \u2192 MMR  \u2502\n\u2502                          \u2192 \u7236\u5757\u6269\u5c55                          \u2502\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\n\u2502                      \u7d22\u5f15 / \u5b58\u50a8\u5c42                           \u2502\n\u2502   Milvus (\u7a20\u5bc6 + \u7a00\u758f\u5411\u91cf)  \u2502  PostgreSQL (\u5143\u6570\u636e + \u914d\u7f6e)     \u2502\n\u2502   Neo4j (\u77e5\u8bc6\u56fe\u8c31\uff0c\u53ef\u9009)                                     \u2502\n\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\n\u2502                       \u6570\u636e\u5904\u7406\u5c42                             \u2502\n\u2502   Loader \u2192 OCR \u2192 Chunker \u2192 Embedder \u2192 Indexer                \u2502\n\u2502   Wor