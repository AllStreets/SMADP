  "headline": "OpenHands runs sandboxed in Docker; Claude Code on host. Sandbox isolation reduces risk vs other terminal-agent pairs.",
  "sub_verdicts": {
    "A_prompt_injection": {
      "severity": "medium",
      "rationale": "OpenHands' actions stay in Docker; output crosses the sandbox boundary only via mounted volumes. If Claude Code reads those volumes the injection pathway exists, but it's narrower than a no-sandbox pair.",
      "citations": [
        {
          "evidence_ref": "sha256:6bbd48c6765e4689dd76b6b22aa1285afde08cf0119bfa1d773bdb7ee6c59dc6"
        },
        {
          "profile_field": "claude-code.capabilities.read_filesystem"
        }
      ],
      "conditions": [],
      "mitigations": [
        "Treat OpenHands' produced files as untrusted before Claude Code acts on them"
      ]
    },
    "B_data_leakage": {
      "severity": "medium",
      "rationale": "Two model providers see the code (OpenHands' configured provider + Anthropic). Sandbox limits what files reach the OpenHands provider only to mounted dirs.",
      "citations": [
        {
          "evidence_ref": "sha256:def5d416bd0cd0c6697265c643a9d613d3f1893105043259ff61e7c712660caa"
        },
        {
          "evidence_ref": "sha256:a9c03d8eecf7a87028aef94dd73559f3d72843fbd38e9cfdfbafbf15fca4d573"
        }
      ],
      "conditions": [],
      "mitigations": []
    },
    "C_capability_conflict": {
      "severity": "medium",
      "rationale": "Both can write to the mounted volume. Inside Docker, OpenHands' filesystem is isolated, but the mount itself is shared with the host where Claude Code lives.",
      "citations": [
        {
          "evidence_ref": "sha256:6bbd48c6765e4689dd76b6b22aa1285afde08cf0119bfa1d773bdb7ee6c59dc6"
        },
        {
          "profile_field": "claude-code.capabilities.write_filesystem"
        }
      ],
      "conditions": [],
      "mitigations": [
        "Mount only narrow project subdirs into OpenHands",
        "Don't have Claude Code touch the mounted volume while OpenHands is running"
      ]
    },
    "D_cascading_error": {
      "severity": "medium",
      "rationale": "Standard agent-to-agent risk; sandbox doesn't address verification.",
      "citations": [
        {
          "profile_field": "openhands.sandboxing.tool_use_pattern"
        },
        {
          "profile_field": "claude-code.sandboxing.tool_use_pattern"
        }
      ],
