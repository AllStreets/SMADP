        }
      ],
      "conditions": [],
      "mitigations": []
    },
    "B_data_leakage": {
      "severity": "medium",
      "rationale": "Two vendors (Replit + Cursor proxy) see the same code. Replit handles secrets in its store; Cursor handles BYOK.",
      "citations": [
        {
          "evidence_ref": "sha256:c9ff3e45646f0ac3bb46b69679eb316674bdaa554ca31e256025a2f62382894e"
        },
        {
          "evidence_ref": "sha256:33a9470787a5ea7fc72a2afc55f526d88e02b06e32f4f8522a8cc38ac82eaa6c"
        }
      ],
      "conditions": [],
      "mitigations": [
        "Enable Cursor Privacy Mode; mind which secrets sit in Replit Secrets"
      ]
    },
    "C_capability_conflict": {
      "severity": "medium",
      "rationale": "Sequential conflict via git: if both make edits between syncs, merge conflicts and lost changes are likely.",
      "citations": [
        {
          "profile_field": "replit-agent.capabilities.modify_git_state"
        },
        {
          "profile_field": "cursor.capabilities.modify_git_state"
        }
      ],
      "conditions": [],
      "mitigations": [
        "Pull/push at well-defined sync points; never let both edit at once"
      ]
    },
    "D_cascading_error": {
      "severity": "medium",
      "rationale": "Replit Agent's commits become Cursor's truth and vice versa; no cross-system verification.",
