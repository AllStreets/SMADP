  "headline": "Two unrestricted local code-runners \u2014 both can execute anything the user can; high conflict and high data-leakage potential.",
  "sub_verdicts": {
    "A_prompt_injection": {
      "severity": "high",
      "rationale": "Open Interpreter executes whatever the LLM emits and has full host access; Claude Code does too. Either can be tricked into reading attacker-controlled files; the result becomes the other's input. No sandbox by default.",
      "citations": [
        {
          "evidence_ref": "sha256:d91b1a7af4a4f7895cb340a8f770181211bc8fdf5f1973172e33b4a5574d19db"
        },
        {
          "profile_field": "claude-code.capabilities.execute_shell"
        }
      ],
      "conditions": [],
      "mitigations": [
        "Never use --auto_run in Open Interpreter when Claude Code is also active",
        "Confirm every command in both"
      ]
    },
    "B_data_leakage": {
      "severity": "high",
      "rationale": "Both can read anywhere on the user's filesystem and ship excerpts to model providers. Two vendors potentially. Open Interpreter has no special data terms.",
      "citations": [
        {
          "evidence_ref": "sha256:d91b1a7af4a4f7895cb340a8f770181211bc8fdf5f1973172e33b4a5574d19db"
        },
        {
          "profile_field": "claude-code.data_classes_touched"
        }
      ],
      "conditions": [],
      "mitigations": [
        "Constrain working directories; avoid running on machines holding regulated data"
      ]
    },
    "C_capability_conflict": {
      "severity": "high",
      "rationale": "Maximum overlap: shell, fs write, install, git. Concurrent operation almost guarantees corruption of work.",
      "citations": [
        {
          "profile_field": "open-interpreter.capabilities.execute_shell"
        },
        {
          "profile_field": "claude-code.capabilities.execute_shell"
        },
        {
          "profile_field": "open-interpreter.capabilities.write_filesystem"
        },
        {
          "profile_field": "claude-code.capabilities.write_filesystem"
        }
      ],
      "conditions": [],
      "mitigations": [
        "Sequence the agents; do not run both in parallel on the same project"
      ]
    },
    "D_cascading_error": {
      "severity": "high",
      "rationale": "Each can execute the other's hallucinations on the host with no verification step.",
      "citations": [
