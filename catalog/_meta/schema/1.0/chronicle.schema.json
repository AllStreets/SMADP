{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smadp.dev/schema/1.0/chronicle.schema.json",
  "title": "SMADP Chronicle Event",
  "type": "object",
  "required": ["ts", "event", "by"],
  "properties": {
    "ts": {"type": "string", "format": "date-time"},
    "event": {
      "enum": [
        "profile.created",
        "profile.refreshed",
        "profile.verified",
        "profile.invalidated",
        "evidence.added",
        "verdict.generated",
        "verdict.regenerated",
        "verdict.corrected",
        "sandbox.run.started",
        "sandbox.run.completed",
        "schema.migrated",
        "framework.added"
      ]
    },
    "by": {"type": "string"},
    "slug": {"type": "string"},
    "pair": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 2},
    "verdict_id": {"type": "string"},
    "model": {"type": "string"},
    "outcome": {"type": "string"},
    "details": {"type": "object"}
  }
}
