{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smadp.dev/schema/1.0/evidence.schema.json",
  "title": "SMADP Evidence Snippet",
  "type": "object",
  "required": ["sha256", "source_url", "fetched_at", "fetcher", "media_type", "quote"],
  "additionalProperties": false,
  "properties": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_url": {"type": "string", "format": "uri"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "fetcher": {"type": "string"},
    "media_type": {"type": "string"},
    "quote": {"type": "string", "minLength": 1, "maxLength": 8000},
    "context": {"type": "string", "maxLength": 500},
    "fingerprint": {"type": ["string", "null"]},
    "valid_at": {"type": "string", "format": "date-time"},
    "valid_status": {"enum": ["valid", "stale", "missing", "changed"]}
  }
}
