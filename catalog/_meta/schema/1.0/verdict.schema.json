{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smadp.dev/schema/1.0/verdict.schema.json",
  "title": "SMADP Pairwise Verdict",
  "type": "object",
  "required": [
    "schema_version", "pair", "verdict_id", "generated_at", "model",
    "evidence_level", "confidence", "composite_score", "headline",
    "sub_verdicts", "framework_mappings", "reproducibility", "sandbox_runs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "pair": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
      "minItems": 2,
      "maxItems": 2
    },
    "verdict_id": {"type": "string", "pattern": "^v_\\d{4}-\\d{2}-\\d{2}_[a-z0-9-]+__[a-z0-9-]+_[a-f0-9]{4,8}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "model": {
      "type": "object",
      "required": ["name", "id", "rubric_version"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "id": {"type": "string"},
        "rubric_version": {"type": "string"}
      }
    },
    "evidence_level": {"enum": ["unverified-profile", "docs-only", "profile-verified", "sandbox-validated"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "composite_score": {"type": "number", "minimum": 0, "maximum": 1},
    "headline": {"type": "string", "minLength": 1, "maxLength": 240},
    "sub_verdicts": {
      "type": "object",
      "required": ["A_prompt_injection", "B_data_leakage", "C_capability_conflict", "D_cascading_error", "E_compliance"],
      "additionalProperties": false,
      "properties": {
        "A_prompt_injection": {"$ref": "#/$defs/subVerdict"},
        "B_data_leakage": {"$ref": "#/$defs/subVerdict"},
        "C_capability_conflict": {"$ref": "#/$defs/subVerdict"},
        "D_cascading_error": {"$ref": "#/$defs/subVerdict"},
        "E_compliance": {"$ref": "#/$defs/subVerdict"}
      }
    },
    "framework_mappings": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "reproducibility": {
      "type": "object",
      "required": ["rubric_url", "profile_a_hash", "profile_b_hash", "evidence_bundle_hash"],
      "additionalProperties": false,
      "properties": {
        "rubric_url": {"type": "string"},
        "profile_a_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "profile_b_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "evidence_bundle_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "sandbox_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "started_at", "completed_at", "outcome", "transcript_ref"],
        "properties": {
          "run_id": {"type": "string"},
          "started_at": {"type": "string", "format": "date-time"},
          "completed_at": {"type": ["string", "null"], "format": "date-time"},
          "outcome": {"enum": ["pass", "fail", "inconclusive", "errored"]},
          "transcript_ref": {"type": "string"},
          "scenario": {"type": "string"}
        }
      }
    }
  },
  "$defs": {
    "subVerdict": {
      "type": "object",
      "required": ["severity", "rationale", "citations", "conditions", "mitigations"],
      "additionalProperties": false,
      "properties": {
        "severity": {"enum": ["none", "low", "medium", "high", "critical"]},
        "rationale": {"type": "string", "minLength": 1, "maxLength": 600},
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [],
            "additionalProperties": false,
            "properties": {
              "profile_field": {"type": "string"},
              "evidence_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "quote": {"type": "string"}
            }
          }
        },
        "conditions": {"type": "array", "items": {"type": "string"}},
        "mitigations": {"type": "array", "items": {"type": "string"}, "maxItems": 5}
      }
    }
  }
}
