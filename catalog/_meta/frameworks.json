        {"id": "MAP-3.4", "name": "User capabilities for safe operation are documented", "applies_to_risks": ["A_prompt_injection", "B_data_leakage", "C_capability_conflict"]},
        {"id": "MAP-4.1", "name": "Approaches to mapping AI risks are reviewed", "applies_to_risks": ["A_prompt_injection", "B_data_leakage", "C_capability_conflict", "D_cascading_error"]},
        {"id": "MEASURE-2.6", "name": "AI system known limits are documented", "applies_to_risks": ["D_cascading_error"]},
        {"id": "MEASURE-2.7", "name": "AI system security and resilience are evaluated", "applies_to_risks": ["A_prompt_injection", "C_capability_conflict"]},
        {"id": "MEASURE-2.10", "name": "Privacy of AI is examined", "applies_to_risks": ["B_data_leakage", "E_compliance"]},
        {"id": "MEASURE-2.11", "name": "Fairness and bias of the AI system are evaluated", "applies_to_risks": ["D_cascading_error"]},
