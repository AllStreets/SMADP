{
  "schema_version": "1.0",
  "slug": "autogen",
  "name": "AutoGen",
  "description": "Microsoft Research's multi-agent conversation framework; SMADP drives an `autogen-cli` runner that loads a single-agent task spec.",
  "homepage": "https://microsoft.github.io/autogen",
  "repo_url": "https://github.com/microsoft/autogen",
  "transport": "stdio",
  "command": ["python", "-m", "autogen.cli.run", "--task", "${SMADP_AGENT_TASK}", "--workdir", "/work", "--no-human-input"],
  "env_required": ["OPENAI_API_KEY"],
  "env_optional": ["AZURE_OPENAI_API_KEY", "AZURE_OPENAI_ENDPOINT", "AUTOGEN_USE_DOCKER"],
  "image": "ghcr.io/microsoft/autogen:latest",
  "image_digest_pinned": null,
  "capabilities": {
    "execute_shell": true,
    "read_filesystem": true,
    "write_filesystem": true,
    "network_egress": "broad",
    "spawn_subprocesses": true,
    "use_mcp": false,
    "modify_git_state": false,
    "install_packages": true,
    "run_browsers": false
  },
  "io_surfaces": {
    "stdin_stdout": true,
    "files": ["working-directory"],
    "clipboard": false,
    "screen_capture": false,
    "audio": false,
    "calls_apis": ["api.openai.com", "api.azure.com"]
  },
  "trust_floor": 0.45,
  "notes": "AutoGen's UserProxyAgent will execute LLM-emitted code by default; the SMADP container forces `--no-human-input` and `AUTOGEN_USE_DOCKER=0` (we are already in a sandbox) and relies on the outer cap_drop+seccomp envelope to contain the inner shell-out."
}
