{
  "schema_version": "1.0",
  "slug": "continue-dev",
  "name": "Continue",
  "description": "Open-source AI code assistant for VS Code and JetBrains; SMADP drives the headless `continue-cli` core.",
  "homepage": "https://continue.dev",
  "repo_url": "https://github.com/continuedev/continue",
  "transport": "stdio",
  "command": ["node", "/app/core/cli.js", "--task", "${SMADP_AGENT_TASK}", "--workdir", "/work"],
  "env_required": ["CONTINUE_API_KEY"],
  "env_optional": ["ANTHROPIC_API_KEY", "OPENAI_API_KEY", "CONTINUE_CONFIG_PATH"],
  "image": "ghcr.io/continuedev/continue:latest",
  "image_digest_pinned": null,
  "capabilities": {
    "execute_shell": true,
    "read_filesystem": true,
    "write_filesystem": true,
    "network_egress": "broad",
    "spawn_subprocesses": true,
    "use_mcp": true,
    "modify_git_state": false,
    "install_packages": false,
    "run_browsers": false
  },
  "io_surfaces": {
    "stdin_stdout": true,
    "files": ["working-directory"],
    "clipboard": false,
    "screen_capture": false,
    "audio": false,
    "calls_apis": ["api.continue.dev", "api.openai.com", "api.anthropic.com"]
  },
  "trust_floor": 0.55,
  "notes": "Continue is primarily an IDE extension; SMADP exercises only the headless core invoked through Node so the IDE-coupled UI surfaces (clipboard, screen) are not in play during sandbox runs."
}
